# NanoSIEM Vector Configuration
# 
# This configuration file sets up Vector for log ingestion into NanoSIEM.
# It includes sources for syslog, file, and HTTP inputs, transforms for
# parsing and normalization, deduplication, and a PostgreSQL sink.
#
# Requirements: 1.1, 1.2, 1.3, 1.4, 1.5, 1.6

# =============================================================================
# Global Configuration
# =============================================================================

data_dir = "/var/lib/vector"

# =============================================================================
# Sources
# =============================================================================

# Syslog source - receives logs via syslog protocol (UDP/TCP)
[sources.syslog_udp]
type = "syslog"
address = "0.0.0.0:514"
mode = "udp"

[sources.syslog_tcp]
type = "syslog"
address = "0.0.0.0:1514"
mode = "tcp"

# File source - reads logs from files
[sources.file_logs]
type = "file"
include = ["/var/log/**/*.log", "/var/log/syslog", "/var/log/messages"]
read_from = "beginning"
ignore_older_secs = 86400  # Ignore files older than 24 hours

# Legacy HTTP source - receives logs via HTTP POST (no auth)
# Kept for backward compatibility - use http_secure for new integrations
[sources.http_logs]
type = "http_server"
address = "0.0.0.0:8089"
encoding = "json"
path = "/logs"
# Request body size limit (10MB default)
# Requirement 3.3: Maximum request body size
max_body_size = 10485760

# =============================================================================
# Secure HTTP Sources (with authentication and rate limiting)
# =============================================================================
# These sources are defined in sources/http_secure.toml and require
# Bearer token authentication via the VECTOR_AUTH_TOKEN environment variable
# Rate limiting is applied via transforms/rate_limit.toml
# Source type routing is applied via transforms/router.toml
# 
# Ports:
#   8080 - HTTP (non-TLS) secure endpoint
#   8443 - HTTPS (TLS) secure endpoint
#   8085 - NDJSON batch endpoint
#   8086 - Webhook endpoint
#
# Pipeline: http_secure -> auth_check -> rate_limit_prep -> rate_limit -> 
#           rate_limit_passthrough -> request_validation -> source_type_extract ->
#           source_router -> [specific_parser | generic_parser] -> routed_output
#
# Source Type Routing (Requirements 5.1, 5.2, 5.3):
#   - Routes based on X-Source-Type header (priority 1)
#   - Falls back to source_type field in body (priority 2)
#   - Defaults to generic parser when unspecified
#   - Supports common source type aliases (e.g., winlog -> windows_event)
#
# Rate Limiting (Requirements 3.1, 3.2):
#   - Per-IP rate limit: 1000 requests/second (configurable)
#   - Exceeded requests are dropped with logging
#
# Body Size Limits (Requirements 3.3, 3.4):
#   - Maximum body size: 10MB (configured in http_secure.toml)
#   - Oversized requests receive HTTP 413 Payload Too Large

# =============================================================================
# Transforms
# =============================================================================

# Parse and normalize logs from all sources
# Note: Authenticated HTTP sources go through auth -> rate_limit -> request_validation -> router
# The router handles source type routing and sends to specific parsers or generic parser
# Routed output is combined in routed_output transform
[transforms.parse_logs]
type = "remap"
inputs = ["syslog_udp", "syslog_tcp", "file_logs", "http_logs"]
source = '''
# Store raw content
.raw_content = to_string(.message) ?? to_string(.)

# Initialize metadata object
.metadata = {}

# Try to parse message as JSON if it looks like JSON
if starts_with(to_string(.message) ?? "", "{") {
    parsed, err = parse_json(.message)
    if err == null {
        .metadata = parsed
    }
}

# Copy syslog fields to metadata if present
if exists(.hostname) { .metadata.hostname = .hostname }
if exists(.appname) { .metadata.appname = .appname }
if exists(.facility) { .metadata.facility = .facility }
if exists(.severity) { .metadata.severity = .severity }
if exists(.procid) { .metadata.procid = .procid }

# Initialize UDM fields
.udm = {}

# =============================================================================
# UDM Field Normalization
# =============================================================================

# Source IP - check multiple common field names
.udm.src_ip = .metadata.src_ip ?? .metadata.source_ip ?? .metadata.src ?? 
              .metadata.client_ip ?? .metadata.source.ip ?? null

# Destination IP
.udm.dest_ip = .metadata.dest_ip ?? .metadata.destination_ip ?? .metadata.dst ?? 
               .metadata.server_ip ?? .metadata.destination.ip ?? null

# Source Host
.udm.src_host = .metadata.src_host ?? .metadata.source_host ?? .metadata.hostname ?? 
                .metadata.host ?? .metadata.source.hostname ?? .hostname ?? null

# Destination Host
.udm.dest_host = .metadata.dest_host ?? .metadata.destination_host ?? 
                 .metadata.destination.hostname ?? null

# Source Port
.udm.src_port = .metadata.src_port ?? .metadata.source_port ?? 
                .metadata.source.port ?? null

# Destination Port
.udm.dest_port = .metadata.dest_port ?? .metadata.destination_port ?? 
                 .metadata.destination.port ?? null

# Protocol
.udm.protocol = .metadata.protocol ?? .metadata.network.protocol ?? null

# User
.udm.user = .metadata.user ?? .metadata.username ?? .metadata.user.name ?? 
            .metadata.suser ?? .metadata.usrName ?? null

# Action
.udm.action = .metadata.action ?? .metadata.event_type ?? .metadata.event.action ?? 
              .metadata.act ?? null

# Status
.udm.status = .metadata.status ?? .metadata.result ?? .metadata.outcome ?? null

# Process fields
.udm.process_name = .metadata.process_name ?? .metadata.process.name ?? 
                    .metadata.program ?? .metadata.appname ?? .appname ?? null
.udm.process_id = .metadata.process_id ?? .metadata.process.pid ?? 
                  .metadata.pid ?? .metadata.procid ?? .procid ?? null
.udm.command_line = .metadata.command_line ?? .metadata.process.command_line ?? 
                    .metadata.cmdline ?? null

# File fields
.udm.file_path = .metadata.file_path ?? .metadata.file.path ?? .metadata.path ?? null
.udm.file_name = .metadata.file_name ?? .metadata.file.name ?? .metadata.filename ?? null
.udm.file_hash = .metadata.file_hash ?? .metadata.file.hash ?? .metadata.hash ?? null

# Timestamp - use event timestamp or current time
.udm.timestamp = .metadata.timestamp ?? .metadata."@timestamp" ?? .metadata.time ?? 
                 .timestamp ?? now()

# Ensure timestamp is in RFC3339 format
.udm.timestamp = to_string(to_timestamp(.udm.timestamp) ?? now())

# Add source type for tracking
.source_type = .metadata.source_type ?? "unknown"
'''

# Deduplicate logs within a time window
# Requirement 1.2: Deduplicate logs before storage
[transforms.dedupe]
type = "dedupe"
inputs = ["parse_logs"]
fields.match = ["raw_content"]
cache.num_events = 10000

# Prepare final output for PostgreSQL
[transforms.prepare_output]
type = "remap"
inputs = ["dedupe"]
source = '''
# Flatten structure for PostgreSQL insertion
. = {
    "timestamp": .udm.timestamp,
    "raw_content": .raw_content,
    "metadata": encode_json(.metadata),
    "src_ip": .udm.src_ip,
    "dest_ip": .udm.dest_ip,
    "src_host": .udm.src_host,
    "dest_host": .udm.dest_host,
    "src_port": .udm.src_port,
    "dest_port": .udm.dest_port,
    "protocol": .udm.protocol,
    "user": .udm.user,
    "action": .udm.action,
    "status": .udm.status,
    "process_name": .udm.process_name,
    "process_id": .udm.process_id,
    "command_line": .udm.command_line,
    "file_path": .udm.file_path,
    "file_name": .udm.file_name,
    "file_hash": .udm.file_hash
}
'''

# =============================================================================
# Sinks
# =============================================================================

# Primary HTTP Sink with Disk Buffer
# Sends logs to NanoSIEM's REST API with disk buffering for reliability
# Requirements: 2.1, 2.2, 2.3, 2.4, 2.5
#
# Note: Full buffer configuration is in sinks/buffer.toml
# This sink provides disk-based buffering to ensure no data loss during
# downstream outages or high load conditions.

[sinks.nanosiem_api]
type = "http"
# Include outputs from: main pipeline, DB-managed parsers, and routed HTTP logs
# - prepare_output: logs from syslog, file, and legacy HTTP sources
# - db_parsers_combined: logs from database-managed parsers
# - routed_output_final: logs from secure HTTP endpoints routed through source type router
#   (includes parse failure passthrough for Requirement 5.5)
inputs = ["prepare_output", "db_parsers_combined", "routed_output_final"]
uri = "${NANOSIEM_INGESTION_URL:-http://localhost:3000/api/ingest}"
method = "post"
encoding.codec = "json"

# Disk Buffer Configuration
# Requirement 2.1: Persist incoming logs to disk when downstream is unavailable
# Requirement 2.2: Configurable maximum size (default 1GB)
# Requirement 2.5: Survive Vector restarts without data loss
[sinks.nanosiem_api.buffer]
type = "disk"
# Maximum buffer size: 1GB (1073741824 bytes)
max_size = 1073741824
# Backpressure behavior when buffer is full
# Requirement 2.3: Apply backpressure by returning HTTP 503
when_full = "block"

# Batching Configuration
[sinks.nanosiem_api.batch]
max_bytes = 1048576  # 1MB
max_events = 100
timeout_secs = 5

# Request and Retry Configuration
# Requirement 2.4: Automatically drain buffered logs when downstream available
[sinks.nanosiem_api.request]
concurrency = 10
rate_limit_duration_secs = 1
rate_limit_num = 1000
# Retry configuration for downstream failures
retry_initial_backoff_secs = 1
retry_max_duration_secs = 300
timeout_secs = 30

[sinks.nanosiem_api.request.headers]
Content-Type = "application/json"

# Console sink for debugging (optional, disable in production)
# [sinks.console]
# type = "console"
# inputs = ["prepare_output"]
# encoding.codec = "json"
