# NanoSIEM Vector Configuration
# Single endpoint design - auto-detects format from Content-Type header
#
# Production: Deploy on port 443 with TLS
# Development: Port 8080 (no TLS)
#
# Endpoints:
#   POST /ingest      - JSON or raw text (auto-detect from Content-Type)
#   POST /ingest/batch - NDJSON batch logs
#   POST /webhook     - Webhooks (flexible JSON)
#
# Content-Type handling:
#   application/json      → JSON parsing
#   application/x-ndjson  → NDJSON (newline-delimited JSON)
#   text/plain            → Raw text logs
#   (default)             → Attempt JSON, fall back to raw text

data_dir = "/var/lib/vector"

# =============================================================================
# Single HTTP Source - All formats on one port
# =============================================================================
# For production: Change to 443 and enable TLS
# For dev: Use 8080 without TLS

[sources.http_ingest]
type = "http_server"
address = "0.0.0.0:8080"
encoding = "text"  # Accept everything as text, we'll parse in transform
strict_path = false
path = "/"
headers = ["Authorization", "X-Source-Type", "X-Api-Key", "Content-Type", "X-Forwarded-For", "X-Real-IP", "X-Webhook-Secret"]
max_body_size = 10485760

# TLS Configuration (uncomment for production)
# tls.enabled = true
# tls.crt_file = "/etc/vector/certs/server.crt"
# tls.key_file = "/etc/vector/certs/server.key"

# =============================================================================
# Authentication Transform
# =============================================================================
[transforms.auth_check]
type = "remap"
inputs = ["http_ingest"]
source = '''
# Get auth header
auth_header = ""
if exists(.Authorization) {
    auth_header = to_string(.Authorization) ?? ""
} else if exists(.authorization) {
    auth_header = to_string(.authorization) ?? ""
}

expected_token = get_env_var("VECTOR_AUTH_TOKEN") ?? ""

if expected_token == "" {
    .auth_status = "skipped"
} else {
    if auth_header == "" {
        log("Auth failed: No Authorization header", level: "warn")
        abort
    }
    if !starts_with(auth_header, "Bearer ") {
        log("Auth failed: Invalid format", level: "warn")
        abort
    }
    token = slice!(auth_header, 7)
    if token != expected_token {
        log("Auth failed: Invalid token", level: "warn")
        abort
    }
    .auth_status = "authenticated"
}

# Extract source type from header
source_type = "unknown"
if exists(."X-Source-Type") {
    source_type = to_string(."X-Source-Type") ?? "unknown"
}
.source_type = source_type

# Extract request path for routing
.request_path = to_string(.path) ?? "/"

# Clean up auth headers
del(.Authorization)
del(.authorization)
'''

# =============================================================================
# Rate Limiting
# =============================================================================
[transforms.rate_limit_prep]
type = "remap"
inputs = ["auth_check"]
source = '''
client_ip = null
xff = to_string(."X-Forwarded-For") ?? ""
if xff != "" {
    parts = split(xff, ",")
    if length(parts) > 0 {
        client_ip = strip_whitespace(parts[0]) ?? null
    }
}
if client_ip == null {
    client_ip = to_string(."X-Real-IP") ?? null
}
if client_ip == null {
    client_ip = "unknown"
}
.client_ip = client_ip
'''

[transforms.rate_limit]
type = "throttle"
inputs = ["rate_limit_prep"]
threshold = 1000
window_secs = 1
key_field = "client_ip"

# =============================================================================
# Content-Type Detection & Parsing
# =============================================================================
[transforms.parse_content]
type = "remap"
inputs = ["rate_limit"]
source = '''
# Get Content-Type header
content_type = to_string(."Content-Type") ?? to_string(."content-type") ?? ""
content_type = downcase(content_type)

# Get the raw message
raw = to_string(.message) ?? ""
.raw_content = raw
.metadata = {}
.content_format = "unknown"

# Determine format from Content-Type
if contains(content_type, "application/json") {
    # JSON format
    .content_format = "json"
    parsed, err = parse_json(raw)
    if err == null {
        .metadata = parsed
        # Check for source_type in body if not in header
        if .source_type == "unknown" {
            body_source_type = to_string(parsed.source_type) ?? null
            if body_source_type != null {
                .source_type = body_source_type
            }
        }
    }
} else if contains(content_type, "application/x-ndjson") || contains(content_type, "ndjson") {
    # NDJSON - each line is a separate JSON object
    # Vector handles this at the source level, but we mark it
    .content_format = "ndjson"
    parsed, err = parse_json(raw)
    if err == null {
        .metadata = parsed
        if .source_type == "unknown" {
            body_source_type = to_string(parsed.source_type) ?? null
            if body_source_type != null {
                .source_type = body_source_type
            }
        }
    }
} else if contains(content_type, "text/plain") || contains(content_type, "text/") {
    # Raw text - store as-is
    .content_format = "raw"
    .metadata = { "raw_log": raw }
} else {
    # Auto-detect: try JSON first, fall back to raw
    if starts_with(raw, "{") || starts_with(raw, "[") {
        parsed, err = parse_json(raw)
        if err == null {
            .content_format = "json"
            .metadata = parsed
            if .source_type == "unknown" {
                body_source_type = to_string(parsed.source_type) ?? null
                if body_source_type != null {
                    .source_type = body_source_type
                }
            }
        } else {
            .content_format = "raw"
            .metadata = { "raw_log": raw }
        }
    } else {
        .content_format = "raw"
        .metadata = { "raw_log": raw }
    }
}

# Mark webhook requests
if contains(to_string(.request_path) ?? "", "/webhook") {
    .is_webhook = true
}
'''

# =============================================================================
# Source Type Extraction and Normalization
# =============================================================================
# Requirements 5.1, 5.2, 5.3: Route based on source type
[transforms.source_type_extract]
type = "remap"
inputs = ["parse_content"]
source = '''
# =============================================================================
# Step 1: Extract Source Type from Headers (Priority 1)
# =============================================================================
# Requirement 5.1: Route based on X-Source-Type header

source_type = "unknown"
if exists(.source_type) && is_string(.source_type) {
    source_type = to_string!(.source_type)
}

# If still unknown, check headers again (case-insensitive)
if source_type == "unknown" {
    if exists(."X-Source-Type") {
        st = to_string(."X-Source-Type") ?? ""
        if st != "" {
            source_type = downcase(st)
        }
    }
}
if source_type == "unknown" {
    if exists(."x-source-type") {
        st = to_string(."x-source-type") ?? ""
        if st != "" {
            source_type = downcase(st)
        }
    }
}

# =============================================================================
# Step 2: Fall Back to Body Field (Priority 2)
# =============================================================================
# Requirement 5.2: Use source_type field in body if no header present

if source_type == "unknown" {
    # Check in metadata (parsed JSON body)
    if is_object(.metadata) && exists(.metadata.source_type) {
        st = to_string(.metadata.source_type) ?? ""
        if st != "" {
            source_type = downcase(st)
        }
    }
}
if source_type == "unknown" {
    # Check in data object (common wrapper)
    if is_object(.metadata) && is_object(.metadata.data) && exists(.metadata.data.source_type) {
        st = to_string(.metadata.data.source_type) ?? ""
        if st != "" {
            source_type = downcase(st)
        }
    }
}

# =============================================================================
# Step 3: Normalize Source Type Aliases
# =============================================================================
# Map common aliases to canonical source types

# Windows Event Log aliases
if source_type == "winlog" || source_type == "windows" || source_type == "winevt" {
    source_type = "windows_event"
}

# Apache aliases
if source_type == "apache_access" || source_type == "httpd" {
    source_type = "apache"
}

# AWS CloudTrail aliases
if source_type == "cloudtrail" || source_type == "aws_ct" {
    source_type = "aws_cloudtrail"
}

# Syslog aliases
if source_type == "rsyslog" || source_type == "syslog-ng" {
    source_type = "syslog"
}

# Firewall aliases
if source_type == "pan" || source_type == "panos" {
    source_type = "palo_alto"
}
if source_type == "asa" || source_type == "cisco_firewall" {
    source_type = "cisco_asa"
}
if source_type == "fortigate" || source_type == "fgt" {
    source_type = "fortinet"
}

# Set the normalized source type
.source_type = source_type

# Add routing metadata
.routing_timestamp = now()
'''

# =============================================================================
# Source Type Router
# =============================================================================
# Routes logs to appropriate parsers based on source type
# Requirement 5.3: Default to generic parser when unspecified
[transforms.source_router]
type = "route"
inputs = ["source_type_extract"]

[transforms.source_router.route]
# Endpoint category parsers
windows_event = '.source_type == "windows_event"'
sysmon = '.source_type == "sysmon"'

# Network category parsers
palo_alto = '.source_type == "palo_alto"'
fortinet = '.source_type == "fortinet"'
cisco_asa = '.source_type == "cisco_asa"'
syslog = '.source_type == "syslog"'

# Cloud category parsers
aws_cloudtrail = '.source_type == "aws_cloudtrail"'
aws_guardduty = '.source_type == "aws_guardduty"'
azure_activity = '.source_type == "azure_activity"'
azure_signin = '.source_type == "azure_signin"'

# Identity category parsers
okta = '.source_type == "okta"'

# Application category parsers
apache = '.source_type == "apache"'
nginx = '.source_type == "nginx"'

# Generic/default route for unknown source types
# Requirement 5.3: Default to generic parser when unspecified
generic = 'true'

# =============================================================================
# Placeholder Parsers for Routed Source Types
# =============================================================================
# These transforms handle routed logs until specific parsers are deployed
# They pass through with source type preserved for future parser deployment

[transforms.windows_event_placeholder]
type = "remap"
inputs = ["source_router.windows_event"]
source = '.metadata.awaiting_parser = "windows_event"'

[transforms.sysmon_placeholder]
type = "remap"
inputs = ["source_router.sysmon"]
source = '.metadata.awaiting_parser = "sysmon"'

[transforms.palo_alto_placeholder]
type = "remap"
inputs = ["source_router.palo_alto"]
source = '.metadata.awaiting_parser = "palo_alto"'

[transforms.fortinet_placeholder]
type = "remap"
inputs = ["source_router.fortinet"]
source = '.metadata.awaiting_parser = "fortinet"'

[transforms.cisco_asa_placeholder]
type = "remap"
inputs = ["source_router.cisco_asa"]
source = '.metadata.awaiting_parser = "cisco_asa"'

[transforms.syslog_placeholder]
type = "remap"
inputs = ["source_router.syslog"]
source = '.metadata.awaiting_parser = "syslog"'

[transforms.aws_cloudtrail_placeholder]
type = "remap"
inputs = ["source_router.aws_cloudtrail"]
source = '.metadata.awaiting_parser = "aws_cloudtrail"'

[transforms.aws_guardduty_placeholder]
type = "remap"
inputs = ["source_router.aws_guardduty"]
source = '.metadata.awaiting_parser = "aws_guardduty"'

[transforms.azure_activity_placeholder]
type = "remap"
inputs = ["source_router.azure_activity"]
source = '.metadata.awaiting_parser = "azure_activity"'

[transforms.azure_signin_placeholder]
type = "remap"
inputs = ["source_router.azure_signin"]
source = '.metadata.awaiting_parser = "azure_signin"'

[transforms.okta_placeholder]
type = "remap"
inputs = ["source_router.okta"]
source = '.metadata.awaiting_parser = "okta"'

# Apache placeholder disabled - real parser deployed in sources/parsers/apache.toml
# [transforms.apache_placeholder]
# type = "remap"
# inputs = ["source_router.apache"]
# source = '.metadata.awaiting_parser = "apache"'

[transforms.nginx_placeholder]
type = "remap"
inputs = ["source_router.nginx"]
source = '.metadata.awaiting_parser = "nginx"'

# =============================================================================
# Generic Parser (Default)
# =============================================================================
# Handles logs with unknown or unspecified source types
# Requirement 5.3: Default to generic parser when unspecified
# Requirement 5.5: Pass raw logs on parse failure with source_type indicating failure
[transforms.generic_parser]
type = "remap"
inputs = ["source_router.generic"]
drop_on_abort = false
drop_on_error = false
source = '''
# Mark as generically parsed
if !is_object(.metadata) {
    .metadata = {}
}
.metadata.parser_type = "generic"

original_source_type = "unknown"
if exists(.source_type) && is_string(.source_type) {
    original_source_type = to_string!(.source_type)
}
.metadata.original_source_type = original_source_type

# Requirement 5.5: Handle parse failures
# If there's a parse error, mark it appropriately
has_parse_error = exists(.parse_error) || exists(.metadata.parse_error)
if has_parse_error {
    parse_error = "Unknown parse error"
    if exists(.parse_error) {
        parse_error = to_string(.parse_error) ?? "Unknown parse error"
    }
    if exists(.metadata.parse_error) {
        parse_error = to_string(.metadata.parse_error) ?? parse_error
    }
    log("Parser failure for source_type=" + original_source_type + ": " + parse_error, level: "warn")
    .metadata.parse_failure = true
    .metadata.parse_error = parse_error
    .source_type = "parse_failure"
    .metadata.failure_timestamp = to_string(now())
}
# Keep source_type as-is for tracking (unless it's a failure)
'''

# =============================================================================
# Placeholder Combiner
# =============================================================================
# Combines all placeholder outputs for normalization
[transforms.placeholder_combiner]
type = "remap"
inputs = [
    "windows_event_placeholder",
    "sysmon_placeholder",
    "palo_alto_placeholder",
    "fortinet_placeholder",
    "cisco_asa_placeholder",
    "syslog_placeholder",
    "aws_cloudtrail_placeholder",
    "aws_guardduty_placeholder",
    "azure_activity_placeholder",
    "azure_signin_placeholder",
    "okta_placeholder",
    # "apache_placeholder",  # Disabled - real parser deployed
    "nginx_placeholder",
    "generic_parser"
]
source = '''
# Preserve routing metadata
.routed = true
'''

# =============================================================================
# Normalization - Extract UDM fields
# =============================================================================
[transforms.normalize]
type = "remap"
inputs = ["placeholder_combiner"]
source = '''
# Initialize UDM fields from metadata (for JSON logs)
.udm = {}
.udm.src_ip = .metadata.src_ip
.udm.dest_ip = .metadata.dest_ip
.udm.src_host = .metadata.src_host
.udm.dest_host = .metadata.dest_host
.udm.src_port = .metadata.src_port
.udm.dest_port = .metadata.dest_port
.udm.protocol = .metadata.protocol
.udm.user = .metadata.user
.udm.action = .metadata.action
.udm.status = .metadata.status
.udm.process_name = .metadata.process_name
.udm.process_id = .metadata.process_id
.udm.command_line = .metadata.command_line
.udm.file_path = .metadata.file_path
.udm.file_name = .metadata.file_name
.udm.file_hash = .metadata.file_hash

# Timestamp handling
ts = .metadata.timestamp
if ts == null { ts = .timestamp }
if ts == null { ts = now() }
if is_string(ts) {
    parsed_ts, err = parse_timestamp(ts, "%+")
    if err == null { ts = parsed_ts }
}
if !is_timestamp(ts) { ts = now() }
.udm.timestamp = format_timestamp!(ts, "%+")
'''

# =============================================================================
# Output Preparation
# =============================================================================
[transforms.prepare_output]
type = "remap"
inputs = ["normalize"]
source = '''
src_type = .source_type
if src_type == null { src_type = "unknown" }
. = {
    "timestamp": .udm.timestamp,
    "raw_content": .raw_content,
    "metadata": encode_json(.metadata),
    "source_type": src_type,
    "src_ip": .udm.src_ip,
    "dest_ip": .udm.dest_ip,
    "src_host": .udm.src_host,
    "dest_host": .udm.dest_host,
    "src_port": .udm.src_port,
    "dest_port": .udm.dest_port,
    "protocol": .udm.protocol,
    "user": .udm.user,
    "action": .udm.action,
    "status": .udm.status,
    "process_name": .udm.process_name,
    "process_id": .udm.process_id,
    "command_line": .udm.command_line,
    "file_path": .udm.file_path,
    "file_name": .udm.file_name,
    "file_hash": .udm.file_hash
}
'''

# =============================================================================
# Internal Metrics
# =============================================================================
[sources.internal_metrics]
type = "internal_metrics"
scrape_interval_secs = 15
namespace = "nanosiem_vector"

# =============================================================================
# Sinks
# =============================================================================
[sinks.nanosiem_api]
type = "http"
# Include outputs from the main pipeline
# - prepare_output: logs that were successfully parsed/routed
# - db_parsers_combined: logs from deployed DB parsers (e.g., Apache)
# Note: Parse failures are handled inline in the generic_parser and marked
# with source_type="parse_failure" (Requirement 5.5)
inputs = ["prepare_output", "db_parsers_combined"]
uri = "${NANOSIEM_INGESTION_URL:-http://host.docker.internal:3000/api/ingest}"
method = "post"
encoding.codec = "json"

[sinks.nanosiem_api.buffer]
type = "disk"
max_size = 1073741824
when_full = "block"

[sinks.nanosiem_api.batch]
max_bytes = 1048576
max_events = 100
timeout_secs = 5

[sinks.nanosiem_api.request]
concurrency = 10
rate_limit_duration_secs = 1
rate_limit_num = 1000
retry_initial_backoff_secs = 1
retry_max_duration_secs = 300
timeout_secs = 30

[sinks.nanosiem_api.request.headers]
Content-Type = "application/json"

[sinks.prometheus_metrics]
type = "prometheus_exporter"
inputs = ["internal_metrics"]
address = "0.0.0.0:9598"
default_namespace = "nanosiem"
