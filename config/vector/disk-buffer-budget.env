# Canonical Vector disk-buffer inventory and minimum (NAN-5004 follow-up).
#
# The static count is not shard-expanded (OTLP traces + metrics). The sharded
# count is the maximum supported generated graph: logs, parser health, OCSF,
# two enrichment success tables, and enrichment dead letter. deploy.rs refuses
# a generated enrichment lane that would exceed this inventory. The compose
# autosizer and Helm renderer both consume this file; do not duplicate these
# numbers in deployment arithmetic.
VECTOR_DISK_BUFFER_MIN_BYTES=268435488
VECTOR_DISK_BUFFER_STATIC_COUNT=2
VECTOR_DISK_BUFFER_PIPELINE_SHARDED_COUNT=3
VECTOR_DISK_BUFFER_ENRICHMENT_SHARDED_COUNT=3
