# Secure HTTP Source Configuration for NanoSIEM
#
# This configuration provides secure HTTP(S) ingestion endpoints with:
# - Bearer token authentication
# - TLS/HTTPS support
# - JSON and NDJSON encoding
# - Rate limiting and request validation
# - Request body size limits
#
# Requirements: 1.1, 1.2, 1.4, 1.5, 1.6, 3.1, 3.2, 3.3, 3.4

# =============================================================================
# Secure HTTP Endpoint (Non-TLS)
# =============================================================================
# HTTP endpoint with authentication for internal/development use
# Port 8080 - Use for non-TLS connections

[sources.http_secure]
type = "http_server"
address = "0.0.0.0:8080"
encoding = "json"
strict_path = false
path = "/ingest"

# Capture headers for authentication, routing, and rate limiting
# X-Forwarded-For and X-Real-IP are used for per-IP rate limiting
headers = ["Authorization", "X-Source-Type", "X-Api-Key", "Content-Type", "X-Forwarded-For", "X-Real-IP"]

# Request body size limit (10MB default)
# Requirement 3.3: Maximum request body size
# Requirement 3.4: Return HTTP 413 Payload Too Large when exceeded
# Vector automatically returns 413 when body exceeds this limit
max_body_size = 10485760

# =============================================================================
# Secure HTTPS Endpoint (TLS)
# =============================================================================
# HTTPS endpoint with TLS encryption for production use
# Port 8443 - Use for TLS connections
# Requirement 1.6: TLS certificate support

[sources.https_secure]
type = "http_server"
address = "0.0.0.0:8443"
encoding = "json"
strict_path = false
path = "/ingest"

# TLS Configuration
tls.enabled = true
tls.crt_file = "/etc/vector/certs/server.crt"
tls.key_file = "/etc/vector/certs/server.key"

# Capture headers for authentication, routing, and rate limiting
# X-Forwarded-For and X-Real-IP are used for per-IP rate limiting
headers = ["Authorization", "X-Source-Type", "X-Api-Key", "Content-Type", "X-Forwarded-For", "X-Real-IP"]

# Request body size limit (10MB default)
# Requirement 3.3: Maximum request body size
# Requirement 3.4: Return HTTP 413 Payload Too Large when exceeded
max_body_size = 10485760

# =============================================================================
# NDJSON Secure Endpoint
# =============================================================================
# Accepts newline-delimited JSON for batch log submissions
# Requirement 1.4: Support NDJSON encoding

[sources.http_secure_ndjson]
type = "http_server"
address = "0.0.0.0:8085"
encoding = "ndjson"
strict_path = false
path = "/ingest/batch"

# Capture headers for authentication, routing, and rate limiting
headers = ["Authorization", "X-Source-Type", "X-Api-Key", "Content-Type", "X-Forwarded-For", "X-Real-IP"]

# Request body size limit (10MB default)
# Requirement 3.3: Maximum request body size
# Requirement 3.4: Return HTTP 413 Payload Too Large when exceeded
max_body_size = 10485760

# =============================================================================
# Webhook Endpoint (Flexible)
# =============================================================================
# Accepts webhooks from third-party services with flexible validation
# Requirement 8.5: Accept requests without strict JSON validation

[sources.webhook_secure]
type = "http_server"
address = "0.0.0.0:8086"
encoding = "json"
strict_path = false
path = "/webhook"

# Capture headers for authentication, routing, and rate limiting
headers = ["Authorization", "X-Source-Type", "X-Api-Key", "Content-Type", "X-Webhook-Secret", "X-Forwarded-For", "X-Real-IP"]

# Request body size limit (10MB default)
# Requirement 3.3: Maximum request body size
# Requirement 3.4: Return HTTP 413 Payload Too Large when exceeded
max_body_size = 10485760
