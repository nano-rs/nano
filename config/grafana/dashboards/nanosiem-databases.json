      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(up{job=\"clickhouse\", host=~\"$host\"} == 1) or vector(0)",
          "legendFormat": ""
