{
  "uid": "nanosiem-ha",
  "title": "nano HA",
  "description": "The highly available pieces: PostgreSQL (Patroni) and etcd, Valkey and Sentinel, ClickHouse replicas and Keeper, the host-local routers, and the jobs leader. Panels stay empty on a shape without that piece.",
  "tags": [
    "nano",
    "ha"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "nano"
      ],
      "asDropdown": true,
      "title": "nano dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up, host)",
          "refId": "host"
        },
        "definition": "label_values(up, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
