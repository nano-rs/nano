      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nanosiem_audit_outbox_deferred_total{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "deferred"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nanosiem_audit_outbox_delivered_total{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "delivered"
