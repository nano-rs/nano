        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nanosiem_audit_emit_failures_total{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "emit failures"
