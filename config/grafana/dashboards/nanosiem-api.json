    {
      "type": "timeseries",
      "title": "Audit outbox",
      "description": "Security audit events queued, delivered and failed. Failures should stay at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
