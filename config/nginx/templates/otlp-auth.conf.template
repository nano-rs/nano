# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/otlp-auth.conf (included by nginx.opensource.conf).
# OTLP/HTTP through this edge takes the install's ingest token, exactly like
# /ingest and HEC: `Authorization: Bearer <VECTOR_AUTH_TOKEN>`. A blank token
# is refused in the location itself.
map $http_authorization $otlp_authorized {
    default 0;
    "Bearer ${VECTOR_AUTH_TOKEN}" 1;
}
