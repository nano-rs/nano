# nano — open-source quickstart environment
#
# Copy to .env (or let install.sh generate one for you) and fill in the
# values marked CHANGE_ME. install.sh autogenerates the secret values via
# `openssl rand -hex 32` so you don't have to.

# Release tag pulled from ghcr.io/nano-rs/*. Required: there is no `latest`
# fallback (`latest` is frozen on the 0.1.x ClickHouse line). install.sh pins
# it from images.lock; by hand: NANO_VERSION=$(./scripts/nano-release-pin.sh)
NANO_VERSION=

# Public URL users hit. Examples:
#   http://localhost       (default, single-host dev)
#   http://10.0.1.42       (LAN install)
#   https://nano.example   (production, layer in TLS via nginx overlay)
BASE_URL=http://localhost

# === Secrets — autogenerated by install.sh ===
# PostgreSQL control-plane password (32-byte hex)
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing secret (32-byte hex)
JWT_SECRET=CHANGE_ME

# Application encryption key (32-byte hex, used for secret-at-rest encryption)
NANOSIEM_ENCRYPTION_KEY=CHANGE_ME

# Vector HTTP ingestion auth token (clients send `Authorization: Bearer <token>`)
VECTOR_AUTH_TOKEN=CHANGE_ME

# === Canonical OCSF 1.9 object lake ===
# This is a fresh-install contract, not an in-place migration from an existing
# UDM/ClickHouse deployment. The `lean` profile starts no gen1 or ClickHouse process.
COMPOSE_PROFILES=lean
NANO_ENABLE_LAKE_CONTROL_PLANE=1

# These values are autogenerated by install.sh when the lake is
# enabled. RustFS is a singleton in open core. Paid production deployments use
# the same contracts with HA PostgreSQL, replicated auth/catalog APIs, and
# distributed RustFS or managed object storage.
NANO_LAKE_ACCESS_KEY_ID=CHANGE_ME
NANO_LAKE_SECRET_ACCESS_KEY=CHANGE_ME
NANO_LAKE_ENTITY_HMAC_KEY=CHANGE_ME
NANO_LAKE_QUERY_TOKEN=CHANGE_ME
# Separate least-privilege credentials for mutable IOC publication and native
# OTLP ingest/query. These are materialized as mode-0600 files by the bootstrap.
NANO_LAKE_ENRICHMENT_TOKEN=CHANGE_ME
NANO_LOCAL_AUDIT_TOKEN=CHANGE_ME
NANO_OTEL_LAKE_INGEST_TOKEN=CHANGE_ME
NANO_OTEL_LAKE_QUERY_TOKEN=CHANGE_ME
# Written by the lane A initializer and stamped by install.sh. Do not invent an ID.
NANO_LAKE_TENANT_ID=
NANO_OTEL_LAKE_HOST=lean-otel
NANO_LAKE_ENRICHMENT_HOST=lean-enrichment
NANO_OTEL_LAKE_QUERY_TOKEN_FILE=/etc/nano-lake-cell/otel-query.token
NANO_LAKE_ENRICHMENT_COORDINATOR_TOKEN_FILE=/etc/nano-lake-cell/enrichment.token
# Container memory backstop for the lake cell; install.sh sizes it from the
# budget lean-init placed (0 = unlimited).
NANO_LAKE_CELL_MEM_LIMIT=0
# nano-jobs container memory limit; install.sh sizes it on lean from the
# placed detect budget (1G floor, 4G cap). Leave unset elsewhere (1G).
# NANO_JOBS_MEM_LIMIT=1G
# Vector's raw OTLP ports (4317/4318) are unauthenticated and listen on
# loopback. Remote OTLP/HTTP uses <base>/otlp with VECTOR_AUTH_TOKEN.
NANO_OTLP_BIND_ADDRESS=127.0.0.1
# Remaining catalog/generation settings below are for the prior `lake` profile.
# They are inactive in lean and are not history adoption settings.
# These three values identify one event table and must move together. The
# generation manager reads the same immutable objects that the Iceberg catalog
# names; pointing it at another prefix would build valid-looking indexes for
# the wrong table.
NANO_LAKE_EVENT_TABLE=default.events
NANO_LAKE_EVENT_TABLE_LOCATION_PREFIX=s3://nano-lake/warehouse/default/events/
NANO_LAKE_WORKER_SOURCE=http://lake-object-store:9000/nano-lake/warehouse/default/events
NANO_LAKEKEEPER_DB_PASSWORD=CHANGE_ME
NANO_LAKEKEEPER_OIDC_DB_PASSWORD=CHANGE_ME
NANO_LAKEKEEPER_OPENFGA_DB_PASSWORD=CHANGE_ME
NANO_LAKEKEEPER_ENCRYPTION_KEY=CHANGE_ME
NANO_LAKEKEEPER_OIDC_SYSTEM_SECRET=CHANGE_ME
NANO_LAKEKEEPER_OIDC_PAIRWISE_SALT=CHANGE_ME
NANO_LAKEKEEPER_OPERATOR_CLIENT_SECRET=CHANGE_ME
NANO_LAKEKEEPER_RUNTIME_CLIENT_SECRET=CHANGE_ME
NANO_LAKEKEEPER_OPENFGA_PRESHARED_KEY=CHANGE_ME

# Runtime catalog client contract. Lakekeeper is Nano's catalog in both open
# core and paid deployments; the local control plane provisions this exact
# Hydra scope/audience pair. Only old validation fixtures should override it.
NANO_LAKE_CATALOG_OAUTH_SCOPE=lakekeeper
NANO_LAKE_CATALOG_OAUTH_AUDIENCE=lakekeeper

# IOC readers derive `ioc-${NANO_LAKE_TENANT_ID}-current` automatically. This
# override exists only for an explicitly pinned historical/fault-test worker.
# NANO_LAKE_IOC_SNAPSHOT_ID=ioc-default-current

# install.sh replaces these conservative 12 GiB-host fallbacks with one
# coherent plan based on Docker's real memory capacity. Example automatic plans:
#   Docker RAM    interactive/container    durable medium -> large/container
#   12 GiB        1 GiB / 3G               2 GiB -> 2 GiB / 3G
#   16 GiB        2 GiB / 5G               2 GiB -> 4 GiB / 5G
#   32 GiB        4 GiB / 9G               7 GiB -> 14 GiB / 15G
#   64+ GiB       4 GiB / 9G              16 GiB -> 32 GiB / 33G
# The interactive container briefly holds two generations' derivative state
# during an atomic swap; its larger envelope does not raise the query ceiling.
# The unused envelope remains available to Nano, PostgreSQL, Vector, Dragonfly,
# RustFS, and the catalog while an interactive and durable query overlap. To
# tune manually, set all five values together; partial plans are rejected.
NANO_LAKE_MEMORY_SIZING=manual
NANO_LAKE_MAX_MEMORY_BYTES=1073741824
NANO_LAKE_QUERY_CONTAINER_MEM_LIMIT=3G
NANO_LAKE_DURABLE_MEDIUM_MEMORY_BYTES=2147483648
NANO_LAKE_DURABLE_LARGE_MEMORY_BYTES=2147483648
NANO_LAKE_DURABLE_RUNNER_MEM_LIMIT=3G
# Durable attempts get a separate, finite scan allowance. A resource-bound
# medium attempt retries once in the large class before failing cleanly.
NANO_LAKE_DURABLE_MEDIUM_SCAN_BYTES=68719476736
NANO_LAKE_DURABLE_LARGE_SCAN_BYTES=1099511627776

# Every long-lived native lake process has a hard cgroup memory/PID envelope.
# These are container safety ceilings, not reservations. Increase a publisher
# only after measuring its real peak on the target corpus; never remove the
# fence to work around a repeatable growth bug.
NANO_LAKE_QUERY_PIDS_LIMIT=512
NANO_LAKE_DURABLE_PIDS_LIMIT=512
NANO_LAKE_MAINTENANCE_PIDS_LIMIT=256
NANO_LAKE_GENERATION_PIDS_LIMIT=512
# Keep the physical Vector object and publisher transaction on one row bound.
# The 4-GiB cgroup was validated with this 65,536-row operating unit; raising
# either value independently is not a supported deployment.
NANO_LAKE_BRONZE_PUBLISHER_MEM_LIMIT=4G
NANO_LAKE_BRONZE_PUBLISH_MAX_ROWS=65536
NANO_LAKE_BRONZE_UID_CACHE_BYTES=1073741824
NANO_LAKE_BRONZE_UID_READ_CONCURRENCY=32
# One resolved hot-tail envelope must reach the signer, generation activator,
# reader, and local exact cache. Schema v4 is a rolling-deploy switch: change it
# to true only after all query workers run an image that supports the cache.
NANO_LAKE_HOT_TAIL_MAX_BYTES=1073741824
NANO_LAKE_HOT_TAIL_STAGED_MAX_OBJECTS=2048
NANO_LAKE_HOT_TAIL_COMMITTED_MAX_OBJECTS=2048
NANO_LAKE_HOT_TAIL_CACHE_SCHEMA_V4=false
NANO_LAKE_GENERATION_PROMOTION_HOT_TAIL_ROWS=0
NANO_LAKE_STAGED_TAIL_MEM_LIMIT=512M
NANO_LAKE_TAIL_PACKER_MEM_LIMIT=1G
NANO_LAKE_TAIL_COMPACTOR_MEM_LIMIT=2G
NANO_LAKE_GENERATION_MEM_LIMIT=3G
NANO_LAKE_RETENTION_MEM_LIMIT=1G
NANO_LAKE_EVENT_PUBLISHER_MEM_LIMIT=768M
NANO_LAKE_RISK_PUBLISHER_MEM_LIMIT=1G
NANO_LAKE_ENRICHMENT_COORDINATOR_MEM_LIMIT=2G
NANO_OTEL_LAKE_MEM_LIMIT=2G

# Retention deletes complete expired event-hour partitions in bounded commits.
# Old objects remain through this grace window so in-flight durable jobs and
# rollback snapshots stay readable; it must exceed the maximum job lifetime.
# Physical deletion is reference-checked and versioned buckets must also expire
# noncurrent object versions according to the deployment provider's lifecycle.
NANO_LAKE_RETENTION_MAX_FILES=10000
NANO_LAKE_RETENTION_MAX_BYTES=10737418240
NANO_LAKE_RETENTION_GC_GRACE_SECS=604800
NANO_LAKE_RETENTION_GC_BATCH=1000
NANO_LAKE_RETENTION_SNAPSHOT_RETAIN_LAST=8
NANO_LAKE_RETENTION_POLL_SECS=300

# Fresh lake installs send Vector's OCSF 1.9 Parquet bronze objects to the
# bundled versioned RustFS bucket. Paid deployments replace the endpoint and
# credentials with their provider's object store/workload identity.
# install.sh sets this together with the mutually exclusive `lake` profile.
NANO_LOG_QUERY_BACKEND=lake
NANO_LAKE_BRONZE_BUCKET=nano-lake
NANO_LAKE_OBJECT_ENDPOINT=http://lake-object-store:9000
NANO_LAKE_FORCE_PATH_STYLE=true
# Tail objects stay queryable immediately while these settings merge writer
# flushes into sized Parquet. MAX_AGE also delays closed-hour finalization long
# enough to include the writer's final flush. It must be greater than the
# configured Vector flush interval. Large/high-EPS deployments normally tune
# MAX_BYTES and worker sharding, not this correctness watermark.
NANO_LAKE_TAIL_PACK_TARGET_OBJECTS=4
NANO_LAKE_TAIL_PACK_MAX_OBJECTS=256
NANO_LAKE_TAIL_PACK_MAX_BYTES=134217728
NANO_LAKE_TAIL_PACK_MAX_AGE_SECS=60
NANO_LAKE_TAIL_PACK_POLL_SECS=2

# New lake installations use canonical OCSF 1.9. UDM exists only on the
# unsupported legacy ClickHouse profile and is not a lake contract.
NANO_SCHEMA_PROFILE=ocsf

# Legacy UDM/ClickHouse installs (unsupported; support window ended) instead use
# COMPOSE_PROFILES=legacy, NANO_LOG_QUERY_BACKEND=clickhouse, and the following
# generated secrets. They are deliberately absent from a fresh lake install:
# CLICKHOUSE_MEM_LIMIT=4G
# CLICKHOUSE_PASSWORD=CHANGE_ME
# CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME
# CLICKHOUSE_INGEST_PASSWORD=CHANGE_ME
# CLICKHOUSE_RAWSQL_PASSWORD=CHANGE_ME
# CLICKHOUSE_RAWSQL_NOAUDIT_PASSWORD=CHANGE_ME

# Log verbosity for Rust services: error | warn | info | debug | trace
RUST_LOG=info
# Dragonfly backs both ephemeral search caches and the durable-query control
# plane. Result bytes remain in object storage. cache_mode stays disabled so
# queued jobs are never silently evicted; snapshots bound standalone recovery
# to a one-minute RPO by default.
NANO_DRAGONFLY_MAXMEMORY=512mb
NANO_DRAGONFLY_SNAPSHOT_CRON=* * * * *

# Dedicated pull-feed runner. Vendor tokens are entered in the UI and sealed in PostgreSQL.
CONNECTOR_POLL_INTERVAL_SECS=30
CONNECTOR_MEM_LIMIT=2G
