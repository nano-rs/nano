# nano — open-source quickstart environment
#
# Copy to .env (or let install.sh generate one for you) and fill in the
# values marked CHANGE_ME. install.sh autogenerates the secret values via
# `openssl rand -hex 32` so you don't have to.

# Release image tag pulled from ghcr.io/nano-rs/*. REQUIRED: compose refuses to
# start without it (no `latest` fallback). Set it to a published release; as of
# NAN-4968, install.sh fills it from images.lock.
NANO_VERSION=

# Public URL users hit. Examples:
#   http://localhost       (default, single-host dev)
#   http://10.0.1.42       (LAN install)
#   https://nano.example   (production, layer in TLS via docker-compose.tls.yml)
BASE_URL=http://localhost

# === Secrets — autogenerated by install.sh ===
# Database passwords (32-byte hex)
POSTGRES_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME
CLICKHOUSE_VECTOR_PASSWORD=CHANGE_ME

# JWT signing secret (32-byte hex)
JWT_SECRET=CHANGE_ME

# Application encryption key (32-byte hex, used for secret-at-rest encryption)
NANOSIEM_ENCRYPTION_KEY=CHANGE_ME

# Vector HTTP ingestion auth token (clients send `Authorization: Bearer <token>`)
VECTOR_AUTH_TOKEN=CHANGE_ME

# === Optional ===
# Storage schema profile: ocsf | udm
#   ocsf — Open Cybersecurity Schema Framework 1.9 (vendor-neutral standard).
#          Default for new installs (NAN-4903); parsers and rules follow the
#          `main` content channel.
#   udm  — nano's legacy native schema (CIM-style, short field names). Kept for
#          existing installs; its content stays on the `legacy/clickhouse` branch.
# Chosen at first install and IMMUTABLE afterward — it selects the ClickHouse
# tables, parsers, and field universe the whole stack runs against, so changing
# it after ingest would point search/detection at a different, empty table.
# Keep this line: compose falls back to `udm` when the key is ABSENT, because an
# .env without it predates the profile choice (those installs hold UDM data).
NANO_SCHEMA_PROFILE=ocsf
NANO_FUTURE_TIMESTAMP_SKEW_SECONDS=86400
# Disk-buffer acknowledgement durability (NAN-5287): fsync (default; a 2xx
# survives a power or host failure) or page_cache (about 1.7-2.2x the ingest
# request rate, but a host failure can lose up to ~500 ms of acknowledged
# events). See docs/configuration/vector.md.
# NANO_INGEST_ACK_DURABILITY=fsync

# Optional host allowlist for external lookup URLs (`| inputlookup url=...`).
# When set, only these hosts and their subdomains are fetched. Unset = any
# public host (default). Internal lookup tables are unaffected.
# Administrators can add hosts in Settings > Lookup URLs; those are merged with
# this list. INPUTLOOKUP_ALLOWED_DOMAINS_LOCKED=true makes this list an
# override: the Settings list is ignored and read-only.
# INPUTLOOKUP_ALLOWED_DOMAINS=api.ipinfo.io,feeds.example.com
# INPUTLOOKUP_ALLOWED_DOMAINS_LOCKED=false

# Log verbosity for Rust services: error | warn | info | debug | trace
RUST_LOG=info

# Planned daily volume (whole GB/day) and how events arrive: raw logs parsed by
# nano (default) or preshaped OCSF from Tenzir/Cribl. Unset keeps host-only
# sizing; 300+ GB/day selects the large-deployment ClickHouse and Vector
# settings (NAN-5345). See docs/getting-started/docker-deployment.md.
# NANO_PLANNED_GB_PER_DAY=1000
# NANO_INGEST_PATH=raw

# Event retention in days: the ClickHouse TTL on the event tables (1-3650).
# Unset keeps the shipped 365 days, or whatever Settings -> Storage set. The
# migrator applies a new value on the next `docker compose up`; it applies it
# only when it changes, so a later change in Settings -> Storage survives a
# restart. The disk still caps retention: when ClickHouse passes 80 % of its
# disk, nano drops the oldest days first (NAN-5449,
# docs/administration/retention.md).
# NANO_RETENTION_DAYS=365

# Disk-pressure guard (NAN-5446). Fractions of the ClickHouse data disk; on a
# single host that is the whole Docker filesystem, shared with PostgreSQL and
# the Vector disk buffers. From the high watermark the oldest daily partitions
# are dropped until usage is back at the low watermark. Ingestion pauses at the
# pause threshold (the ingest edge answers 503 + Retry-After, senders retry)
# and resumes by itself once usage is back under the high watermark. Partitions
# younger than DISK_PRESSURE_MIN_RETENTION_DAYS are never dropped (NAN-5447).
# Unset, the floor is 7 days or one day less than the install holds, whichever
# is smaller; set it to enforce an exact floor.
# Uncomment to change a default.
# DISK_PRESSURE_CHECK_INTERVAL_SECS=60
# DISK_PRESSURE_HIGH_WATERMARK=0.80
# DISK_PRESSURE_LOW_WATERMARK=0.70
# DISK_PRESSURE_CRITICAL_THRESHOLD=0.90
# DISK_PRESSURE_EMERGENCY_THRESHOLD=0.95
# DISK_PRESSURE_PAUSE_INGESTION=true
# DISK_PRESSURE_PAUSE_THRESHOLD=0.92
# DISK_PRESSURE_MIN_RETENTION_DAYS=7

# Resource sizing is generated by install.sh on every install and rerun from
# the Docker host's CPU/RAM. To pin one value, add it after the installer-owned
# sizing block in .env; explicit assignments win. Common overrides include:
# CLICKHOUSE_MEM_LIMIT=8G
# CLICKHOUSE_MAX_THREADS=8
# POSTGRES_MAX_CONNECTIONS=300
# POSTGRES_SHARED_BUFFERS=1GB
# VECTOR_CLICKHOUSE_REQUEST_CONCURRENCY=4   # bounded to 6 by default sizing
# VECTOR_CLICKHOUSE_BUFFER_MAX_BYTES=4294967296
# VECTOR_MEM_LIMIT=4G
# NANO_API_MEM_LIMIT=2G

# Parser deploys wait for Vector to load the new config, then roll back if it
# never does. Once the reload signal is delivered they wait for Vector's
# verdict (a large config can take minutes to compile on a small host), up to
# the ceiling; otherwise the window is sized from the config's size. A
# rollback's reload gets only the window. Metrics unreadable for
# VECTOR_RELOAD_ACK_UNREADABLE_SECS ends the wait (Vector died). Seconds; 0 for
# the window disables the check (NAN-5298).
# VECTOR_RELOAD_ACK_TIMEOUT_SECS=45
# VECTOR_RELOAD_ACK_MAX_SECS=180
# VECTOR_RELOAD_ACK_UNREADABLE_SECS=60

# Pull-feed runner (NAN-4914; `docker compose --profile pull-feeds up -d connector-runner`).
# Vendor secrets are entered on the Pull feeds page and kept in Credentials.
CONNECTOR_POLL_INTERVAL_SECS=30
CONNECTOR_MEM_LIMIT=2G
