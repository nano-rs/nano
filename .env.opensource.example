# nano — open-source quickstart environment
#
# Copy to .env (or let install.sh generate one for you) and fill in the
# values marked CHANGE_ME. install.sh autogenerates the secret values via
# `openssl rand -hex 32` so you don't have to.

# Release image tag pulled from ghcr.io/nano-rs/*. REQUIRED: compose refuses to
# start without it (no `latest` fallback). Set it to a published release; as of
# NAN-4968, install.sh fills it from images.lock.
NANO_VERSION=

# Public URL users hit. Examples:
#   http://localhost       (default, single-host dev)
#   http://10.0.1.42       (LAN install)
#   https://nano.example   (production, layer in TLS via nginx overlay)
BASE_URL=http://localhost

# === Secrets — autogenerated by install.sh ===
# Database passwords (32-byte hex)
POSTGRES_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME
CLICKHOUSE_VECTOR_PASSWORD=CHANGE_ME

# JWT signing secret (32-byte hex)
JWT_SECRET=CHANGE_ME

# Application encryption key (32-byte hex, used for secret-at-rest encryption)
NANOSIEM_ENCRYPTION_KEY=CHANGE_ME

# Vector HTTP ingestion auth token (clients send `Authorization: Bearer <token>`)
VECTOR_AUTH_TOKEN=CHANGE_ME

# === Optional ===
# Storage schema profile: ocsf | udm
#   ocsf — Open Cybersecurity Schema Framework 1.9 (vendor-neutral standard).
#          Default for new installs (NAN-4903); parsers and rules follow the
#          `main` content channel.
#   udm  — nano's legacy native schema (CIM-style, short field names). Kept for
#          existing installs; its content stays on the `legacy/clickhouse` branch.
# Chosen at first install and IMMUTABLE afterward — it selects the ClickHouse
# tables, parsers, and field universe the whole stack runs against, so changing
# it after ingest would point search/detection at a different, empty table.
# Keep this line: compose falls back to `udm` when the key is ABSENT, because an
# .env without it predates the profile choice (those installs hold UDM data).
NANO_SCHEMA_PROFILE=ocsf
NANO_FUTURE_TIMESTAMP_SKEW_SECONDS=86400

# Log verbosity for Rust services: error | warn | info | debug | trace
RUST_LOG=info

# Resource sizing is generated by install.sh on every install and rerun from
# the Docker host's CPU/RAM. To pin one value, add it after the installer-owned
# sizing block in .env; explicit assignments win. Common overrides include:
# CLICKHOUSE_MEM_LIMIT=8G
# CLICKHOUSE_MAX_THREADS=8
# POSTGRES_MAX_CONNECTIONS=300
# POSTGRES_SHARED_BUFFERS=1GB
# VECTOR_CLICKHOUSE_REQUEST_CONCURRENCY=4   # bounded to 6 by default sizing
# VECTOR_CLICKHOUSE_BUFFER_MAX_BYTES=4294967296
# VECTOR_MEM_LIMIT=4G
# NANO_API_MEM_LIMIT=2G

# Pull-feed runner (NAN-4914; `docker compose --profile pull-feeds up -d connector-runner`).
# Vendor secrets are entered on the Pull feeds page and kept in Credentials.
CONNECTOR_POLL_INTERVAL_SECS=30
CONNECTOR_MEM_LIMIT=2G
