# NanoSIEM Backend Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# PostgreSQL connection URL (required)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://nanosiem:nanosiem@localhost:5432/nanosiem

# PostgreSQL connection pool settings (optional)
PG_MAX_CONNECTIONS=10
PG_CONNECT_TIMEOUT=30

# =============================================================================
# ClickHouse Configuration
# =============================================================================
# ClickHouse HTTP interface URL (required for log storage)
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse database name (default: nanosiem)
CLICKHOUSE_DATABASE=nanosiem

# ClickHouse authentication (default: nanosiem/nanosiem)
CLICKHOUSE_USER=nanosiem
CLICKHOUSE_PASSWORD=nanosiem

# ClickHouse connection pool settings (optional)
CH_MAX_CONNECTIONS=10
CH_CONNECT_TIMEOUT=30

# =============================================================================
# API Server Configuration
# =============================================================================
# Host to bind the API server (default: 0.0.0.0)
API_HOST=0.0.0.0

# Port for the API server (default: 3000)
API_PORT=3000

# CORS allowed origins (comma-separated)
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-domain.com (NO wildcards like https://*.domain.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Authentication Configuration
# =============================================================================
# Enable authentication for all services (default: true)
# Set to false to disable auth (development only!)
AUTH_ENABLED=true

# JWT secret for token signing (REQUIRED in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production

# Encryption key for sensitive data in database (e.g., cloud credentials)
# Generate with: openssl rand -hex 32
NANOSIEM_ENCRYPTION_KEY=29131984fc00b782da58a3dfed607c3394506e9d11d01264719d91ec2fa8f7fd

# API key for service-to-service authentication (e.g., Vector -> Ingest)
# Create API keys via the Settings > API Keys UI after initial setup
# API_KEY=your-api-key-here

# =============================================================================
# Vector Ingestion Configuration
# =============================================================================
# Authentication token for Vector HTTP ingestion endpoint
VECTOR_AUTH_TOKEN=nanosiem-default-token

# Note: Vector now writes directly to ClickHouse (no intermediate ingest service)
# Configure Vector ClickHouse sink using the CLICKHOUSE_* variables above

# =============================================================================
# AI Provider Configuration (meloD multi-provider support)
# =============================================================================
# NanoSIEM supports multiple AI providers through LiteLLM proxy.
# Configure providers via Settings > AI Providers in the UI.
# API keys are stored encrypted in the database, not in environment variables.

# LiteLLM Proxy Configuration
# Master key for LiteLLM proxy authentication (REQUIRED in production)
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-nanosiem-litellm-dev-key

# LiteLLM proxy URL (set automatically in Docker, override for custom setups)
# LITELLM_PROXY_URL=http://litellm:4000

# LiteLLM logging level (DEBUG, INFO, WARNING, ERROR)
# LITELLM_LOG=INFO

# =============================================================================
# AWS Bedrock Configuration (Legacy/Fallback)
# =============================================================================
# These settings are used as fallback when LiteLLM is not available,
# or when Bedrock is configured as a provider in the UI.

# AWS region for Bedrock (default: us-east-1)
# AWS_REGION=us-east-1

# AWS credentials (use IAM roles in production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock model ID (default: anthropic.claude-3-sonnet-20240229-v1:0)
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =============================================================================
# Microservices Configuration (Optional - DEPRECATED)
# =============================================================================
# Note: The ingest service has been deprecated in favor of direct ClickHouse ingestion.
# Vector now writes directly to ClickHouse.
# The search service remains optional for distributed deployments.

# Search Service health endpoint (default: http://search:3002/health)
# SEARCH_SERVICE_URL=http://localhost:3002/health
