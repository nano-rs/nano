//! Settings endpoint handlers
//!
//! Implements:
//! - GET /api/settings/melod - Get current meloD config (without secrets)
//! - PUT /api/settings/melod - Update meloD config
//! - PUT /api/settings/melod/credentials - Update credentials
//! - POST /api/settings/melod/validate - Test connection
//! - GET /api/settings/melod/status - Get connection status
//! - GET /api/settings/risk - Get current risk weight
//! - PUT /api/settings/risk - Update risk weight
//! - GET /api/settings/nrt - Get NRT engine settings
//! - PUT /api/settings/nrt - Update NRT engine settings
//!
//! Requirements: 10.1, 10.2, 10.4, 9.1, 9.4, 8.2

use axum::{extract::{Path, State}, Extension, Json};
use nanosiem_core::melod::{
    AiProvider, AuthMethod, ConnectionStatus, CredentialsSource, MelodCredentials, MelodSettings, SettingsError,
};
use nanosiem_core::auth::permissions;
use nanosiem_core::crypto::EncryptionService;
use serde::{Deserialize, Serialize};
use sqlx::PgPool;
use utoipa::ToSchema;

use crate::{error::ApiError, state::AppState};
use crate::middleware::{AuthContext, check_permission};

// ============================================================================
// Request/Response Types
// ============================================================================

/// Response for meloD configuration (without secrets)
#[derive(Debug, Serialize, ToSchema)]
pub struct MelodConfigResponse {
    pub enabled: bool,
    pub provider: String,
    pub aws_region: String,
    pub model_id: String,
    pub max_tokens: u32,
    pub temperature: f32,
    pub requests_per_minute: u32,
    pub has_credentials: bool,
    pub credentials_source: Option<String>,
    /// Which auth method is configured: "bedrock_api_key" or "iam_credentials"
    pub auth_method: Option<String>,
}

/// Request to update meloD configuration
#[derive(Debug, Deserialize, ToSchema)]
pub struct UpdateMelodConfigRequest {
    pub enabled: Option<bool>,
    pub aws_region: Option<String>,
    pub model_id: Option<String>,
    pub max_tokens: Option<u32>,
    pub temperature: Option<f32>,
    pub requests_per_minute: Option<u32>,
}

/// Request to update credentials
#[derive(Debug, Deserialize, ToSchema)]
pub struct UpdateCredentialsRequest {
    /// Authentication method: "bedrock_api_key" or "iam_credentials"
    pub auth_method: String,
    /// Bedrock API Key (bearer token) - required when auth_method is "bedrock_api_key"
    pub bedrock_api_key: Option<String>,
    /// AWS Access Key ID - required when auth_method is "iam_credentials"
    pub aws_access_key_id: Option<String>,
    /// AWS Secret Access Key - required when auth_method is "iam_credentials"
    pub aws_secret_access_key: Option<String>,
}

/// Response for connection status
#[derive(Debug, Serialize, ToSchema)]
pub struct ConnectionStatusResponse {
    pub connected: bool,
    pub model_available: bool,
    pub last_checked: Option<String>,
    pub error: Option<String>,
}

impl From<ConnectionStatus> for ConnectionStatusResponse {
    fn from(status: ConnectionStatus) -> Self {
        Self {
            connected: status.connected,
            model_available: status.model_available,
            last_checked: status.last_checked.map(|t| t.to_rfc3339()),
            error: status.error,
        }
    }
}

// ============================================================================
// Error Conversion
// ============================================================================

impl From<SettingsError> for ApiError {
    fn from(err: SettingsError) -> Self {
        match &err {
            SettingsError::InvalidConfig(msg) => ApiError::ValidationError(msg.clone()),
            SettingsError::ConnectionValidation(msg) => {
                ApiError::BadRequest(format!("Connection validation failed: {}", msg))
            }
            _ => ApiError::InternalError(err.to_string()),
        }
    }
}

// ============================================================================
// Handler Functions
// ============================================================================

/// Get meloD configuration
///
/// GET /api/settings/melod
///
/// Returns the current meloD configuration without exposing secrets.
///
/// Requirements: 10.1
#[utoipa::path(
    get,
    path = "/api/settings/melod",
    tag = "settings",
    responses(
        (status = 200, description = "Current meloD configuration", body = MelodConfigResponse),
        (status = 403, description = "Missing permission", body = ApiError),
        (status = 500, description = "Internal server error", body = ApiError)
    ),
    security(("bearer_auth" = []), ("api_key" = []))
)]
pub async fn get_melod_config(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<MelodConfigResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_AI)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:ai".to_string()))?;

    let settings = MelodSettings::from_env(state.pool.clone())?;

    let config = settings.get_config().await?;
    let credentials_source = settings.get_credentials_source().await?;
    let credentials = settings.get_effective_credentials().await?;

    let provider = match config.provider {
        AiProvider::AwsBedrock => "aws_bedrock".to_string(),
    };

    let credentials_source_str = credentials_source.map(|s| match s {
        CredentialsSource::Database => "database".to_string(),
        CredentialsSource::Environment => "environment".to_string(),
    });

    let auth_method_str = credentials.map(|c| match c.auth_method {
        AuthMethod::BedrockApiKey => "bedrock_api_key".to_string(),
        AuthMethod::IamCredentials => "iam_credentials".to_string(),
    });

    Ok(Json(MelodConfigResponse {
        enabled: config.enabled,
        provider,
        aws_region: config.aws_region,
        model_id: config.model_id,
        max_tokens: config.max_tokens,
        temperature: config.temperature,
        requests_per_minute: config.requests_per_minute,
        has_credentials: credentials_source.is_some(),
        credentials_source: credentials_source_str,
        auth_method: auth_method_str,
    }))
}

/// Update meloD configuration
///
/// PUT /api/settings/melod
///
/// Updates the meloD configuration. Only provided fields are updated.
/// Automatically reloads the meloD service when configuration changes.
///
/// Requirements: 10.2
#[utoipa::path(
    put,
    path = "/api/settings/melod",
    tag = "settings",
    request_body = UpdateMelodConfigRequest,
    responses(
        (status = 200, description = "Configuration updated", body = MelodConfigResponse),
        (status = 403, description = "Missing permission", body = ApiError),
        (status = 500, description = "Internal server error", body = ApiError)
    ),
    security(("bearer_auth" = []), ("api_key" = []))
)]
pub async fn update_melod_config(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
    Json(request): Json<UpdateMelodConfigRequest>,
) -> Result<Json<MelodConfigResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_AI)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:ai".to_string()))?;
    
    let settings = MelodSettings::from_env(state.pool.clone())?;

    // Get current config
    let mut config = settings.get_config().await?;
    let was_enabled = config.enabled;

    // Apply updates
    if let Some(enabled) = request.enabled {
        config.enabled = enabled;
    }
    if let Some(aws_region) = request.aws_region {
        config.aws_region = aws_region;
    }
    if let Some(model_id) = request.model_id {
        config.model_id = model_id;
    }
    if let Some(max_tokens) = request.max_tokens {
        config.max_tokens = max_tokens;
    }
    if let Some(temperature) = request.temperature {
        config.temperature = temperature;
    }
    if let Some(requests_per_minute) = request.requests_per_minute {
        config.requests_per_minute = requests_per_minute;
    }

    // Save updated config
    settings.update_config(config.clone()).await?;

    // Reload meloD service if enabled state changed or config was updated while enabled
    if config.enabled != was_enabled || config.enabled {
        match state.reload_melod_service().await {
            Ok(true) => {
                tracing::info!("meloD service reloaded after config update");
            }
            Ok(false) => {
                tracing::debug!("meloD service not loaded (disabled or no credentials)");
            }
            Err(e) => {
                tracing::warn!("Failed to reload meloD service: {}", e);
            }
        }
    }

    let credentials_source = settings.get_credentials_source().await?;
    let credentials = settings.get_effective_credentials().await?;

    let provider = match config.provider {
        AiProvider::AwsBedrock => "aws_bedrock".to_string(),
    };

    let credentials_source_str = credentials_source.map(|s| match s {
        CredentialsSource::Database => "database".to_string(),
        CredentialsSource::Environment => "environment".to_string(),
    });

    let auth_method_str = credentials.map(|c| match c.auth_method {
        AuthMethod::BedrockApiKey => "bedrock_api_key".to_string(),
        AuthMethod::IamCredentials => "iam_credentials".to_string(),
    });

    Ok(Json(MelodConfigResponse {
        enabled: config.enabled,
        provider,
        aws_region: config.aws_region,
        model_id: config.model_id,
        max_tokens: config.max_tokens,
        temperature: config.temperature,
        requests_per_minute: config.requests_per_minute,
        has_credentials: credentials_source.is_some(),
        credentials_source: credentials_source_str,
        auth_method: auth_method_str,
    }))
}

/// Update meloD credentials
///
/// PUT /api/settings/melod/credentials
///
/// Updates the AWS credentials for Bedrock access.
/// Supports both Bedrock API Key (bearer token) and IAM credentials.
/// Credentials are encrypted before storage.
///
/// Requirements: 10.2, 10.8
#[utoipa::path(
    put,
    path = "/api/settings/melod/credentials",
    tag = "settings",
    request_body = UpdateCredentialsRequest,
    responses(
        (status = 200, description = "Credentials updated successfully", body = serde_json::Value),
        (status = 400, description = "Invalid credentials", body = ApiError),
        (status = 403, description = "Missing permission", body = ApiError),
        (status = 500, description = "Internal server error", body = ApiError)
    ),
    security(("bearer_auth" = []), ("api_key" = []))
)]
pub async fn update_melod_credentials(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
    Json(request): Json<UpdateCredentialsRequest>,
) -> Result<Json<serde_json::Value>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_AI)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:ai".to_string()))?;
    
    let settings = MelodSettings::from_env(state.pool.clone())?;

    let credentials = match request.auth_method.as_str() {
        "bedrock_api_key" => {
            let api_key = request.bedrock_api_key.ok_or_else(|| {
                ApiError::ValidationError("bedrock_api_key is required for this auth method".to_string())
            })?;
            MelodCredentials {
                auth_method: AuthMethod::BedrockApiKey,
                bedrock_api_key: Some(api_key),
                aws_access_key_id: None,
                aws_secret_access_key: None,
            }
        }
        "iam_credentials" => {
            let access_key = request.aws_access_key_id.ok_or_else(|| {
                ApiError::ValidationError("aws_access_key_id is required for this auth method".to_string())
            })?;
            let secret_key = request.aws_secret_access_key.ok_or_else(|| {
                ApiError::ValidationError("aws_secret_access_key is required for this auth method".to_string())
            })?;
            MelodCredentials {
                auth_method: AuthMethod::IamCredentials,
                bedrock_api_key: None,
                aws_access_key_id: Some(access_key),
                aws_secret_access_key: Some(secret_key),
            }
        }
        _ => {
            return Err(ApiError::ValidationError(
                "auth_method must be 'bedrock_api_key' or 'iam_credentials'".to_string()
            ));
        }
    };

    settings.update_credentials(credentials).await?;

    Ok(Json(serde_json::json!({
        "success": true,
        "message": "Credentials updated successfully"
    })))
}

/// Validate meloD connection
///
/// POST /api/settings/melod/validate
///
/// Tests the connection to AWS Bedrock using the stored credentials.
/// Updates and returns the connection status.
/// If connection is successful, automatically enables meloD and reloads the service.
///
/// Requirements: 10.4, 10.5, 10.6
#[utoipa::path(
    post,
    path = "/api/settings/melod/validate",
    tag = "settings",
    responses(
        (status = 200, description = "Connection validation result", body = ConnectionStatusResponse),
        (status = 403, description = "Missing permission", body = ApiError),
        (status = 500, description = "Validation failed", body = ApiError)
    ),
    security(("bearer_auth" = []), ("api_key" = []))
)]
pub async fn validate_melod_connection(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<ConnectionStatusResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_AI)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:ai".to_string()))?;
    
    let settings = MelodSettings::from_env(state.pool.clone())?;

    let status = settings.validate_connection().await?;

    // Auto-enable meloD and reload service if connection is successful
    if status.connected && status.model_available {
        let mut config = settings.get_config().await?;
        if !config.enabled {
            config.enabled = true;
            if let Err(e) = settings.update_config(config).await {
                tracing::warn!("Failed to auto-enable meloD after successful connection: {}", e);
            } else {
                tracing::info!("meloD auto-enabled after successful connection validation");
            }
        }
        
        // Reload the meloD service so it's immediately available
        match state.reload_melod_service().await {
            Ok(true) => {
                tracing::info!("meloD service reloaded after successful connection validation");
            }
            Ok(false) => {
                tracing::warn!("meloD service could not be loaded after validation");
            }
            Err(e) => {
                tracing::warn!("Failed to reload meloD service: {}", e);
            }
        }
    }

    Ok(Json(ConnectionStatusResponse::from(status)))
}

/// Get meloD connection status
///
/// GET /api/settings/melod/status
///
/// Returns the current connection status. Checks LiteLLM if configured,
/// otherwise falls back to legacy Bedrock status.
///
/// Requirements: 10.4
#[utoipa::path(
    get,
    path = "/api/settings/melod/status",
    tag = "settings",
    responses(
        (status = 200, description = "Connection status", body = ConnectionStatusResponse),
        (status = 403, description = "Missing permission", body = ApiError),
        (status = 500, description = "Internal server error", body = ApiError)
    ),
    security(("bearer_auth" = []), ("api_key" = []))
)]
pub async fn get_melod_status(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<ConnectionStatusResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_VIEW)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:view".to_string()))?;

    // Check if we're using LiteLLM mode (new multi-provider system)
    let litellm_proxy_url = std::env::var("LITELLM_PROXY_URL").ok();

    if let Some(proxy_url) = litellm_proxy_url {
        // LiteLLM mode - check provider status
        // Check if any providers are enabled with credentials
        let enabled_count: i64 = sqlx::query_scalar(
            "SELECT COUNT(*) FROM provider_credentials WHERE enabled = true AND credentials_encrypted IS NOT NULL"
        )
        .fetch_one(&state.pool)
        .await
        .unwrap_or(0);

        if enabled_count == 0 {
            return Ok(Json(ConnectionStatusResponse {
                connected: false,
                model_available: false,
                last_checked: Some(chrono::Utc::now().to_rfc3339()),
                error: Some("No AI providers configured. Enable a provider in Settings > AI Providers.".to_string()),
            }));
        }

        // Check if LiteLLM proxy is reachable and has models
        let sync_guard = state.litellm_sync.read().await;
        if let Some(ref sync_service) = *sync_guard {
            // Check proxy health
            match sync_service.validate_proxy_connection().await {
                Ok(true) => {
                    // Check if models are registered
                    match sync_service.get_registered_models().await {
                        Ok(models) if !models.is_empty() => {
                            return Ok(Json(ConnectionStatusResponse {
                                connected: true,
                                model_available: true,
                                last_checked: Some(chrono::Utc::now().to_rfc3339()),
                                error: None,
                            }));
                        }
                        Ok(_) => {
                            return Ok(Json(ConnectionStatusResponse {
                                connected: true,
                                model_available: false,
                                last_checked: Some(chrono::Utc::now().to_rfc3339()),
                                error: Some("LiteLLM connected but no models registered. Validate your provider credentials.".to_string()),
                            }));
                        }
                        Err(e) => {
                            return Ok(Json(ConnectionStatusResponse {
                                connected: true,
                                model_available: false,
                                last_checked: Some(chrono::Utc::now().to_rfc3339()),
                                error: Some(format!("Failed to query models: {}", e)),
                            }));
                        }
                    }
                }
                Ok(false) | Err(_) => {
                    return Ok(Json(ConnectionStatusResponse {
                        connected: false,
                        model_available: false,
                        last_checked: Some(chrono::Utc::now().to_rfc3339()),
                        error: Some(format!("Cannot reach LiteLLM proxy at {}", proxy_url)),
                    }));
                }
            }
        } else {
            // LiteLLM sync service not initialized - need to reload
            return Ok(Json(ConnectionStatusResponse {
                connected: false,
                model_available: false,
                last_checked: Some(chrono::Utc::now().to_rfc3339()),
                error: Some("AI service not initialized. Try restarting the API or validating a provider.".to_string()),
            }));
        }
    }

    // Legacy Bedrock-only mode
    let settings = MelodSettings::from_env(state.pool.clone())?;
    let status = settings.get_connection_status().await?;
    Ok(Json(ConnectionStatusResponse::from(status)))
}


// ============================================================================
// Retention Settings
// ============================================================================

use nanosiem_core::settings::{
    ClickHouseStorageStats, DualSystemSettings, RetentionConfig, RetentionError, SystemSettings,
    StorageStats,
};

/// Response for retention configuration
#[derive(Debug, Serialize, ToSchema)]
pub struct RetentionConfigResponse {
    pub enabled: bool,
    pub retention_days: u32,
    pub job_id: Option<i32>,
}

impl From<RetentionConfig> for RetentionConfigResponse {
    fn from(config: RetentionConfig) -> Self {
        Self {
            enabled: config.enabled,
            retention_days: config.retention_days,
            job_id: config.job_id,
        }
    }
}

/// Request to update retention configuration
#[derive(Debug, Deserialize)]
pub struct UpdateRetentionRequest {
    pub enabled: bool,
    pub retention_days: u32,
}

/// Response for storage statistics
#[derive(Debug, Serialize)]
pub struct StorageStatsResponse {
    pub total_size_bytes: i64,
    pub total_size_pretty: String,
    pub chunk_count: i64,
    pub compressed_chunks: i64,
    pub oldest_log: Option<String>,
    pub newest_log: Option<String>,
    pub log_count: i64,
}

impl From<StorageStats> for StorageStatsResponse {
    fn from(stats: StorageStats) -> Self {
        Self {
            total_size_bytes: stats.total_size_bytes,
            total_size_pretty: stats.total_size_pretty,
            chunk_count: stats.chunk_count,
            compressed_chunks: stats.compressed_chunks,
            oldest_log: stats.oldest_log.map(|t| t.to_rfc3339()),
            newest_log: stats.newest_log.map(|t| t.to_rfc3339()),
            log_count: stats.log_count,
        }
    }
}

/// Response for ClickHouse storage statistics
#[derive(Debug, Serialize)]
pub struct ClickHouseStorageStatsResponse {
    pub total_size_bytes: u64,
    pub total_size_pretty: String,
    pub row_count: u64,
    pub partition_count: u64,
    pub parts_count: u64,
    pub oldest_log: Option<String>,
    pub newest_log: Option<String>,
    pub compression_ratio: f64,
    pub uncompressed_size_bytes: u64,
    pub ttl_days: Option<u32>,
}

impl From<ClickHouseStorageStats> for ClickHouseStorageStatsResponse {
    fn from(stats: ClickHouseStorageStats) -> Self {
        Self {
            total_size_bytes: stats.total_size_bytes,
            total_size_pretty: stats.total_size_pretty,
            row_count: stats.row_count,
            partition_count: stats.partition_count,
            parts_count: stats.parts_count,
            oldest_log: stats.oldest_log.map(|t| t.to_rfc3339()),
            newest_log: stats.newest_log.map(|t| t.to_rfc3339()),
            compression_ratio: stats.compression_ratio,
            uncompressed_size_bytes: stats.uncompressed_size_bytes,
            ttl_days: stats.ttl_days,
        }
    }
}

/// Combined storage overview response
#[derive(Debug, Serialize)]
pub struct StorageOverviewResponse {
    /// Whether ClickHouse is enabled for log storage
    pub clickhouse_enabled: bool,
    /// PostgreSQL storage stats (metadata)
    pub postgres: Option<StorageStatsResponse>,
    /// ClickHouse storage stats (logs)
    pub clickhouse: Option<ClickHouseStorageStatsResponse>,
}

/// Request to update ClickHouse retention
#[derive(Debug, Deserialize)]
pub struct UpdateClickHouseRetentionRequest {
    pub retention_days: u32,
}

impl From<RetentionError> for ApiError {
    fn from(err: RetentionError) -> Self {
        match &err {
            RetentionError::InvalidPeriod(msg) => ApiError::ValidationError(msg.clone()),
            RetentionError::Config(msg) => ApiError::InternalError(msg.clone()),
            RetentionError::ClickHouse(msg) => ApiError::InternalError(msg.clone()),
            RetentionError::Database(e) => ApiError::InternalError(e.to_string()),
        }
    }
}

/// Get retention configuration
///
/// GET /api/settings/retention
pub async fn get_retention_config(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<RetentionConfigResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_RETENTION)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:retention".to_string()))?;
    
    let settings = SystemSettings::new(state.pool.clone());
    let config = settings.get_retention_config().await?;
    Ok(Json(RetentionConfigResponse::from(config)))
}

/// Update retention configuration
///
/// PUT /api/settings/retention
pub async fn update_retention_config(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
    Json(request): Json<UpdateRetentionRequest>,
) -> Result<Json<RetentionConfigResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_RETENTION)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:retention".to_string()))?;
    
    let settings = SystemSettings::new(state.pool.clone());
    
    let config = RetentionConfig {
        enabled: request.enabled,
        retention_days: request.retention_days,
        job_id: None,
    };
    
    let updated = settings.update_retention_config(config).await?;
    Ok(Json(RetentionConfigResponse::from(updated)))
}

/// Get storage statistics
///
/// GET /api/settings/storage
pub async fn get_storage_stats(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<StorageStatsResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_VIEW)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:view".to_string()))?;
    
    let settings = SystemSettings::new(state.pool.clone());
    let stats = settings.get_storage_stats().await?;
    Ok(Json(StorageStatsResponse::from(stats)))
}

/// Run retention now (manually drop old chunks)
///
/// POST /api/settings/retention/run
pub async fn run_retention_now(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<serde_json::Value>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_RETENTION)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:retention".to_string()))?;
    
    let settings = SystemSettings::new(state.pool.clone());
    let dropped = settings.run_retention_now().await?;
    
    Ok(Json(serde_json::json!({
        "success": true,
        "chunks_dropped": dropped
    })))
}


// ============================================================================
// Risk Settings
// ============================================================================

use nanosiem_core::detection::risk::RiskError;

/// Response for risk configuration
#[derive(Debug, Serialize)]
pub struct RiskConfigResponse {
    pub risk_weight: f64,
}

/// Request to update risk configuration
#[derive(Debug, Deserialize)]
pub struct UpdateRiskConfigRequest {
    pub risk_weight: f64,
}

/// Response for risk decay configuration
#[derive(Debug, Serialize)]
pub struct RiskDecayConfigResponse {
    pub decay_0_24h: f64,
    pub decay_1_3d: f64,
    pub decay_3_5d: f64,
    pub decay_5_7d: f64,
}

/// Request to update risk decay configuration
#[derive(Debug, Deserialize)]
pub struct UpdateRiskDecayConfigRequest {
    pub decay_0_24h: f64,
    pub decay_1_3d: f64,
    pub decay_3_5d: f64,
    pub decay_5_7d: f64,
}

impl From<RiskError> for ApiError {
    fn from(err: RiskError) -> Self {
        match &err {
            RiskError::WeightOutOfBounds(w) => {
                ApiError::ValidationError(format!("Risk weight {} is out of bounds (must be 0.0-1.0)", w))
            }
            RiskError::ScoreOutOfBounds(s) => {
                ApiError::ValidationError(format!("Risk score {} is out of bounds (must be 0-100)", s))
            }
            RiskError::InvalidCondition(msg) => {
                ApiError::ValidationError(format!("Invalid modifier condition: {}", msg))
            }
        }
    }
}

/// Get risk configuration
///
/// GET /api/settings/risk
///
/// Returns the current global risk weight multiplier.
///
/// Requirements: 9.1
pub async fn get_risk_config(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
) -> Result<Json<RiskConfigResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_RISK)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:risk".to_string()))?;
    
    let risk_weight = get_risk_weight_from_db(&state.pool).await?;
    Ok(Json(RiskConfigResponse { risk_weight }))
}

/// Update risk configuration
///
/// PUT /api/settings/risk
///
/// Updates the global risk weight multiplier (0.0-1.0).
/// The new weight is applied to all future signals immediately.
///
/// Requirements: 9.1, 9.4
pub async fn update_risk_config(
    State(state): State<AppState>,
    Extension(auth): Extension<AuthContext>,
    Json(request): Json<UpdateRiskConfigRequest>,
) -> Result<Json<RiskConfigResponse>, ApiError> {
    check_permission(&auth, permissions::SETTINGS_RISK)
        .map_err(|_| ApiError::Forbidden("Missing permission: settings:risk".to_string()))?;
    
    use nanosiem_core::detection::risk::ScoreCalculator;
    
    // Validate the weight is within bounds
    ScoreCalculator::validate_weight(request.risk_weight)?;
    
    // Update the risk_weight in the database
    update_risk_weight_in_db(&state.pool, request.risk_weight).await?;
    
    tracing::info!("Risk weight updated to {}", request.risk_weight);
    
    Ok(Json(RiskConfigResponse {
        risk_weight: request.risk_weight,
    }))
}

/// Helper function to get risk_weight from the database
async fn get_risk_weight_from_db(pool: &PgPool) -> Result<f64, ApiError> {
    let row: (sqlx::types::Decimal,) = sqlx::query_as(
        "SELECT risk_weight FROM system_settings WHERE id = 'default'"
    )
    .fetch_one(pool)
    .await
    .map_err(|e| ApiError::DatabaseError(e.to_string()))?;
    
    // Convert Decimal to f64
    let weight_str = row.0.to_string();
    let weight = weight_str.parse::<f64>().unwrap_or(1.0);
    Ok(weight)
}

/// Helper function to update risk_weight in the database
async fn update_risk_weight_in_db(pool: &PgPool, weight: f64) -> Result<(), ApiError> {
    use sqlx::types::Decimal;
    
    // Convert f64 to Decimal
    let decimal_weight = Decimal::try_from(weight)
        .unwrap_or_else(|_| Decimal::try_from(1.0).unwrap());
    
    sqlx::query(
        "UPDATE system_settings SET risk_weight = $1, updated_at = NOW() WHERE id = 'default'"
    )
    .bind(decimal_weight)
    .execute(pool)
    .await
    .map_err(|e| ApiError::DatabaseError(e.to_string()))?;
    
    Ok(())
}

