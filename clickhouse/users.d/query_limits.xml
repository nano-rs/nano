<?xml version="1.0"?>
<!--
  Query Limits and User Profiles for SIEM Workloads

  Profiles:
  - default: Standard analyst queries (dashboards, searches)
  - analytics: Long-running reports and threat hunting
  - realtime: NRT detection rules (fast, limited resources)
  - ingestion: Optimized for Vector/insert operations
  - ingest_direct: ingestion + bounded reads (nanosiem_ingest, NAN-5473)
  - search: interactive search identity (nanosiem_search, NAN-5470)
  - dict_source: dictionary source identity (nanosiem_dict, NAN-5470)

  These prevent resource exhaustion during incident investigations
  when multiple analysts run concurrent queries.
-->
<clickhouse>
    <!-- =======================================================================
         USER PROFILES
         ======================================================================= -->
    <profiles>
        <!-- =================================================================
             DEFAULT PROFILE
             Standard SIEM analyst queries: searches, dashboards, investigations
             ================================================================= -->
        <default>
            <!-- NAN-4906: CH 26.9 switched network compression to ZSTD, and the
                 HTTP compress=1 framing follows it (CH #119825). The clickhouse-rs
                 0.14 client only decodes LZ4, so keep the pre-26.9 wire format for
                 every profile. The services also pin it per client (dual_pool.rs). -->
            <network_compression_method>LZ4</network_compression_method>
            <!-- NAN-4903: never infer Date/DateTime from JSON strings. Inference is per
                 insert block, so one date-like vendor value retyped the whole path and
                 coerced the other rows ("1" became 2026-01-01) in event/unmapped/ext. -->
            <input_format_try_infer_dates>0</input_format_try_infer_dates>
            <input_format_try_infer_datetimes>0</input_format_try_infer_datetimes>
            <!-- Memory Limits -->
            <max_memory_usage>20000000000</max_memory_usage> <!-- 20GB per query -->
            <max_memory_usage_for_user>40000000000</max_memory_usage_for_user> <!-- 40GB per user session -->

            <!-- External processing when memory exceeded. NAN-4957: relative to the
                 box, not absolute. A 10 GB absolute threshold never triggers on a
                 4-8G compose box, so one heavy GROUP BY / ORDER BY grew until the
                 server limit and inserts failed with 241. 0 disables the absolute
                 threshold; the ratio spills once the query holds 30% of the memory
                 still available to the server at query start (measured on
                 26.10.3.7 at a 3.6 GiB limit, 40M-group groupArray GROUP BY:
                 1.75 GiB with the 10 GB absolute, 1.25 GiB at ratio 0.5, 772 MiB
                 at 0.25). Searches are also capped at 40% of the server limit by
                 the app (nanosiem-core db::clickhouse_transport::
                 query_memory_ceiling), which bounds aggregations that cannot
                 spill. -->
            <max_bytes_before_external_group_by>0</max_bytes_before_external_group_by>
            <max_bytes_ratio_before_external_group_by>0.3</max_bytes_ratio_before_external_group_by>
            <max_bytes_before_external_sort>0</max_bytes_before_external_sort>
            <max_bytes_ratio_before_external_sort>0.3</max_bytes_ratio_before_external_sort>

            <!-- Execution Time Limits -->
            <max_execution_time>300</max_execution_time> <!-- 5 minutes -->
            <timeout_before_checking_execution_speed>30</timeout_before_checking_execution_speed>

            <!-- Data Volume Limits -->
            <max_rows_to_read>1000000000</max_rows_to_read> <!-- 1 billion rows -->
            <max_bytes_to_read>100000000000</max_bytes_to_read> <!-- 100GB -->
            <max_result_rows>1000000</max_result_rows> <!-- 1M result rows -->
            <max_result_bytes>1000000000</max_result_bytes> <!-- 1GB result size -->

            <!-- Thread Settings -->
            <max_threads>16</max_threads>
            <max_insert_threads>8</max_insert_threads>
            <workload>interactive</workload>

            <!-- Queue Settings -->
            <queue_max_wait_ms>60000</queue_max_wait_ms> <!-- 60s wait in queue -->
            <priority>0</priority> <!-- Default priority -->

            <!-- Query Optimization (SIEM-specific) -->
            <optimize_move_to_prewhere>1</optimize_move_to_prewhere>
            <optimize_read_in_order>1</optimize_read_in_order>
            <read_in_order_two_level_merge_threshold>100</read_in_order_two_level_merge_threshold>
            <optimize_aggregation_in_order>1</optimize_aggregation_in_order>

            <!-- Index Usage -->
            <force_index_by_date>0</force_index_by_date>
            <force_primary_key>0</force_primary_key>
            <use_skip_indexes>1</use_skip_indexes>

            <!-- ClickHouse 25.3+ Query Condition Cache
                 Caches which granules match WHERE conditions - huge win for
                 repeated dashboard/alert queries with same filters -->
            <use_query_condition_cache>1</use_query_condition_cache>

            <!-- ClickHouse 25.12+ Top-N Query Optimizations
                 Speeds up ORDER BY ... LIMIT queries significantly -->
            <use_skip_indexes_for_top_k>1</use_skip_indexes_for_top_k>

            <!-- ClickHouse 25.12+ Lazy Reading Optimization
                 75x faster for large LIMIT queries -->
            <query_plan_max_limit_for_lazy_materialization>10000</query_plan_max_limit_for_lazy_materialization>

            <!-- Join Settings -->
            <join_algorithm>auto</join_algorithm>
            <partial_merge_join_optimizations>1</partial_merge_join_optimizations>
            <join_overflow_mode>throw</join_overflow_mode>

            <!-- Async Insert (for application inserts) — durability ACK
                 (NAN-1406): wait_for_async_insert=1 makes the insert response
                 wait for the flush result, so a flush failure (FAILED dict ->
                 MATERIALIZED dictGet throw, NAN-1404) is a visible, retryable
                 error instead of a silently discarded pre-ACKed batch.
                 Measured: zero throughput cost at 5k eps; sustained-overload
                 shedding unchanged (Vector's drop_newest sheds either way,
                 now visibly). -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_max_data_size>104857600</async_insert_max_data_size>

            <!-- Async-insert flush window — adaptive batching (NAN-1478).
                 With no explicit busy-timeout, async_insert falls back to
                 ClickHouse's ~50–200ms default flush, and every flush emits one
                 part per materialized-view target. A single logs insert fans out
                 to ~14 prevalence/aggregation MV parts, so a sub-second flush is a
                 part storm that saturates the BackgroundSchedulePool and stalls
                 merge-selection (the failure mode behind the Saturn part-backlog
                 incident; managed tenants run the same window via nano-main
                 k8s-manifests/clickhouse.ts). Adaptive 2s–10s shrinks toward the
                 2s floor under sustained insert pressure (bounding the part rate)
                 and only grows toward 10s when ingest is light. The in-flight
                 buffer is still capped by async_insert_max_data_size above, so a
                 wider window adds no memory cost. Inserts only — analyst SELECTs
                 are unaffected. -->
            <async_insert_use_adaptive_busy_timeout>1</async_insert_use_adaptive_busy_timeout>
            <async_insert_busy_timeout_min_ms>2000</async_insert_busy_timeout_min_ms>
            <async_insert_busy_timeout_max_ms>10000</async_insert_busy_timeout_max_ms>

            <!-- Result Formatting -->
            <output_format_pretty_max_rows>10000</output_format_pretty_max_rows>

            <!-- Security -->
            <readonly>0</readonly>
            <!-- allow_ddl=1 matches the managed-SaaS nanosiem profile
                 (nano-main k8s-manifests/clickhouse.ts). The `nanosiem` user is
                 BOTH the analyst-query user and the app/sync user; system
                 operations like the IPinfo Lite sync's generational cleanup
                 (`ALTER TABLE ip_enrichments DELETE …`, a mutation = DDL) require
                 it. allow_ddl=0 here made open-edition/dev stricter than prod and
                 broke the sync with Code 392 (NAN-1314). Analyst queries are
                 still gated SELECT-only at the API layer; the nanosiem CH
                 password is not exposed to analysts. -->
            <allow_ddl>1</allow_ddl>

            <!-- Distributed Query Settings -->
            <distributed_product_mode>allow</distributed_product_mode>
            <distributed_aggregation_memory_efficient>1</distributed_aggregation_memory_efficient>

            <!-- Logging -->
            <log_queries>1</log_queries>
            <log_query_threads>0</log_query_threads>

            <!-- Disable profiling - prevents trace_log bloat and CPU spikes -->
            <memory_profiler_step>0</memory_profiler_step>
            <memory_profiler_sample_probability>0</memory_profiler_sample_probability>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
            <trace_profile_events>0</trace_profile_events>

            <!-- Enable full-text index support (required for tokenbf_v1 indexes in CH 25.12+) -->
            <enable_full_text_index>1</enable_full_text_index>
        </default>

        <!-- =================================================================
             ANALYTICS PROFILE
             Long-running threat hunting, reports, and forensic analysis
             ================================================================= -->
        <analytics>
            <network_compression_method>LZ4</network_compression_method>
            <!-- NAN-4903: never infer Date/DateTime from JSON strings. Inference is per
                 insert block, so one date-like vendor value retyped the whole path and
                 coerced the other rows ("1" became 2026-01-01) in event/unmapped/ext. -->
            <input_format_try_infer_dates>0</input_format_try_infer_dates>
            <input_format_try_infer_datetimes>0</input_format_try_infer_datetimes>
            <!-- Extended limits for deep analysis -->
            <max_execution_time>3600</max_execution_time> <!-- 1 hour -->
            <max_memory_usage>50000000000</max_memory_usage> <!-- 50GB -->
            <max_memory_usage_for_user>80000000000</max_memory_usage_for_user> <!-- 80GB -->

            <!-- Allow reading more data -->
            <max_rows_to_read>10000000000</max_rows_to_read> <!-- 10 billion rows -->
            <max_bytes_to_read>500000000000</max_bytes_to_read> <!-- 500GB -->
            <max_result_rows>10000000</max_result_rows> <!-- 10M result rows -->

            <!-- More threads for parallel processing -->
            <max_threads>32</max_threads>
            <workload>background</workload>

            <!-- Lower priority than realtime queries -->
            <priority>5</priority>

            <!-- External processing for large aggregations -->
            <max_bytes_before_external_group_by>20000000000</max_bytes_before_external_group_by> <!-- 20GB -->
            <max_bytes_before_external_sort>20000000000</max_bytes_before_external_sort>

            <!-- Logging -->
            <log_queries>1</log_queries>
            <log_query_threads>1</log_query_threads>

            <!-- Disable profiling -->
            <memory_profiler_step>0</memory_profiler_step>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
        </analytics>

        <!-- =================================================================
             REALTIME PROFILE
             NRT detection rules - must be fast and predictable
             ================================================================= -->
        <realtime>
            <network_compression_method>LZ4</network_compression_method>
            <!-- NAN-4903: never infer Date/DateTime from JSON strings. Inference is per
                 insert block, so one date-like vendor value retyped the whole path and
                 coerced the other rows ("1" became 2026-01-01) in event/unmapped/ext. -->
            <input_format_try_infer_dates>0</input_format_try_infer_dates>
            <input_format_try_infer_datetimes>0</input_format_try_infer_datetimes>
            <!-- Strict time limits for detection latency -->
            <max_execution_time>30</max_execution_time> <!-- 30 seconds max -->
            <timeout_before_checking_execution_speed>5</timeout_before_checking_execution_speed>

            <!-- Limited memory to prevent impact on other queries -->
            <max_memory_usage>5000000000</max_memory_usage> <!-- 5GB -->
            <max_memory_usage_for_user>10000000000</max_memory_usage_for_user> <!-- 10GB -->

            <!-- Limited data volume -->
            <max_rows_to_read>100000000</max_rows_to_read> <!-- 100M rows -->
            <max_bytes_to_read>10000000000</max_bytes_to_read> <!-- 10GB -->
            <max_result_rows>100000</max_result_rows> <!-- 100K results -->

            <!-- Fewer threads to leave resources for other queries -->
            <max_threads>8</max_threads>
            <workload>interactive</workload>

            <!-- Highest priority in queue -->
            <priority>1</priority>
            <queue_max_wait_ms>5000</queue_max_wait_ms> <!-- 5s max wait -->

            <!-- Optimization for time-series queries -->
            <optimize_read_in_order>1</optimize_read_in_order>
            <read_in_order_two_level_merge_threshold>10</read_in_order_two_level_merge_threshold>

            <!-- ClickHouse 25.3+ Query Condition Cache - Critical for NRT rules
                 that run the same time-window filters repeatedly -->
            <use_query_condition_cache>1</use_query_condition_cache>
            <use_skip_indexes_for_top_k>1</use_skip_indexes_for_top_k>

            <!-- Logging -->
            <log_queries>1</log_queries>

            <!-- Disable profiling -->
            <memory_profiler_step>0</memory_profiler_step>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
        </realtime>

        <!-- =================================================================
             INGESTION PROFILE
             Optimized for Vector and bulk data loading
             ================================================================= -->
        <ingestion>
            <network_compression_method>LZ4</network_compression_method>
            <!-- NAN-4903: never infer Date/DateTime from JSON strings. Inference is per
                 insert block, so one date-like vendor value retyped the whole path and
                 coerced the other rows ("1" became 2026-01-01) in event/unmapped/ext. -->
            <input_format_try_infer_dates>0</input_format_try_infer_dates>
            <input_format_try_infer_datetimes>0</input_format_try_infer_datetimes>
            <!-- No time limit for ingestion -->
            <max_execution_time>0</max_execution_time>

            <!-- Memory for insert operations -->
            <max_memory_usage>10000000000</max_memory_usage> <!-- 10GB -->

            <!-- Insert-specific settings -->
            <max_threads>4</max_threads>
            <max_insert_threads>4</max_insert_threads>
            <workload>ingest</workload>
            <max_insert_block_size>1048576</max_insert_block_size> <!-- 1M rows -->

            <!-- Async insert optimization — durability ACK (NAN-1406), see the
                 default profile's note. -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_max_data_size>104857600</async_insert_max_data_size> <!-- 100MB -->
            <async_insert_busy_timeout_ms>1000</async_insert_busy_timeout_ms>
            <!-- NAN-5296: the default profile's adaptive floor (2000 ms) sits
                 above this profile's 1000 ms ceiling, and ClickHouse warned on
                 every flush. Pin the floor to the ceiling: the flush cadence
                 stays exactly 1 s. -->
            <async_insert_busy_timeout_min_ms>1000</async_insert_busy_timeout_min_ms>
            <async_insert_stale_timeout_ms>5000</async_insert_stale_timeout_ms>

            <!-- Allow deduplication for idempotent inserts -->
            <insert_deduplicate>1</insert_deduplicate>
            <!-- NAN-1728: async-insert retries must dedup too (insert_deduplicate
                 alone only covers synchronous inserts), and the block dedup must
                 propagate into the MV cascade so the ENGINE=Null raw lanes
                 (ocsf_logs_raw, otel_*_raw) don't double-insert into their
                 Replicated targets on a Vector retry-after-commit. Harmless on
                 single-shard. -->
            <async_insert_deduplicate>1</async_insert_deduplicate>
            <deduplicate_blocks_in_dependent_materialized_views>1</deduplicate_blocks_in_dependent_materialized_views>

            <!-- NAN-5203: an insert into a write-only *_raw_distributed wrapper
                 (multi-shard OTLP sinks, Tenzir) must commit on the target shard
                 before ClickHouse acknowledges it. Background mode acks from a
                 local spool and re-batches, which breaks the NAN-1406 durability
                 ACK and the retry-dedup split. No effect on inserts into local
                 tables, which is every single-shard write. -->
            <distributed_foreground_insert>1</distributed_foreground_insert>

            <!-- Parallel inserts -->
            <parallel_distributed_insert_select>2</parallel_distributed_insert_select>

            <!-- Don't log every insert query -->
            <log_queries>0</log_queries>

            <!-- Lower priority than queries -->
            <priority>8</priority>

            <!-- Disable profiling -->
            <memory_profiler_step>0</memory_profiler_step>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
        </ingestion>

        <!-- =================================================================
             INGEST_DIRECT PROFILE (NAN-5473)
             nanosiem_ingest, the login external direct-OCSF writers (Tenzir)
             use. Everything from `ingestion`, plus bounded reads: that login
             is reachable from outside (ingestAllowedNetworks) and its
             column-scoped SELECT on ocsf_logs exists only for the MV chain's
             insert-time grant check. The MV chain reads the inserted block,
             never the stored table, so these bounds never touch an insert
             (max_insert_block_size is 1M rows, far below max_rows_to_read).
             max_execution_time applies to an INSERT too: 300 s is far above
             any insert at benchmark rates (a flush is ~1 s) and still bounds
             a SELECT that used to run forever (ingestion sets 0).
             ================================================================= -->
        <ingest_direct>
            <profile>ingestion</profile>
            <max_execution_time>300</max_execution_time>
            <max_rows_to_read>100000000</max_rows_to_read>
            <read_overflow_mode>throw</read_overflow_mode>
            <max_result_rows>100000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
            <constraints>
                <max_execution_time>
                    <min>1</min>
                    <max>300</max>
                </max_execution_time>
                <max_rows_to_read>
                    <min>1</min>
                    <max>100000000</max>
                </max_rows_to_read>
                <!-- No <min> on max_result_rows (NAN-5470): ClickHouse resets it
                     to 0 for a subquery or remote stage, and on a cluster
                     <secret> hop the shard clamps that 0 to the initial user's
                     constraints, so MIN 1 fails every multi-row subquery,
                     IN / GLOBAL IN and distributed join with 396
                     (agentlane.rs documents the same trap). -->
                <max_result_rows>
                    <max>100000</max>
                </max_result_rows>
                <read_overflow_mode>
                    <readonly/>
                </read_overflow_mode>
                <result_overflow_mode>
                    <readonly/>
                </result_overflow_mode>
            </constraints>
        </ingest_direct>

        <!-- =================================================================
             SEARCH PROFILE (NAN-5470)
             nanosiem_search: interactive search (nano-search, the API's AI
             search paths). The analyst `default` profile, minus DDL, with the
             security-relevant toggles CONST and every resource setting the
             app sends (search::admission tiers, background jobs, inline
             SETTINGS) bounded above what it ever asks for, so a crafted
             SETTINGS clause cannot lift them:
               max_execution_time  app max 3600 (analytics), jobs 1800 by
                                   default (clamped to 7200 in the app)
               max_memory_usage    app max 50 GiB = 53,687,091,200 (analytics
                                   tier, search::admission); capped at 100 GiB
               max_threads         app max 32
               max_rows_to_read    profile 1e9, field stats 200k
             ================================================================= -->
        <search>
            <profile>default</profile>
            <allow_ddl>0</allow_ddl>
            <allow_introspection_functions>0</allow_introspection_functions>
            <constraints>
                <allow_ddl>
                    <readonly/>
                </allow_ddl>
                <allow_introspection_functions>
                    <readonly/>
                </allow_introspection_functions>
                <max_execution_time>
                    <min>1</min>
                    <max>7200</max>
                </max_execution_time>
                <max_memory_usage>
                    <min>1</min>
                    <max>107374182400</max>
                </max_memory_usage>
                <max_threads>
                    <min>1</min>
                    <max>32</max>
                </max_threads>
                <max_rows_to_read>
                    <min>1</min>
                    <max>10000000000</max>
                </max_rows_to_read>
                <max_bytes_to_read>
                    <min>1</min>
                    <max>500000000000</max>
                </max_bytes_to_read>
                <!-- No <min> on max_result_rows (NAN-5470): ClickHouse resets it
                     to 0 for a subquery or remote stage, and on a cluster
                     <secret> hop the shard clamps that 0 to the initial user's
                     constraints, so MIN 1 fails every multi-row subquery,
                     IN / GLOBAL IN and distributed join with 396
                     (agentlane.rs documents the same trap). -->
                <max_result_rows>
                    <max>10000000</max>
                </max_result_rows>
            </constraints>
        </search>

        <!-- =================================================================
             DICT_SOURCE PROFILE (NAN-5470)
             nanosiem_dict: dictionary SOURCE queries. The `default` profile's
             limits (what the sources ran under as `nanosiem`), read-only.
             readonly=2, not 1: several source queries carry their own
             SETTINGS (memory spill, dict_source_memory_guard.rs).
             ================================================================= -->
        <dict_source>
            <profile>default</profile>
            <readonly>2</readonly>
            <allow_ddl>0</allow_ddl>
            <allow_introspection_functions>0</allow_introspection_functions>
            <constraints>
                <readonly>
                    <readonly/>
                </readonly>
                <allow_ddl>
                    <readonly/>
                </allow_ddl>
                <allow_introspection_functions>
                    <readonly/>
                </allow_introspection_functions>
            </constraints>
        </dict_source>

        <!-- =================================================================
             ADMIN PROFILE
             For schema changes and maintenance operations
             ================================================================= -->
        <admin>
            <network_compression_method>LZ4</network_compression_method>
            <!-- NAN-4903: never infer Date/DateTime from JSON strings. Inference is per
                 insert block, so one date-like vendor value retyped the whole path and
                 coerced the other rows ("1" became 2026-01-01) in event/unmapped/ext. -->
            <input_format_try_infer_dates>0</input_format_try_infer_dates>
            <input_format_try_infer_datetimes>0</input_format_try_infer_datetimes>
            <!-- No limits for admin operations -->
            <max_execution_time>0</max_execution_time>
            <max_memory_usage>0</max_memory_usage>
            <max_rows_to_read>0</max_rows_to_read>
            <max_bytes_to_read>0</max_bytes_to_read>
            <max_threads>64</max_threads>

            <!-- Allow DDL -->
            <readonly>0</readonly>
            <allow_ddl>1</allow_ddl>

            <!-- Enable full-text index support (required for tokenbf_v1 indexes in CH 25.12+) -->
            <enable_full_text_index>1</enable_full_text_index>

            <!-- Logging -->
            <log_queries>1</log_queries>
            <log_query_threads>1</log_query_threads>

            <!-- Disable profiling -->
            <memory_profiler_step>0</memory_profiler_step>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
        </admin>

        <!-- =================================================================
             RAWSQL PROFILE (NAN-2001)
             The two raw-SQL feature identities (nanosiem_rawsql /
             nanosiem_rawsql_noaudit). Read-only, hardened. The GRANT SELECT
             list (nanosiem-users.xml) is the allowlist; this profile is
             defense-in-depth against a settings-based bypass.

             readonly=2 (not 1): blocks writes/DDL regardless of grants, yet
             still lets the app apply its per-query settings via HTTP params
             (max_execution_time / max_memory_usage / max_threads / priority /
             queue_max_wait_ms / max_result_rows / max_result_bytes /
             result_overflow_mode). readonly=1 would reject every one of those
             unless individually whitelisted — fragile against a client upgrade.
             The <constraints> below make readonly=2 and the security-relevant
             settings CONST (a user can't lower readonly or flip a security
             toggle for its session) and bound the resource maxima. Validated
             live on CH 26.4.3.37.

             NOTE: `select_from_system_db_requires_grant` is a SERVER-level
             access_control_improvements setting (not per-profile), so system.*
             metadata tables (e.g. system.settings) stay readable to a
             grant-only user — that is why the app-side system/information_schema
             reject in validate_sql_query is MANDATORY, not optional UX.
             ================================================================= -->
        <rawsql>
            <network_compression_method>LZ4</network_compression_method>
            <!-- NAN-4903: never infer Date/DateTime from JSON strings. Inference is per
                 insert block, so one date-like vendor value retyped the whole path and
                 coerced the other rows ("1" became 2026-01-01) in event/unmapped/ext. -->
            <input_format_try_infer_dates>0</input_format_try_infer_dates>
            <input_format_try_infer_datetimes>0</input_format_try_infer_datetimes>
            <!-- Security hardening -->
            <readonly>2</readonly>
            <allow_ddl>0</allow_ddl>
            <allow_introspection_functions>0</allow_introspection_functions>
            <!-- Fail-closed cross-shard: a missing policy/user on a shard must
                 surface as an error, never a silent partial result (handoff §3.5). -->
            <skip_unavailable_shards>0</skip_unavailable_shards>

            <!-- Resource limits (defaults; app overrides within the MAX bounds below) -->
            <max_memory_usage>20000000000</max_memory_usage>
            <max_memory_usage_for_user>40000000000</max_memory_usage_for_user>
            <max_execution_time>300</max_execution_time>
            <max_rows_to_read>1000000000</max_rows_to_read>
            <max_bytes_to_read>100000000000</max_bytes_to_read>
            <max_result_rows>1000000</max_result_rows>
            <max_result_bytes>1000000000</max_result_bytes>
            <max_threads>16</max_threads>
            <workload>interactive</workload>
            <queue_max_wait_ms>60000</queue_max_wait_ms>
            <result_overflow_mode>throw</result_overflow_mode>

            <!-- SIEM query optimizations (parity with the default analyst profile
                 so raw SQL is not slower) -->
            <optimize_move_to_prewhere>1</optimize_move_to_prewhere>
            <optimize_read_in_order>1</optimize_read_in_order>
            <optimize_aggregation_in_order>1</optimize_aggregation_in_order>
            <use_skip_indexes>1</use_skip_indexes>
            <use_query_condition_cache>1</use_query_condition_cache>
            <use_skip_indexes_for_top_k>1</use_skip_indexes_for_top_k>
            <enable_full_text_index>1</enable_full_text_index>

            <!-- Logging (audit which raw SQL ran) -->
            <log_queries>1</log_queries>
            <log_query_threads>0</log_query_threads>

            <!-- Lock the security-relevant settings CONST and bound the resource
                 maxima. `<readonly/>` inside a constraint means "const /
                 unchangeable" (ClickHouse's confusingly-named XML form). -->
            <constraints>
                <readonly>
                    <readonly/>
                </readonly>
                <allow_ddl>
                    <readonly/>
                </allow_ddl>
                <allow_introspection_functions>
                    <readonly/>
                </allow_introspection_functions>
                <skip_unavailable_shards>
                    <readonly/>
                </skip_unavailable_shards>
                <max_execution_time>
                    <max>600</max>
                </max_execution_time>
                <max_result_rows>
                    <max>5000000</max>
                </max_result_rows>
                <max_threads>
                    <max>32</max>
                </max_threads>
                <max_memory_usage>
                    <max>40000000000</max>
                </max_memory_usage>
            </constraints>
        </rawsql>
    </profiles>

    <!-- =======================================================================
         USERS
         Map users to profiles
         ======================================================================= -->
    <users>
        <!-- Main application user. NAN-5457: the quota is `nano_service` (no
             query-count cap), matching nanosiem-users.xml. This file sorts after
             nanosiem-users.xml and users.d files merge, so a `default` here
             would silently put the cap back. -->
        <nanosiem>
            <profile>default</profile>
            <quota>nano_service</quota>
            <!-- NAN-5367: <networks> live with the user in nanosiem-users.xml.
                 Users.d files MERGE, so an any-address entry here would re-open it. -->
        </nanosiem>
    </users>

    <!-- =======================================================================
         QUOTAS
         Resource usage limits over time periods
         ======================================================================= -->
    <quotas>
        <!-- `default`: the budget for people. It applies to the raw-SQL users
             (nanosiem_rawsql, nanosiem_rawsql_noaudit) and the container-local
             `default` user. Every key is per user (system.quotas keys =
             ['user_name']), so one user running out never blocks another.
             Agent Lane tokens get their own per-token quotas (CREATE QUOTA,
             nanosiem-enterprise agentlane/sql.rs), not this one. -->
        <default>
            <interval>
                <duration>3600</duration> <!-- 1 hour -->
                <queries>100000</queries>
                <errors>100000</errors>
                <result_rows>1000000000</result_rows>
                <read_rows>100000000000</read_rows>
                <execution_time>36000</execution_time> <!-- 10 hours total -->
            </interval>
        </default>

        <!-- NAN-5470: `nano_search`, for the interactive search identity
             (nanosiem_search). Per user, per server, per hour. A backstop and
             an attribution bucket, NOT rationing: per-query limits (`search`
             profile) and the app's admission control already protect the
             server, and running out locks every search out for the rest of
             the hour (the NAN-5457 failure mode), so it errs generous. Sized
             (clickhouse_service_quota_guard.rs, from the app's config) for,
             all at once and flat out for the hour, with 2x headroom:
               * 30 admitted ad-hoc searches (admission ceiling), each with
                 its parallel count(*) companion;
               * background search jobs (2 per search process, 4 processes);
               * user and AI searches nano-api runs in process (another
                 admission ceiling's worth);
             = 98 concurrent queries.
               queries         2,000,000  98 x the 2/s progress poller x 3600
                                          x 2 = 1,411,200
               errors            400,000
               execution_time  1,000,000 s  98 x 3600 x 2 = 705,600
             read_rows / result_rows are tracked, not capped: per-query
             max_rows_to_read / max_result_rows in the `search` profile bound
             them. On a cluster each server counts the shard work it does for
             this user (cluster secret). SIEM Health reports QUOTA_EXCEEDED for
             any nano user. -->
        <nano_search>
            <interval>
                <duration>3600</duration>
                <queries>2000000</queries>
                <errors>400000</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>1000000</execution_time>
            </interval>
        </nano_search>

        <!-- NAN-5457: `nano_service`, for nano's own service users: nanosiem
             (app, jobs, scheduled detections, connector-runner, the cluster's
             Distributed hops before the cluster secret), nanosiem_dict
             (dictionary sources, NAN-5470), nanosiem_vector (Vector inserts),
             nanosiem_ingest (direct OCSF writers) and nanosiem_admin
             (migrations). Their query count grows with ingest volume, not with
             people: each Vector batch, each Distributed block forwarded to
             another shard and each cache-dictionary miss is one query. At
             ~24k events/s on a 2-shard cluster the old flat 100,000 queries
             per hour ran out before the hour did, and inserts failed with
             QUOTA_EXCEEDED. Every limit is 0 (unlimited): the interval only
             tracks usage, so system.quotas_usage still shows it. Per-query
             guards stay in the settings profiles (max_memory_usage,
             max_execution_time and the rest). Do not give these users a count
             cap: an insert path must never be rationed by the hour.
             Guard: nanosiem-core/tests/clickhouse_service_quota_guard.rs. -->
        <nano_service>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </nano_service>
    </quotas>
</clickhouse>
