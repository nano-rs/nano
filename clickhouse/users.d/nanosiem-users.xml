<clickhouse>
  <!-- Docs: <https://clickhouse.com/docs/operations/settings/settings_users/> -->
  <!--
    NAN-807 bug #2: passwords are sourced from env vars passed into the
    container (CLICKHOUSE_NANOSIEM_PASSWORD / CLICKHOUSE_ADMIN_PASSWORD) so
    each deployment gets per-install random secrets without baking creds
    into version-controlled XML.
  -->
  <users>
    <!-- Admin user for migrations (DDL enabled) -->
    <nanosiem_admin>
      <profile>admin</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_ADMIN_PASSWORD"/>
      <quota>default</quota>
      <access_management>1</access_management>
      <allow_ddl>1</allow_ddl>
    </nanosiem_admin>

    <!-- Runtime user for queries (no DDL for security) -->
    <nanosiem>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_NANOSIEM_PASSWORD"/>
      <quota>default</quota>
      <access_management>0</access_management>
      <allow_ddl>0</allow_ddl>
      <!-- Grant access to nanosiem database -->
      <grants>
        <query>GRANT SELECT, INSERT, ALTER, CREATE, DROP ON nanosiem.*</query>
        <query>GRANT dictGet ON nanosiem.*</query>
        <!-- NAN-1399: the enrichment scheduler hot-reloads dictionaries after
             auto-sync so fresh data applies immediately instead of waiting out
             the dict LIFETIME. *.* is the only scope CH accepts for this grant;
             it adds no read/write/DDL capability beyond the grants above. -->
        <query>GRANT SYSTEM RELOAD DICTIONARY ON *.*</query>
        <!-- NAN-2027: distribute runtime DDL the user is already granted per-table
             ON CLUSTER across every shard/replica — the IPinfo generation purge
             (ALTER … DELETE ON CLUSTER), retention TTL, storage tiering, GDPR
             erasure, and lookup-table writes. Without it those ON CLUSTER
             statements fail Code 497 (grant CLUSTER ON *.*) on a clustered
             deployment. CLUSTER only accepts *.* scope and adds no read/write
             capability beyond the per-table grants above — only their cluster
             fan-out. Empty/no-op on single-node (on_cluster_clause() is empty). -->
        <query>GRANT CLUSTER ON *.*</query>
        <query>GRANT SELECT(bytes_on_disk, rows, data_uncompressed_bytes, partition, database, table, active) ON system.parts</query>
        <query>GRANT SELECT(total_space, free_space, type) ON system.disks</query>
        <!-- NAN-1405: siem-health insert-integrity probes — detect the
             NAN-1404 silent-loss class (async-insert flushes discarding
             batches while every ACK stays green). Column-scoped reads only. -->
        <query>GRANT SELECT(type, query_kind, event_time, tables) ON system.query_log</query>
        <query>GRANT SELECT(event_type, event_time, database, table) ON system.part_log</query>
        <query>GRANT SELECT(name, value, last_error_time) ON system.errors</query>
        <query>GRANT SELECT(database, name, status, last_exception) ON system.dictionaries</query>
        <!-- NAN-1437: system.dictionaries rows are filtered by SHOW DICTIONARIES
             visibility, and only the GLOBAL scope works (db-scoped showed 0 rows
             on CH 26.4) — without this the FAILED-dict probe above runs without
             error but sees ZERO dictionaries. Metadata visibility only. -->
        <query>GRANT SHOW DICTIONARIES ON *.*</query>
        <query>GRANT SELECT(event_time, database, table, status, exception) ON system.asynchronous_insert_log</query>
        <!-- NAN-1407: siem-health staleness probe for the dictionary-staging
             refresh MVs (*_dict_refresh). A failing refresh keeps ingestion
             alive on the last good staging snapshot; this read is how the
             staleness surfaces. Column-scoped. -->
        <!-- NAN-1629: status + next_refresh_time are used in the probe's WHERE
             (status='Disabled', next_refresh_time < now()-1h); without them the
             column-scoped grant rejects the whole read (ACCESS_DENIED). -->
        <query>GRANT SELECT(database, view, exception, retry, last_success_time, status, next_refresh_time) ON system.view_refreshes</query>
        <!-- NAN-1435: search cancel (KILL QUERY WHERE query_id IN …) and the
             query-progress endpoint read system.processes. Table-level on
             purpose: ClickHouse's KILL rejects column-scoped SELECT on
             system.processes (verified on 26.4) — without this grant, cancel
             has silently failed with ACCESS_DENIED since inception. -->
        <query>GRANT SELECT ON system.processes</query>
        <!-- NAN-2330: clustered process visibility without granting REMOTE to
             the runtime user. Migration 172 owns this narrow DEFINER view. -->
        <query>GRANT SELECT ON nanosiem.cluster_processes</query>
      </grants>
    </nanosiem>

    <!--
      NAN-1384 (G18): INSERT-only credential for DIRECT OCSF writers (Tenzir /
      Cribl-style pipelines inserting OCSF records without Vector).
      The shared `nanosiem` user grants SELECT+INSERT+DDL on all of nanosiem.* —
      handing it to a foreign pipeline means read access to every log and write
      access to the identity/prevalence dictionaries' source tables. This user
      is scoped to exactly what a direct OCSF INSERT requires. NAN-1443: writers
      now INSERT into the `ocsf_logs_raw` ENGINE=Null landing table; the
      `ocsf_logs_raw_mv` derives the stored row into `ocsf_logs` (the full `event`
      blob is never stored). CH checks the INSERTING user's grants across the
      whole MV chain, so the credential needs:
        * INSERT on ocsf_logs_raw (the write target).
        * table-level SELECT on ocsf_logs_raw — the ocsf_logs_raw_mv reads
          `timestamp`, `source_type`, `id`, `event`, AND the typed JSON
          subcolumn `event.^unmapped`. That subcolumn CANNOT be named in a
          GRANT (the `^` caret is a grant-parser SYNTAX_ERROR), so a
          column-scoped grant can't cover it (NAN-1444). ocsf_logs_raw is
          ENGINE=Null — it stores nothing and SELECT always returns empty —
          so table-level SELECT exposes no data; it only satisfies the MV
          chain's insert-time grant check.
        * INSERT on ocsf_logs — the ocsf_logs_raw_mv writes the derived row there.
        * dictGet on the 6 dictionaries its MATERIALIZED enrichment/prevalence
          columns call at insert time (insert fails ACCESS_DENIED otherwise —
          verified on CH 26.4).
        * column-scoped SELECT on ocsf_logs for the columns the OCSF prevalence
          summary MVs read while pushing (CH checks the INSERTING user's SELECT
          on MV source columns). If you add/widen an MV over ocsf_logs, extend
          this list — see the warning in clickhouse/ocsf/init.sql.
      Residual surface: dictGet exposes dictionary lookups and the column-scoped
      SELECT exposes entity columns (IPs/hostnames/hashes) — but no message/event
      content and no write path beyond ocsf_logs.
      Contract: docs/user-guide/direct-ocsf-ingestion.md.
    -->
    <nanosiem_ingest>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_INGEST_PASSWORD"/>
      <quota>default</quota>
      <access_management>0</access_management>
      <allow_ddl>0</allow_ddl>
      <grants>
        <!-- NAN-1443/NAN-1444: write into the ocsf_logs_raw landing table; the
             ocsf_logs_raw_mv reads timestamp/source_type/id/event AND the typed
             JSON subcolumn event.^unmapped from raw and INSERTs the derived row
             into ocsf_logs. CH checks the inserting user's SELECT across the MV
             chain. event.^unmapped can't be column-scoped in a GRANT (the caret
             is a syntax error), and raw is ENGINE=Null (no data to read), so a
             table-level SELECT is both necessary and safe. SELECT(`event`) alone
             fails the direct path with ACCESS_DENIED on the unnameable subcolumn. -->
        <query>GRANT INSERT ON nanosiem.ocsf_logs_raw</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs_raw</query>
        <!-- NAN-1603: native-protocol entrypoint for Tenzir `to_clickhouse`
             (v6.4.0+, port 9000). ocsf_logs_native_raw_mv forwards (event,
             source_type) into ocsf_logs_raw (granted above), so the inserting
             user needs INSERT + table-level SELECT on the native entrypoint too.
             ocsf_logs_native_raw is ENGINE=Null (stores nothing, SELECT always
             empty) — table-level SELECT only satisfies the MV chain's insert-time
             grant check and exposes no data. -->
        <query>GRANT INSERT ON nanosiem.ocsf_logs_native_raw</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs_native_raw</query>
        <query>GRANT INSERT ON nanosiem.ocsf_logs</query>
        <query>GRANT SELECT(`timestamp`, `src_endpoint.ip`, `dst_endpoint.ip`, `dst_endpoint.port`, `src_endpoint.hostname`, `dst_endpoint.hostname`, `query.hostname`, `url.hostname`, `file.hashes.sha256`, `process.file.hashes.sha256`, `actor.process.file.hashes.sha256`, `src_host_unified`, `user_unified`, `process_name_unified`, `src_endpoint.mac`, `source_type`, `metadata.product.name`, `event_bytes`, `http_response.code`, `status_id`, `activity_id`, `class_uid`, `is_mfa`, `api.service.name`, `cloud.region`, `cloud.provider`) ON nanosiem.ocsf_logs</query>
        <!-- NAN-1400: nat_detection_mv chains off identity_observations (which
             ocsf_identity_observations_mv writes into); CH checks the INSERTING
             user's SELECT on the chained MV's source columns too. Without this,
             the whole flush fails 497 AFTER committing the ocsf_logs parts. -->
        <query>GRANT SELECT(ip, observed_at) ON nanosiem.identity_observations</query>
        <query>GRANT dictGet ON nanosiem.custom_enrichment_dict</query>
        <query>GRANT dictGet ON nanosiem.domain_prevalence_dict</query>
        <query>GRANT dictGet ON nanosiem.hash_prevalence_dict</query>
        <query>GRANT dictGet ON nanosiem.ioc_enrichment_dict</query>
        <query>GRANT dictGet ON nanosiem.ip_enrichment_dict</query>
        <query>GRANT dictGet ON nanosiem.ip_prevalence_dict</query>
        <!-- NAN-1787: same chained-MV class as NAN-1400. An ocsf_logs insert fires
             the OCSF prevalence MVs (ocsf_*_prevalence_summary_*_mv) which write
             INTO the *_prevalence_agg tables; that write in turn fires
             {ip,hash,domain}_prevalence_summary_mv, whose SELECT reads FROM the agg
             table and runs under the INSERTING user. Without table-level SELECT on
             the agg tables, any OCSF event carrying a src_ip / hash / domain fails
             497 AFTER committing the ocsf_logs part (row lands, insert errors,
             producer retries -> duplicates). MV *target* pushes aren't grant-checked,
             so SELECT on the three agg tables is the complete fix. -->
        <query>GRANT SELECT ON nanosiem.ip_prevalence_agg</query>
        <query>GRANT SELECT ON nanosiem.hash_prevalence_agg</query>
        <query>GRANT SELECT ON nanosiem.domain_prevalence_agg</query>
      </grants>
    </nanosiem_ingest>

    <!--
      NAN-2001: two dedicated READ-ONLY identities for the raw-SQL surface
      (POST /api/search/sql, dashboards SQL panels, reports, meloD advanced mode).
      The GRANT SELECT list IS the raw-SQL table allowlist — ClickHouse natively
      denies table functions (url/s3/remote/file/…), system.*, other DBs, and
      writes. This retires the fail-open sqlparser AST walk (validate_sql_query /
      inject_audit_filter) that an adversarial review bypassed in 6 rounds.

      Two identities, not one + SET ROLE (a missed role reset = silent audit
      bypass):
        * nanosiem_rawsql         — audit-capable (caller HAS audit:view). No row
                                     policy; sees everything it is granted.
        * nanosiem_rawsql_noaudit — caller LACKS audit:view (fail-closed default).
                                     NARROWER grant set (audit-derived aggregates
                                     whose source column is dropped at
                                     materialization — *_prevalence_agg,
                                     entity_time_range_agg, cloud_user_activity_agg,
                                     nat_candidates — are NOT granted here; a row
                                     policy cannot retroactively clean them) PLUS a
                                     RESTRICTIVE row policy lower(source_type)!='audit'
                                     (lower(source)!='audit' on identity_observations)
                                     created by the migrator's ensure_rawsql_row_policies()
                                     step (topology-aware: _local + ON CLUSTER on
                                     clusters).

      The app builds both clients in DualPool from CLICKHOUSE_RAWSQL_PASSWORD /
      CLICKHOUSE_RAWSQL_NOAUDIT_PASSWORD and FAILS BOOT if either is missing (no
      fallback to the broad nanosiem client) and if either user's granted table set
      does not match the expected allowlist (drift guard). Grants list bare +
      _local + _distributed twins uniformly: harmless unused grants on single-node
      (the twins do not exist), and required on clusters (the Distributed engine
      re-checks the SAME user's SELECT on *_local on each remote shard under the
      cluster <secret>). Profile `rawsql` (query_limits.xml) is readonly with the
      security-relevant settings constrained. Grants MUST stay declarative here —
      users defined in users.xml cannot receive a SQL GRANT (495
      ACCESS_STORAGE_READONLY); only the row policies are created via SQL.
    -->
    <nanosiem_rawsql>
      <profile>rawsql</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_RAWSQL_PASSWORD"/>
      <quota>default</quota>
      <access_management>0</access_management>
      <allow_ddl>0</allow_ddl>
      <grants>
        <query>GRANT SELECT ON nanosiem.logs</query>
        <query>GRANT SELECT ON nanosiem.logs_local</query>
        <query>GRANT SELECT ON nanosiem.logs_distributed</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs_local</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs_distributed</query>
        <query>GRANT SELECT ON nanosiem.signals</query>
        <query>GRANT SELECT ON nanosiem.signals_local</query>
        <query>GRANT SELECT ON nanosiem.signals_distributed</query>
        <query>GRANT SELECT ON nanosiem.domain_prevalence_agg</query>
        <query>GRANT SELECT ON nanosiem.domain_prevalence_agg_local</query>
        <query>GRANT SELECT ON nanosiem.domain_prevalence_agg_distributed</query>
        <query>GRANT SELECT ON nanosiem.hash_prevalence_agg</query>
        <query>GRANT SELECT ON nanosiem.hash_prevalence_agg_local</query>
        <query>GRANT SELECT ON nanosiem.hash_prevalence_agg_distributed</query>
        <query>GRANT SELECT ON nanosiem.ip_prevalence_agg</query>
        <query>GRANT SELECT ON nanosiem.ip_prevalence_agg_local</query>
        <query>GRANT SELECT ON nanosiem.ip_prevalence_agg_distributed</query>
        <query>GRANT SELECT ON nanosiem.identity_observations</query>
        <query>GRANT SELECT ON nanosiem.identity_observations_local</query>
        <query>GRANT SELECT ON nanosiem.identity_observations_distributed</query>
        <query>GRANT SELECT ON nanosiem.nat_candidates</query>
        <query>GRANT SELECT ON nanosiem.nat_candidates_local</query>
        <query>GRANT SELECT ON nanosiem.nat_candidates_distributed</query>
        <query>GRANT SELECT ON nanosiem.entity_time_range_agg</query>
        <query>GRANT SELECT ON nanosiem.entity_time_range_agg_local</query>
        <query>GRANT SELECT ON nanosiem.entity_time_range_agg_distributed</query>
        <query>GRANT SELECT ON nanosiem.cloud_user_activity_agg</query>
        <query>GRANT SELECT ON nanosiem.cloud_user_activity_agg_local</query>
        <query>GRANT SELECT ON nanosiem.cloud_user_activity_agg_distributed</query>
        <query>GRANT SELECT ON nanosiem.custom_enrichment_results</query>
        <query>GRANT SELECT ON nanosiem.custom_enrichment_results_local</query>
        <query>GRANT SELECT ON nanosiem.custom_enrichment_results_distributed</query>
        <query>GRANT SELECT ON nanosiem.ingestion_errors</query>
        <query>GRANT SELECT ON nanosiem.ingestion_errors_local</query>
        <query>GRANT SELECT ON nanosiem.ingestion_errors_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_spans</query>
        <query>GRANT SELECT ON nanosiem.otel_spans_local</query>
        <query>GRANT SELECT ON nanosiem.otel_spans_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_local</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1m</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1m_local</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1m_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1h</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1h_local</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1h_distributed</query>
      </grants>
    </nanosiem_rawsql>

    <nanosiem_rawsql_noaudit>
      <profile>rawsql</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_RAWSQL_NOAUDIT_PASSWORD"/>
      <quota>default</quota>
      <access_management>0</access_management>
      <allow_ddl>0</allow_ddl>
      <grants>
        <query>GRANT SELECT ON nanosiem.logs</query>
        <query>GRANT SELECT ON nanosiem.logs_local</query>
        <query>GRANT SELECT ON nanosiem.logs_distributed</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs_local</query>
        <query>GRANT SELECT ON nanosiem.ocsf_logs_distributed</query>
        <query>GRANT SELECT ON nanosiem.signals</query>
        <query>GRANT SELECT ON nanosiem.signals_local</query>
        <query>GRANT SELECT ON nanosiem.signals_distributed</query>
        <query>GRANT SELECT ON nanosiem.identity_observations</query>
        <query>GRANT SELECT ON nanosiem.identity_observations_local</query>
        <query>GRANT SELECT ON nanosiem.identity_observations_distributed</query>
        <query>GRANT SELECT ON nanosiem.custom_enrichment_results</query>
        <query>GRANT SELECT ON nanosiem.custom_enrichment_results_local</query>
        <query>GRANT SELECT ON nanosiem.custom_enrichment_results_distributed</query>
        <query>GRANT SELECT ON nanosiem.ingestion_errors</query>
        <query>GRANT SELECT ON nanosiem.ingestion_errors_local</query>
        <query>GRANT SELECT ON nanosiem.ingestion_errors_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_spans</query>
        <query>GRANT SELECT ON nanosiem.otel_spans_local</query>
        <query>GRANT SELECT ON nanosiem.otel_spans_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_local</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1m</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1m_local</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1m_distributed</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1h</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1h_local</query>
        <query>GRANT SELECT ON nanosiem.otel_metrics_1h_distributed</query>
      </grants>
    </nanosiem_rawsql_noaudit>
  </users>
</clickhouse>
