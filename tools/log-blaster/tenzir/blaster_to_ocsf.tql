// Nano's landing stage re-stamps these from the immutable folder/key binding.
// Add nano extensions AFTER ocsf_cast so the standard-schema cast keeps them.
metadata.log_source = "__NANO_ROUTE_KEY__"
metadata.tenant_uid = "__NANO_TENANT_UUID__"
// metadata.nano_credential_id is derived by the landing authority from the SigV4 key.
metadata.ingress_transport = "landing_bucket"

// ---- hosted S3 front -----------------------------------------------------
// to_s3 removes the partition field, leaving class_uid in every stored row.
// Nested paths are accepted inside the key's own tenant/source prefix.
_ocsf_class = class_uid
to_s3 "s3://landing/landing-ocsf-v1/tenant_id=__NANO_TENANT_UUID__/source=__NANO_SOURCE_ID__/**/events-{uuid}.parquet?endpoint_override=__NANO_INGEST_HOST__&region=us-east-1",
  aws_iam={access_key_id: "__NANO_ACCESS_KEY_ID__", secret_access_key: "__NANO_SECRET_ACCESS_KEY__"},
  max_size=64M, timeout=5min, partition_by=[_ocsf_class] {
  write_parquet
}
