// nano lean lake: Tenzir -> OCSF 1.9 -> nano bucket drop (NAN-3807)
//
// Sysmon EventID 1 (process create) as NDJSON with flat EventData fields
// (winlogbeat / NXLog style) -> OCSF 1.9.0 Process Activity: Launch (1007),
// written as Parquet straight into the install's object store (RustFS). No
// Vector, no HTTP endpoint: lake_landing_ingest converts each file into
// bronze, and the lake admits and enriches it like any other event.
//
// Set up a source once (prints the key and this sink, filled in):
//   docker compose run --rm lean-landing-admin add --name tenzir-sysmon
//
// Run it on the nano host's compose network (RustFS stays internal):
//   docker run --rm --network nano_default -v "$PWD:/data" \
//     -v "$PWD/sysmon-bucket.tql:/p.tql:ro" tenzir/tenzir:v6.19.1@sha256:6e96f962bc0a957d94d5149f840f7603c47a7b11d995e0f1fc167c141db7c06f -f /p.tql
//
// The key may only PUT objects under its own source folder; it cannot read,
// list or delete. Treat this file as a secret once the key is pasted in.

// SOURCE: swap in your own (accept_http, load_tcp, from_kafka, ...).
// `read_lines` keeps the original bytes so they can go in `raw_data` as-is.
from_file "/data/sysmon.ndjson" {
  read_lines
}

// MAPPING: Sysmon EID 1 -> OCSF 1.9.0 Process Activity: Launch.
this = {raw: line, s: line.parse_json()}
where s.EventID == 1
let $vendor = "Microsoft"
this = {
  raw_data: raw,
  s: s,
  event: {
    class_uid: 1007, class_name: "Process Activity",
    category_uid: 1, category_name: "System Activity",
    activity_id: 1, activity_name: "Launch",
    type_uid: 100701, type_name: "Process Activity: Launch",
    severity_id: 1, severity: "Informational",
    time: int(s.UtcTime.time().since_epoch() / 1ms),
    message: "Process launched: " + s.CommandLine,
    metadata: {
      version: "1.9.0",
      uid: s.ProcessGuid.replace("{", "").replace("}", "").to_lower(),
      original_event_uid: string(s.RecordID),
      log_name: s.Channel,
      product: {name: "Sysmon", vendor_name: $vendor},
    },
    device: {
      hostname: s.Computer.to_lower(),
      type_id: 0,
    },
    actor: {
      process: {
        uid: s.ParentProcessGuid.replace("{", "").replace("}", "").to_lower(),
        pid: s.ParentProcessId,
        cmd_line: s.ParentCommandLine,
        file: {path: s.ParentImage, name: s.ParentImage.split("\\").last(), type_id: 1},
      },
      user: {name: s.User.split("\\").last(), domain: s.User.split("\\").first()},
    },
    process: {
      uid: s.ProcessGuid.replace("{", "").replace("}", "").to_lower(),
      pid: s.ProcessId,
      cmd_line: s.CommandLine,
      file: {
        path: s.Image, name: s.Image.split("\\").last(), type_id: 1,
        hashes: [{algorithm_id: 3, algorithm: "SHA-256", value: s.Hashes.split("=").last().to_lower()}],
      },
      user: {name: s.User.split("\\").last(), domain: s.User.split("\\").first()},
    },
  },
}
event.raw_data = raw_data
this = event

// SINK: the source's landing folder. `{uuid}` names each file uniquely
// (UUIDv7); every file is converted once. Keep files well under 256 MiB.
to_s3 "s3://nano-lake/landing-ocsf-v1/tenant_id=<TENANT>/source=<SOURCE_ID>/{uuid}.parquet?endpoint_override=lake-object-store:9000&scheme=http",
  aws_iam={access_key_id: "<ACCESS_KEY_ID>", secret_access_key: "<SECRET_ACCESS_KEY>"} {
  write_parquet
}
