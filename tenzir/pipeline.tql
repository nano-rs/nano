// nano — bundled Tenzir → OCSF → ClickHouse starter pipeline (NAN-1604).
//
// This runs in the `nano-tenzir` container that `install.sh` adds when you pick
// the "ocsf+tenzir" schema option. It is a STARTER you are meant to edit: it
// stands a Tenzir node up, listening for events, and writes them into nano's
// OCSF store over the native ClickHouse protocol. The SINK is pre-wired and
// correct — you own the SOURCE and the OCSF MAPPING in between.
//
// As shipped it accepts newline-delimited JSON that is ALREADY OCSF 1.8.0 (each
// record an `event` object carrying at least `class_uid` and `time` in epoch
// ms) on :9095, and lands it in `nanosiem.ocsf_logs`. For raw logs, replace the
// EDIT block with your own parsing + OCSF mapping.
//
// Editing this for your sources? Read tenzir/AGENTS.md (next to this file) — the
// sink rules, OCSF mapping conventions, validation recipe, and gotchas.
// Docs (worked examples for Sysmon, Windows Event, Apache, CloudTrail, proxy):
//   https://nano.rs/docs/ocsf/integrations/direct-ocsf
//
// Connection is read from the environment (install.sh / compose set these):
//   CLICKHOUSE_INGEST_PASSWORD  REQUIRED — the nanosiem_ingest password.
//   NANO_CH_HOST                ClickHouse host.            Default clickhouse
//   NANO_CH_NATIVE_PORT         ClickHouse native TCP port. Default 9000
//   NANO_CH_INGEST_USER         INSERT-only user.           Default nanosiem_ingest
//   NANO_TENZIR_LISTEN          Listener address.           Default 0.0.0.0:9095

let $ch_host = env("NANO_CH_HOST").otherwise("clickhouse")
let $ch_port = int(env("NANO_CH_NATIVE_PORT").otherwise("9000"))
let $ch_user = env("NANO_CH_INGEST_USER").otherwise("nanosiem_ingest")
let $listen  = env("NANO_TENZIR_LISTEN").otherwise("0.0.0.0:9095")

// ── SOURCE ────────────────────────────────────────────────────────────────
// Receive newline-delimited JSON over HTTP. Point your shipper at
// http://<host>:9095/ — or swap this for any Tenzir source (`load_tcp`,
// `load_kafka`, `load_file`, syslog, ...). The listener keeps the node alive.
accept_http $listen { read_ndjson }

// ── EDIT ME: parse + map your events to OCSF 1.8.0 ─────────────────────────
// As shipped, records are assumed to ALREADY be OCSF objects, so we just wrap
// them in nano's wire shape {event, source_type}. For raw logs, do your
// parsing + OCSF mapping here and set a lowercase `source_type` per feed.
// Every record's `event` must carry `class_uid` and `time` (epoch ms).
//
// PRESERVE THE ORIGINAL (NAN-1827). If you parse a raw log here, keep the
// untouched original — syslog header and all — on `event.raw_data`, and use
// `event.message` for the human-readable summary. nano persists `raw_data` to
// its own column for the full retention window, so an OCSF feed re-materializes
// straight from it by re-running this mapping; no parallel raw archive.
//
//   let $original = this                    // BEFORE you parse anything
//   ... your parsing + OCSF mapping ...
//   event.raw_data = $original              // the bytes as received
//   event.message  = "<human-readable summary>"
//
// `raw_data` is OCSF `string_t` (not json_t since OCSF 1.5) — send a STRING. An
// object is stringified with its KEYS REORDERED, so it stops being byte-exact.
// It is stored, not searched by bare keywords: a bare `foo` hunt still targets
// `message`, so put something meaningful there. Leave `raw_data` unset and you
// pay nothing for it (empty column), but the original is gone.
this = { event: this, source_type: "tenzir" }
// Guard: `to_clickhouse` drops an event that has a NULL in a required column —
// even one that has a ClickHouse DEFAULT (only ABSENT columns take the default).
// If you map `source_type` from event data and it can be null, keep this
// fallback so a missing value lands as `unknown` instead of dropping the row.
source_type = source_type.otherwise("unknown")
// ───────────────────────────────────────────────────────────────────────────

// ── BATCH (coalesce before the sink — keep this) ───────────────────────────
// ClickHouse wants big inserts, not a storm of 1-row parts. A mapping that
// produces HETEROGENEOUS events (real OCSF: each class / field-set is a distinct
// Tenzir schema) fragments the stream into ~1-row table slices, and
// `to_clickhouse` then issues one native INSERT per event — which at volume
// backs up in the node's memory buffer and OOM-kills it (NAN-1839). `batch`
// buffers PER SCHEMA and, in the default ORDERED mode, flushes on every schema
// change (so it can't coalesce interleaved schemas); `unordered { batch }`
// accumulates same-schema events across the stream into large inserts (measured
// ~1.4 → 23 rows/insert, OOM → bounded memory). Order is irrelevant once rows
// are in ClickHouse. Raise `timeout` for bigger batches at a little more latency.
unordered { batch 65536, timeout=2s }

// ── SINK (pre-wired — keep the table) ──────────────────────────────────────
// Native to_clickhouse straight into nano's OCSF landing table. nano's
// materialized-view chain derives every promoted / enriched / prevalence column
// into `nanosiem.ocsf_logs`; you send only {event, source_type} and the server
// fills the timestamp (from event.time) and the row id.
//
// Requires Tenzir >= 6.6.0 — the first release whose `to_clickhouse` accepts
// ocsf_logs_raw's LowCardinality(String) + DateTime64(3, 'UTC') columns AND
// omits the server-derived columns it doesn't send (timestamp, id) so their
// DEFAULTs fire. On Tenzir 6.4.0–6.5.x, target the legacy
// `nanosiem.ocsf_logs_native_raw` entrypoint instead (a thin JSON/String shim
// that forwards into ocsf_logs_raw) — see tenzir/AGENTS.md.
// `tls=false` — the native port is plaintext on the internal docker network.
to_clickhouse table="nanosiem.ocsf_logs_raw",
  host=$ch_host, port=$ch_port,
  user=$ch_user, password=env("CLICKHOUSE_INGEST_PASSWORD"),
  tls=false, mode="append"
