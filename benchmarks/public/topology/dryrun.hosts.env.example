# Dry run: the smallest role-split install that exercises every path.
# 1 app (app, postgres, keeper) + 1 ClickHouse + 1 ingest (Vector) + 1 blaster.
# Copy to a scratch directory (it names live IPs and your key), fill in, and pass
# it as --topology. Never commit the filled-in copy.
BENCH_NAME=bench-dryrun
PROVIDER="your-cloud"
REGION=your-region
NANO_VERSION=2.0.23
SSH_KEY=/path/to/scratch/bench_ed25519
SSH_USER=ubuntu
APP=203.0.113.10
CH="203.0.113.11"
INGEST="203.0.113.12"
BLASTER="203.0.113.13"
SEED=20261114
ASSETS=5000
BLAST_PROCS=1
BLAST_THREADS=4
PRICING_FILE=dryrun.pricing.json
