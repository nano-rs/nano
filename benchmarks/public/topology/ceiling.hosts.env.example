# Ceiling: role-split cluster sized to find where ingest breaks.
#   app1  app, postgres, keeper#1          gp.vs2.xlarge-dfw2    8 vCPU / 32 GB
#   ch1   clickhouse shard 1, keeper#2     gp.vs2.2xlarge-dfw2  16 vCPU / 64 GB
#   ch2   clickhouse shard 2, keeper#3     gp.vs2.2xlarge-dfw2  16 vCPU / 64 GB
#   ing1..3  ingest (Vector + nginx)       ch.vs2.xlarge-dfw2    8 vCPU / 16 GB
#   blaster1..3  log-blaster + k6           ch.vs2.xlarge-dfw2    8 vCPU / 16 GB
# vs2 classes only: Spot's vs1 hardware (Xeon E5 v1/v2) has no AVX2, which
# ClickHouse 26.6+ and Keeper require; install.sh refuses those hosts.
# There is no router/proxy role in the renderer: senders spread across the
# ingest hosts, as a customer's load balancer would. Step 2 adds ing4 (append
# its IP to INGEST, run prep + install for it, re-run content's token step is
# not needed: tokens are cluster-wide) to show the ceiling moves with Vector.
BENCH_NAME=bench-ceiling
PROVIDER="Rackspace Spot"
REGION=us-central-dfw-2
NANO_VERSION=2.0.25
SSH_KEY=/path/to/scratch/bench_ed25519
APP=203.0.113.10
CH="203.0.113.11 203.0.113.12"
CH_LAYOUT=shards
INGEST="203.0.113.21 203.0.113.22 203.0.113.23"
BLASTER="203.0.113.31 203.0.113.32 203.0.113.33"
SEED=20261114
ASSETS=20000
BLAST_PROCS=4
BLAST_THREADS=8
BLAST_BATCH=1000
START_EPS=10000
STEP_EPS=10000
STEP_SECS=600
DRAIN_SECS=90
MAX_EPS=400000
NAL_TABLE_SUFFIX=_distributed
PRICING_FILE=ceiling.pricing.json
