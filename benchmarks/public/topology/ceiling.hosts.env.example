# Ceiling: role-split cluster sized to find where ingest breaks.
#   app1  app, postgres, keeper#1          gp.xlarge    8 vCPU / 32 GB
#   ch1   clickhouse shard 1, keeper#2     gp.2xlarge  16 vCPU / 64 GB
#   ch2   clickhouse shard 2, keeper#3     gp.2xlarge  16 vCPU / 64 GB
#   ing1..4  ingest (Vector + nginx)       ch.xlarge    8 vCPU / 16 GB
#   blaster1..2  log-blaster + k6           gp.xlarge    8 vCPU / 32 GB
# AVX2 classes only: older Xeon E5 v1/v2 hardware has no AVX2, which
# ClickHouse 26.6+ and Keeper require; install.sh refuses those hosts.
# There is no router/proxy role in the renderer: senders spread across the
# ingest hosts, as a customer's load balancer would. All four ingest hosts are
# installed; ACTIVE_INGEST=3 sends to the first three only (the idle fourth is
# left out of the cost), ACTIVE_INGEST=4 to all four.
BENCH_NAME=bench-ceiling
PROVIDER="your-cloud"
REGION=your-region
NANO_VERSION=2.0.25
SSH_KEY=/path/to/scratch/bench_ed25519
APP=203.0.113.10
CH="203.0.113.11 203.0.113.12"
CH_LAYOUT=shards
INGEST="203.0.113.21 203.0.113.22 203.0.113.23 203.0.113.24"
BLASTER="203.0.113.31 203.0.113.32"
SEED=20261114
ASSETS=20000
BLAST_PROCS=6
BLAST_THREADS=3
BLAST_BATCH=1000
# 3-host ramps: ACTIVE_INGEST=3 run.sh ceiling ...; 4-host: ACTIVE_INGEST=4
START_EPS=18000
STEP_EPS=2000
STEP_SECS=300
DRAIN_SECS=60
MAX_EPS=200000
NAL_TABLE_SUFFIX=_distributed
PRICING_FILE=ceiling.pricing.json
