# Normal SOC day at a sizing tier (run once at 50 and once at 100 GB/day):
#   app1  app, postgres, keeper   gp.vs2.large-dfw2   4 vCPU / 16 GB
#   ch1   clickhouse              mh.vs2.xlarge-dfw2  8 vCPU / 64 GB
#   ing1  ingest                  ch.vs2.xlarge-dfw2  8 vCPU / 16 GB
#   blaster1  log-blaster + k6    ch.vs2.xlarge-dfw2  8 vCPU / 16 GB
# vs2 classes only (vs1 has no AVX2; see ceiling.hosts.env.example).
#   run.sh socday --gb-per-day 50 --duration 4h --agents 3
BENCH_NAME=bench-socday
PROVIDER="Rackspace Spot"
REGION=us-central-dfw-2
NANO_VERSION=2.0.25
SSH_KEY=/path/to/scratch/bench_ed25519
APP=203.0.113.10
CH="203.0.113.11"
INGEST="203.0.113.12"
BLASTER="203.0.113.13"
SEED=20261114
ASSETS=5000
BLAST_PROCS=1
BLAST_THREADS=4
ANALYSTS=8
DASHBOARD_VIEWERS=4
PRICING_FILE=socday.pricing.json
