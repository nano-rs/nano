# Renderer-owned: overwrite any payload-supplied envelope with trusted values.
# Vector reduce drops `%` metadata; these are the fields nano's ClickHouse
# lanes read after the pipeline (OCSF prepare, UDM output, Route by input).
._nano_pipe_metadata = [{
  "source_type": %source_type,
  "nano_claimed_source_type": %nano_claimed_source_type,
  "nano_credential_id": %nano_credential_id,
  "nano_credential_name": %nano_credential_name
}]
# Groups never span sources or ingest credentials, so the restored envelope
# is the identity of every member, not just the first one.
.group_hash = sha2(encode_json([
  %source_type, %nano_credential_id, .group_hash, ._nano_pipe_scope
]), variant: "SHA-256")
del(._nano_pipe_scope)
