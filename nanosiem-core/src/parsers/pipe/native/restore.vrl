# Renderer-owned: reduce keeps finalizers/secrets, but loses '%' value metadata.
# A marker without data must never become a delivered event.
if !exists(._nano_pipe_metadata) { . = [] } else {
  nano_metadata = object!(._nano_pipe_metadata[0])
  if nano_metadata.source_type != null { %source_type = nano_metadata.source_type }
  if nano_metadata.nano_claimed_source_type != null { %nano_claimed_source_type = nano_metadata.nano_claimed_source_type }
  if nano_metadata.nano_credential_id != null { %nano_credential_id = nano_metadata.nano_credential_id }
  if nano_metadata.nano_credential_name != null { %nano_credential_name = nano_metadata.nano_credential_name }
  # The aggregate is a new event, not the retained member: never inherit one
  # member's OCSF event uid.
  del(.context[0].metadata.uid)
  del(._nano_pipe_metadata)
}
