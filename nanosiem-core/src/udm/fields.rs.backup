/// Error when parsing an unknown UDM field name
#[derive(Debug, Clone)]
pub struct UdmFieldParseError(pub String);

impl fmt::Display for UdmFieldParseError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "unknown UDM field: {}", self.0)
    }
}

impl std::error::Error for UdmFieldParseError {}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_udm_field_column_names() {
        assert_eq!(UdmField::SrcIp.column_name(), "src_ip");
        assert_eq!(UdmField::User.column_name(), "user");
        assert_eq!(UdmField::ProcessId.column_name(), "process_id");
        assert_eq!(UdmField::HostCount.column_name(), "host_count");
    }

    #[test]
    fn test_udm_field_categories() {
        assert_eq!(UdmField::SrcIp.category(), UdmFieldCategory::Inventory);
        assert_eq!(UdmField::SrcPort.category(), UdmFieldCategory::Network);
        assert_eq!(UdmField::AuthType.category(), UdmFieldCategory::Authentication);
        assert_eq!(UdmField::ProcessName.category(), UdmFieldCategory::Endpoint);
        assert_eq!(UdmField::FilePath.category(), UdmFieldCategory::Endpoint);
        assert_eq!(UdmField::HostCount.category(), UdmFieldCategory::Custom);
    }

    #[test]
    fn test_udm_field_from_str() {
        assert_eq!("src_ip".parse::<UdmField>().unwrap(), UdmField::SrcIp);
        assert_eq!("user".parse::<UdmField>().unwrap(), UdmField::User);
        assert_eq!("host_count".parse::<UdmField>().unwrap(), UdmField::HostCount);
        assert!("unknown_field".parse::<UdmField>().is_err());
    }

    #[test]
    fn test_udm_field_display() {
        assert_eq!(format!("{}", UdmField::SrcIp), "src_ip");
        assert_eq!(format!("{}", UdmField::ProcessId), "process_id");
        assert_eq!(format!("{}", UdmField::HostCount), "host_count");
    }

    #[test]
    fn test_udm_field_data_types() {
        assert_eq!(UdmField::SrcIp.data_type(), UdmDataType::IpAddress);
        assert_eq!(UdmField::SrcPort.data_type(), UdmDataType::Integer);
        assert_eq!(UdmField::BytesIn.data_type(), UdmDataType::Long);
        assert_eq!(UdmField::Timestamp.data_type(), UdmDataType::Timestamp);
        assert_eq!(UdmField::User.data_type(), UdmDataType::String);
        assert_eq!(UdmField::HostCount.data_type(), UdmDataType::Integer);
        assert_eq!(UdmField::IsRare.data_type(), UdmDataType::Boolean);
    }

    #[test]
    fn test_by_category() {
        let custom_fields = UdmField::by_category(UdmFieldCategory::Custom);
        assert!(custom_fields.contains(&UdmField::HostCount));
        assert!(custom_fields.contains(&UdmField::IsRare));
        assert!(custom_fields.contains(&UdmField::PrevalenceScore));
        
        let network_fields = UdmField::by_category(UdmFieldCategory::Network);
        assert!(network_fields.contains(&UdmField::BytesIn));
        assert!(network_fields.contains(&UdmField::BytesOut));
    }

    #[test]
    fn test_all_fields_count() {
        // Should have 507 CSV fields + 7 legacy fields + 10 custom fields = 524 total
        assert_eq!(UdmField::all().len(), 524);
    }

    #[test]
    fn test_custom_fields_preserved() {
        // Ensure prevalence fields exist
        assert!(UdmField::from_str("host_count").is_ok());
        assert!(UdmField::from_str("is_rare").is_ok());
        assert!(UdmField::from_str("prevalence_score").is_ok());
        assert!(UdmField::from_str("prevalence_first_seen").is_ok());
        assert!(UdmField::from_str("prevalence_last_seen").is_ok());
        
        // Ensure risk fields exist
        assert!(UdmField::from_str("risk_score").is_ok());
        assert!(UdmField::from_str("risk_entity").is_ok());
        assert!(UdmField::from_str("risk_level").is_ok());
    }
}
