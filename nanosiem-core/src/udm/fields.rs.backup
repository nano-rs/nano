            UdmField::ParentUser,
            UdmField::DnsAnswers,
        ]
    }

    /// Get all fields in a specific category
    pub fn by_category(category: UdmFieldCategory) -> Vec<UdmField> {
        Self::all()
            .iter()
            .filter(|f| f.category() == category)
            .copied()
            .collect()
    }
}

impl fmt::Display for UdmField {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{}", self.column_name())
    }
}

