    /// Get field description
    pub fn description(&self) -> &'static str {
        // For now, return the field name as description
        // This will be enhanced in task 2.3 with proper descriptions
        self.column_name()
    }

    /// Get applicable data models for this field
    pub fn data_models(&self) -> &'static [&'static str] {
        // For now, return empty array
        // This will be populated in task 2.3 with actual data models
        &[]
    }

    /// Get field metadata
    pub fn metadata(&self) -> UdmFieldMetadata {
        UdmFieldMetadata {
            name: self.column_name(),
            column_name: self.column_name(),
            data_type: self.data_type(),
            category: self.category(),
            description: self.description(),
            data_models: self.data_models(),
        }
    }

