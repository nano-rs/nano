//! Unified Data Model field definitions
//!
//! This module defines the standard UDM fields for normalized log data.
//! These fields provide a consistent schema for common entities across
//! different log sources, enabling cross-source searching.
//!
//! Requirements: 1.1, 1.2, 1.3, 1.4, 1.5, 2.1, 2.2, 2.3, 2.4

use serde::{Deserialize, Serialize};
use std::fmt;
use std::str::FromStr;

/// Standard UDM fields for normalized log data
///
/// This enum contains ~500 fields covering all major security data models:
/// - Entity fields (IPs, hosts, users, actions)
/// - Network fields (ports, protocols, bytes, sessions)
/// - Authentication fields (auth type, result, session)
/// - Endpoint fields (OS, CPU, memory, processes)
/// - Process fields (name, ID, command line, parent)
/// - File fields (path, name, hash, operations)
/// - Email fields (sender, recipient, subject, attachments)
/// - Web fields (URL, HTTP method, user agent, referrer)
/// - Database fields (queries, performance, connections)
/// - DNS fields (queries, responses, record types)
/// - Certificate fields (SSL/TLS certificate information)
/// - Malware fields (signatures, file hashes, detection)
/// - Vulnerability fields (CVE, CVSS, scan results)
/// - And many more...
///
/// Custom NanoSIEM fields (prevalence, risk scoring) are preserved.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum UdmField {
    // ========================================
    // Legacy/Compatibility Fields
    // These fields are not in the CSV but are used in existing code
    // ========================================
    
    /// Generic timestamp field
    Timestamp,
    /// Source hostname
    SrcHost,
    /// Destination hostname
    DestHost,
    /// Destination username (target user or account)
    DestUser,
    /// Authentication type/method
    AuthType,
    /// Authentication result
    AuthResult,
    /// Command line
    CommandLine,
    /// File action/operation
    FileAction,
    
    // ========================================
    // Standard UDM Fields from CSV
    // ========================================
    
    /// access_count
    AccessCount,
    /// access_time
    AccessTime,
    /// action
    Action,
    /// action_mode
    ActionMode,
    /// action_name
    ActionName,
    /// action_status
    ActionStatus,
    /// additional_answer_count
    AdditionalAnswerCount,
    /// affect_dest
    AffectDest,
    /// answer
    Answer,
    /// answer_count
    AnswerCount,
    /// app
    App,
    /// app_id
    AppId,
    /// array
    Array,
    /// authentication_method
    AuthenticationMethod,
    /// authentication_service
    AuthenticationService,
    /// authority_answer_count
