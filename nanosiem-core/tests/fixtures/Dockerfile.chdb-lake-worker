ARG BUILDER_IMAGE=nan2361-scale03-lake-retained-builder-amd64:ced9291a8

FROM ${QUERY_IMAGE} AS query
FROM ${BUILDER_IMAGE}

COPY --from=query /usr/local/lib/nano-chdb/libchdb.so /opt/nano/libchdb.so
