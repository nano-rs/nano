        __spill = if __complex { encode_json(value) } else { value }
        __residual = set!(__residual, [__key], __spill)
    }
}
# Keep existing derived evidence, but remove null placeholders and mapped copies.
# Source-derived aliases are replaced by canonical dotted source paths above.
__original_values = []
for_each(flatten(__source_kv)) -> |_key, value| {
    __original_values = push(__original_values, encode_json(value))
    if !is_object(value) && !is_array(value) { __original_values = push(__original_values, to_string(value) ?? "") }
}
for_each(flatten(__existing)) -> |key, value| {
    __source_alias = includes(__original_values, encode_json(value)) || includes(__original_values, to_string(value) ?? "")
    __mapped_alias = includes(__represented, encode_json(value)) || includes(__represented, to_string(value) ?? "")
    __decoded, __decode_err = parse_json(string(value) ?? "")
    __encoded_container = __decode_err == null && (is_object(__decoded) || is_array(__decoded))
    if !is_null(value) && value != "" && !__source_alias && !__mapped_alias && !__encoded_container && value != __raw_body {
        # Existing aggregates may contain sensitive descendants; the canonical
        # source spill above is the authoritative representation of containers.
        if !is_array(value) && !is_object(value) && !match(downcase(key), r'password|secret|authorization|token') {
            __key = snakecase(key)
            if !includes(keys(__residual), __key) { __residual = set!(__residual, [__key], value) }
        }
    }
}
# Parser-declared derived evidence is merged after source spill, with recursive
# redaction. These entries preserve meaning beyond source scalar value equality.
for_each(__preserve) -> |_index, key| {
    __derived = get!(object!(__safe.existing), [string!(key)])
    if __derived != null { __residual = set!(__residual, [string!(key)], __derived) }
}
__discard = del(.unmapped)
if !is_empty(__residual) { .unmapped = __residual }
.
# END NAN-2421 residual spill
