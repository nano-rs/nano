    __matches = includes(__represented, encode_json(__expected))
    if is_string(rule.target) { __matches = get!(., split(string!(rule.target), ".")) == __expected }
    if __valid && __matches { __consumed = push(__consumed, __source_key) }
}
# END parser-specific transformations
# Redact at every depth, including objects inside arrays, before serialization.
__safe = map_values(object!(parse_json!(encode_json({"source": __source_kv, "existing": __existing}))), recursive: true) -> |value| {
    if is_object(value) {
        # Header/parameter arrays commonly encode sensitive keys as name/value
