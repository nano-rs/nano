# nano local single-tenant enterprise stack: example env (NAN-4905)
#
# scripts/local-stack.sh copies this file to dev/local-stack/.env.local on first
# run (gitignored), then fills every CHANGE_ME_GENERATED value with a random
# 32-byte hex string. To share a value with another tool, read it from .env.local.
# Don't paste it into chat, tickets or logs.
#
# LOCAL TEST CREDENTIALS ONLY. Infra ports bind to 127.0.0.1; the Vite UI binds
# 0.0.0.0:5173 for tailnet access (NANOCH_EXPOSE_LAN=0 keeps it on localhost).
# Never reuse these values on a reachable host.

# --- Local admin, created through POST /api/setup/initialize on first `up` ---
NANO_ADMIN_EMAIL=admin@nano.local
NANO_ADMIN_NAME=Local Admin
NANO_ADMIN_PASSWORD=Local-Dev-Admin-2026!

# Optional: run a different ClickHouse image than the compose pin (upgrade tests).
# NANOCH_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.4

# --- Schema profile: ocsf (default, NAN-4903) | udm (fixed at first boot; see docs/dev/LOCAL-STACK.md to switch) ---
NANO_SCHEMA_PROFILE=ocsf

# --- Public URL (the Vite dev server is the UI entry) ---
BASE_URL=http://localhost:5173
# Vite binds 0.0.0.0:5173 (tailnet access) unless this is 0.
NANOCH_EXPOSE_LAN=1
NANOSIEM_DEV_MODE=true
# Optional licensed ingest allowance. Leave unset for no configured cap.
# NANO_CAPACITY_GB_PER_DAY=50
RUST_LOG=info
CLICKHOUSE_MEM_LIMIT=8G

# --- Generated on first run (32-byte hex) ---
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
CLICKHOUSE_PASSWORD=CHANGE_ME_GENERATED
CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME_GENERATED
CLICKHOUSE_INGEST_PASSWORD=CHANGE_ME_GENERATED
CLICKHOUSE_VECTOR_PASSWORD=CHANGE_ME_GENERATED
CLICKHOUSE_RAWSQL_PASSWORD=CHANGE_ME_GENERATED
CLICKHOUSE_RAWSQL_NOAUDIT_PASSWORD=CHANGE_ME_GENERATED
JWT_SECRET=CHANGE_ME_GENERATED
NANOSIEM_ENCRYPTION_KEY=CHANGE_ME_GENERATED
VECTOR_AUTH_TOKEN=CHANGE_ME_GENERATED
# NAN-4907: nano-api's own Vector senders (never given to senders) and the
# OTLP edge assertion signing key. Independent of VECTOR_AUTH_TOKEN.
NANO_PLATFORM_INGEST_TOKEN=CHANGE_ME_GENERATED
NANO_OTLP_EDGE_KEY=CHANGE_ME_GENERATED
# NAN-4919 / NAN-4945: shared token between nano-api and the Nano Pipe tap relay.
NANO_VECTOR_TAP_TOKEN=CHANGE_ME_GENERATED
# Role-split Keeper credentials share this inventory even though local-stack
# does not start a Keeper service.
NANO_KEEPER_PASSWORD=CHANGE_ME_GENERATED
NANO_KEEPER_SUPER_DIGEST=CHANGE_ME_GENERATED
# Vector config delivery credential (unused locally: delivery is off; kept so
# the shared secret inventory stays complete).
NANO_VECTOR_CONFIG_DELIVERY_TOKEN=CHANGE_ME_GENERATED
# NAN-5214: PostgreSQL HA replication and Patroni REST credentials (used only
# with two or more postgres hosts; kept so the shared inventory stays complete).
NANO_PG_REPLICATION_PASSWORD=CHANGE_ME_GENERATED
NANO_PATRONI_API_PASSWORD=CHANGE_ME_GENERATED

# --- Infra host ports (127.0.0.1). The native app uses the fixed dev ports
# 3000 (api), 3002 (search), 3003 (jobs) and 5173 (Vite). ---
# Not 8080: on mars the host EDR shipper (moat-ship.service) posts alerts to
# 127.0.0.1:8080 with its own token, and the rejected batches flood Vector's
# WARN log and the collector_errors table. To ingest moat alerts deliberately,
# set this to 8080 and VECTOR_AUTH_TOKEN to that shipper's token.
NANOCH_VECTOR_HTTP_PORT=18080
# Dedicated enrichment handoff; separate from the nginx edge on 18090.
NANOCH_VECTOR_ENRICH_PORT=18091
NANOCH_HEC_PORT=8088
NANOCH_VECTOR_METRICS_PORT=19598
NANOCH_CH_HTTP_PORT=8123
NANOCH_CH_NATIVE_PORT=9010
NANOCH_PG_PORT=15432
NANOCH_REDIS_PORT=16379
# Nano Pipe tap relay (vector-tap, in Vector's stable network namespace)
NANOCH_VECTOR_TAP_PORT=18687
# Vector OTLP/HTTP on loopback (unauthenticated; the Linux edge forwards /otlp here)
NANOCH_VECTOR_OTLP_PORT=14318

# --- Ingest edge (NAN-4945) ---
# The opensource compose's nginx (config/nginx/nginx.opensource.conf) on
# 127.0.0.1: /ingest (HTTP JSON) and /otlp/v1/* (OTLP/HTTP, auth_request) like a
# real install, plus the API and the UI. Not 3000/3002/3003/5173.
NANOCH_EDGE_PORT=18090
# The origin Add source shows to senders (endpoint card + snippets). Without
# it the API falls back to BASE_URL above, the Vite dev server, which does not
# serve /ingest or /otlp. Keep it on the edge port. HEC is Vector's own
# listener (NANOCH_HEC_PORT); local-stack.sh passes that port to the API.
NANO_INGEST_PUBLIC_BASE_URL=http://localhost:18090
# The edge's network: bridge (macOS default; Docker Desktop forwards
# host.docker.internal to 127.0.0.1) or host (Linux default; the edge shares
# the host network and listens on 127.0.0.1 only). See LOCAL-STACK.md.
# NANOCH_EDGE_NETWORK=
