# Rust build artifacts (** matches nested dirs like fuzz/target/)
**/target/
**/*.rs.bk
**/*.pdb

# Fuzz corpus/artifacts (not needed for builds)
**/fuzz/corpus/
**/fuzz/artifacts/

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/
docs-site/
examples/
samples/

# IDE
.vscode/
.idea/
.kiro/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Environment
.env
.env.*
!.env.example

# Test files
test-*.sh
*_test.rs
tests/

# CI/CD
.github/
.claude/

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Node / frontend (not needed for Rust builds)
nanosiem-web/
deploy/

# Database
*.db
*.sqlite
clickhouse/*.xml
clickhouse/config.d/

# Misc
*.png
*.jpg
*.svg
cursor_alignment_test.html
test_syntax_highlighting.html
scripts/
# NAN-3485 / NAN-4908: the api and jobs stages install the pinned, checksummed Deno.
!scripts/ci/install-deno.sh
# NAN-5002: the guarded, TEST-only upgrade rehearsal copies exactly this SQL
# fixture into a non-release image. Keep every other test/script path excluded.
!scripts/tests/fixtures/upgrade/clickhouse/999999999lab_upgrade_probe.sql
config/
# NAN-1156/NAN-5004: nanosiem-core embeds these Vector templates at COMPILE time
# via include_str! (vector_config/deploy.rs and its durability contract tests),
# so they MUST be in the Docker build context even though the rest of config/
# stays excluded (credentials/, staging/, backup/, and untracked per-source
# parser noise all remain ignored). Runtime still reads the mounted config_dir —
# this is build-context only. Keep in sync with those compile-time include lists.
!config/vector/00-base.toml
!config/vector/01-vector-source.toml
!config/vector/02-hec-source.toml
!config/vector/03-otlp-source.toml
!config/vector/04-enrichment-source.toml
!config/vector/92-metrics.toml
!config/vector/disk-buffer-budget.env
!config/vector/sources/parsers/_router.toml
!config/vector/sources/parsers/_combiner.toml
!config/vector/sources/parsers/_enrichment.toml
!config/vector/sources/parsers/_pipeline.toml

# NAN-4905: local-stack tooling is never needed inside an image, and editing it
# should not invalidate the COPY . . layer (a full release recompile).
dev/local-stack/
scripts/local-stack.sh
**/.env.local
**/.env.*.local
