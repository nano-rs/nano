# NanoSIEM Web Configuration
# Copy this file to .env and update the values
#
# For backend configuration (PostgreSQL, ClickHouse, etc.),
# see the root .env.example file

# =============================================================================
# Frontend Configuration
# =============================================================================

# API URL - the main backend API server address
# Leave empty for local dev (Vite proxies /api/* to the backend services).
# Set to the full URL in production or when bypassing the proxy.
VITE_API_URL=

# =============================================================================
# Microservices Configuration (Optional)
# =============================================================================
# For local development, Vite's proxy config (vite.config.ts) handles routing
# to the correct service automatically. Only set these if you need to override.

# Ingest Service URL (handles /api/ingest/*)
# VITE_INGEST_URL=http://localhost:3001

# Search Service URL (handles /api/search, /api/search/sql, /api/search/explain, /api/search/saved/*)
# VITE_SEARCH_URL=http://localhost:3002
