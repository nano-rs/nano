export type ArtifactType = 
  | 'hash_md5' 
  | 'hash_sha256' 
  | 'hash_sha1' 
  | 'domain' 
  | 'ip' 
  | 'url' 
  | 'email' 
  | 'filename';

export type ProviderType = 
  | 'virustotal' 
  | 'abuseipdb' 
  | 'shodan' 
  | 'greynoise' 
  | 'otx' 
  | 'urlhaus' 
  | 'malwarebazaar' 
  | 'custom';

export interface AgentEnrichmentProvider {
  id: string;
  name: string;
  provider_type: ProviderType;
  enabled: boolean;
  has_api_key: boolean;
  supported_artifacts: ArtifactType[];
  rate_limit_per_minute: number;
  rate_limit_per_day: number;
  requests_today: number;
  last_request_at?: string;
  last_error?: string;
  created_at: string;
  updated_at: string;
}

export interface ListAgentEnrichmentProvidersResponse {
  providers: AgentEnrichmentProvider[];
}

export interface CreateAgentEnrichmentProviderRequest {
  id: string;
  name: string;
  provider_type: ProviderType;
  enabled?: boolean;
  api_key?: string;
  config?: Record<string, unknown>;
  rate_limit_per_minute?: number;
  rate_limit_per_day?: number;
}

export interface UpdateAgentEnrichmentProviderRequest {
  name?: string;
  enabled?: boolean;
  config?: Record<string, unknown>;
  rate_limit_per_minute?: number;
  rate_limit_per_day?: number;
}

export interface UpdateAgentEnrichmentCredentialsRequest {
  api_key: string;
}

export interface QuotaInfo {
  used_today: number;
  daily_limit: number;
  used_this_month?: number;
