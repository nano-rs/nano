  decay_1_3d: number;   // Decay factor for 1-3 day signals (default 0.7)
  decay_3_5d: number;   // Decay factor for 3-5 day signals (default 0.4)
  decay_5_7d: number;   // Decay factor for 5-7 day signals (default 0.2)
}

export interface UpdateRiskDecayConfigRequest {
  decay_0_24h: number;
  decay_1_3d: number;
  decay_3_5d: number;
  decay_5_7d: number;
}

