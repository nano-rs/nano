  // List all feedback (admin view)
  async listFeedback(query?: {
    category?: FeedbackCategory;
    status?: FeedbackStatus;
    limit?: number;
    offset?: number;
  }): Promise<FeedbackListResponse> {
    const params = new URLSearchParams();
    if (query?.category) params.set('category', query.category);
    if (query?.status) params.set('status', query.status);
    if (query?.limit) params.set('limit', query.limit.toString());
    if (query?.offset) params.set('offset', query.offset.toString());
    const queryString = params.toString();
    return this.request(`/api/feedback${queryString ? `?${queryString}` : ''}`);
  }

  // List current user's feedback
  async listMyFeedback(limit?: number): Promise<MyFeedbackResponse> {
    const params = new URLSearchParams();
    if (limit) params.set('limit', limit.toString());
    const queryString = params.toString();
    return this.request(`/api/feedback/me${queryString ? `?${queryString}` : ''}`);
  }

  // Get single feedback by ID
  async getFeedback(id: string): Promise<FeedbackResponse> {
    return this.request(`/api/feedback/${id}`);
  }

  // Update feedback (admin: status and notes)
  async updateFeedback(id: string, request: UpdateFeedbackRequest): Promise<FeedbackResponse> {
    return this.request(`/api/feedback/${id}`, {
      method: 'PUT',
      body: JSON.stringify(request),
    });
  }

  // Delete feedback
  async deleteFeedback(id: string): Promise<void> {
    return this.request(`/api/feedback/${id}`, {
      method: 'DELETE',
    });
  }

  // ============================================================
  // Agent Enrichment endpoints (AI-powered threat intelligence)
  // ============================================================

  // List all configured agent enrichment providers
  async listAgentEnrichmentProviders(): Promise<ListAgentEnrichmentProvidersResponse> {
    return this.request('/api/settings/agent-enrichments');
