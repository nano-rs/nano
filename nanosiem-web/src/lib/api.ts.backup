}

export interface AgentEnrichmentUsageStats {
  provider_id: string;
  requests_today: number;
  daily_limit: number;
  remaining_today: number;
  requests_this_month: number;
  cache_hit_rate: number;
  avg_response_time_ms: number;
  error_rate: number;
  last_success_at?: string;
  last_error?: string;
  last_error_at?: string;
}

// ============================================================================
// Alert Triage Types (AI-powered alert analysis)
// ============================================================================

export type TriageVerdict = 'true_positive' | 'likely_true_positive' | 'suspicious' | 'needs_investigation' | 'likely_false_positive' | 'false_positive' | 'benign' | 'inconclusive';

export type TriageConfidence = 'high' | 'medium' | 'low';

export type RiskTrend = 'increasing' | 'stable' | 'decreasing';

export type AgentType = 'initial_triage' | 'correlation' | 'enrichment' | 'context' | 'risk_assessment' | 'verdict';

export type AgentStatus = 'pending' | 'running' | 'completed' | 'failed' | 'skipped';

export interface ExtractedEntity {
  entity_type: 'user' | 'asset' | 'ip' | 'domain' | 'hash' | 'url' | 'file' | 'process';
  value: string;
  field_source: string;
  confidence: number;
}

export interface InitialTriageResult {
  alert_id: string;
  // Backend returns entities as categorized object, not extracted_entities array
  entities?: {
    users?: string[];
    hostnames?: string[];
    ip_addresses?: string[];
    file_hashes?: string[];
    domains?: string[];
    urls?: string[];
    processes?: string[];
    file_paths?: string[];
  };
  extracted_entities?: ExtractedEntity[];  // Legacy format
  primary_entity?: ExtractedEntity | { entity_type: string; value: string; confidence?: number; reason?: string };
  threat_hypothesis: string;
  recommended_agents?: AgentType[];
  alert_summary?: string;
  severity?: string;
  mitre_tactics?: string[];
  mitre_techniques?: string[];
  alert_context?: {
    rule_name: string;
    severity: string;
    matched_event_count: number;
  };
}

export interface RelatedAlert {
  alert_id: string;
  rule_name: string;
  rule_id?: string;
  severity: string;
  created_at?: string;
  timestamp?: string;
  matched_event_count?: number;
  matched_entity?: string;
  entity_field?: string;
  mitre_tactics?: string[];
}

export interface PatternAnalysis {
  total_related_alerts: number;
  severity_distribution: Record<string, number>;
  unique_rules_triggered: number;
  alert_frequency: string;
  mitre_tactics_seen: string[];
  mitre_techniques_seen: string[];
  top_rules: [string, number][];
  time_span_hours: number;
}

export interface AttackChainAssessment {
  is_attack_chain: boolean;
  confidence: number;
  description: string;
  tactics_sequence: string[];
  chain_alert_ids: string[];
}

export interface RelatedDetectionMatch {
  match_id: string;
  rule_name: string;
  rule_id: string;
  severity: string;
  detected_at: string;
  matched_entity: string;
  entity_field: string;
  event_count: number;
}

export interface CorrelationResult {
  user_alerts: RelatedAlert[];
  asset_alerts: RelatedAlert[];
  ip_alerts?: RelatedAlert[];
  detection_matches?: RelatedDetectionMatch[];
  total_related_alerts?: number;
  severity_distribution?: Record<string, number>;
  mitre_tactics_coverage?: string[];
  attack_chain_detected?: boolean;
  attack_chain_description?: string;
  pattern_analysis?: string | PatternAnalysis;
  attack_chain_assessment?: AttackChainAssessment;
  summary?: string;
}

export interface HashEnrichment {
  hash: string;
  hash_type: 'md5' | 'sha1' | 'sha256';
  provider: string;
  malicious: boolean;
  detection_count?: number;
  total_engines?: number;
  detection_names: string[];
  threat_categories: string[];
  first_seen?: string;
  last_seen?: string;
}

export interface DomainEnrichment {
  domain: string;
  provider: string;
  malicious: boolean;
  categories: string[];
  reputation_score?: number;
  registrar?: string;
  creation_date?: string;
}

export interface IpEnrichment {
  ip: string;
  provider: string;
  malicious: boolean;
  abuse_confidence_score?: number;
  country?: string;
  isp?: string;
  categories: string[];
  reports_count?: number;
}

export interface EnrichmentResult {
  hash_enrichments: HashEnrichment[];
  domain_enrichments: DomainEnrichment[];
  ip_enrichments: IpEnrichment[];
  summary: string;
  high_risk_indicators: string[];
}

export interface TimelineEvent {
  timestamp: string;
  event_type: string;
  summary: string;
  relevance_score: number;
  fields: Record<string, unknown>;
}

export interface RareArtifact {
  artifact: string;
  artifact_type: string;
  host_count: number;
  total_occurrences: number;
  first_seen: string;
}

export interface ContextResult {
  event_timeline: TimelineEvent[];
  stats_summary: Record<string, unknown>;
  rare_artifacts: RareArtifact[];
  suspicious_patterns: string[];
  context_summary?: string;
  context_analysis?: string;  // Backend returns this field name
}

export interface RiskSignal {
  rule_name: string;
  severity: string;
  score: number;
  created_at: string;
}

export interface RiskAssessmentResult {
  entity: string;
  entity_type: string;
  current_risk_score?: number;
  risk_score_24h?: number;
  risk_score_7d?: number;
  decayed_score_24h?: number;
  decayed_score_7d?: number;
  risk_level?: string;
  signal_count_24h?: number;
  signal_count_7d?: number;
  recent_signals?: RiskSignal[];
  risk_trend?: RiskTrend;
  risk_context?: string;
  risk_assessment?: string;  // Backend returns this field name
  was_already_high_risk?: boolean;
  was_high_risk?: boolean;  // Backend returns this field name
  summary?: string;
  last_signal_at?: string;
}

export interface FollowUpQuery {
  description: string;
  query: string;
  rationale: string;
}

// Triage-specific reasoning step (different from query ReasoningStep)
export interface TriageReasoningStep {
  step_number: number;
  title: string;
  description: string;
  evidence: string[];
  conclusion: string;
}

export interface TriageRecommendation {
  action: string;
  priority: string;
  description: string;
  one_click_available: boolean;
}

export interface TriageAnalysisGap {
  description: string;
  impact: string;
  mitigation?: string;
}

// Verdict can be either a string or an object with type/severity
export interface VerdictObject {
  type: TriageVerdict;
  severity?: string;
}

export interface VerdictResult {
  verdict: TriageVerdict | VerdictObject;
  confidence: TriageConfidence | number;
  confidence_score: number;
  reasoning: string;
  reasoning_steps: TriageReasoningStep[];
  key_findings: string[];
  recommendations: TriageRecommendation[];
  follow_up_queries: FollowUpQuery[];
  analysis_gaps: TriageAnalysisGap[];
  summary?: string;
}

// Agent status can be a string or an object
export interface AgentStatusObject {
  status: AgentStatus;
  duration_ms?: number;
  reason?: string;
}

export interface TriageResult {
  alert_id: string;
  session_id: string;
  started_at: string;
  completed_at: string;
  duration_ms: number;
  initial_triage: InitialTriageResult;
  correlation?: CorrelationResult;
  enrichment?: EnrichmentResult;
  context?: ContextResult;
  risk?: RiskAssessmentResult;
  verdict: VerdictResult;
  agent_statuses: [AgentType, AgentStatus | AgentStatusObject][];
}

export interface TriageProgressEvent {
  type: 'triage_started' | 'agent_started' | 'agent_completed' | 'agent_failed' | 'agent_skipped' | 'triage_completed' | 'triage_failed';
  agent?: AgentType;
  session_id?: string;
  alert_id?: string;
  status?: AgentStatus | AgentStatusObject;
  reason?: string;
  verdict?: string;
  confidence?: number;
  duration_ms?: number;
  timestamp: string;
  error?: string;
}

export interface TriageConfig {
  correlation_enabled?: boolean;
  enrichment_enabled?: boolean;
  context_enabled?: boolean;
  risk_enabled?: boolean;
  context_window_minutes?: number;
  correlation_days?: number;
}

// =============================================================================
// Case-Level Triage Types (Multi-Alert Analysis)
// =============================================================================

/** Event from any alert in a case, used to build unified timeline */
export interface CaseTimelineEvent {
  timestamp: string;
  source_alert_id: string;
  source_rule_name: string;
  event_summary: string;
  event_data: Record<string, unknown>;
  attack_phase?: string;
  relevance_score: number;
}

/** Entity aggregated across multiple alerts with source tracking */
export interface AggregatedEntity {
  entity_type: string;
  value: string;
  source_alert_ids: string[];
  occurrence_count: number;
  first_seen: string;
  last_seen: string;
  is_primary: boolean;
  risk_score?: number;
}

/** Detected attack phase/stage from MITRE ATT&CK framework */
export interface AttackPhase {
  phase_name: string;
  mitre_tactic: string;
  start_time: string;
  end_time?: string;
  alert_ids: string[];
  confidence: number;
  description: string;
  techniques: string[];
}

/** Summary of a single alert for case context */
export interface AlertSummary {
  alert_id: string;
  rule_name: string;
  severity: string;
  timestamp: string;
  matched_event_count: number;
  key_entities: string[];
  threat_hypothesis?: string;
  mitre_tactics: string[];
  mitre_techniques: string[];
}

/** Initial triage result for a case (aggregated from all alerts) */
export interface CaseInitialTriageResult {
  case_id: string;
  alert_count: number;
  alert_summaries: AlertSummary[];
  aggregated_entities: AggregatedEntity[];
  primary_entity?: AggregatedEntity;
  case_hypothesis: string;
  unified_timeline: CaseTimelineEvent[];
  time_span_hours: number;
  mitre_tactics: string[];
  mitre_techniques: string[];
}

/** Attack progression analysis result */
export interface AttackProgressionResult {
  detected_phases: AttackPhase[];
  attack_chain_detected: boolean;
  attack_chain_confidence: number;
  attack_narrative: string;
  recommended_response_phase: string;
  kill_chain_stage?: string;
}

/** Recommendation specific to a case */
export interface CaseRecommendation {
  action: string;
  priority: string;
  description: string;
  affected_alert_ids: string[];
  one_click_available: boolean;
}

/** Suggested bulk actions for all alerts in a case */
export interface BulkActionSuggestion {
  close_all_as?: string;
  escalate: boolean;
  merge_recommended: boolean;
  reason: string;
}

/** Case-level verdict with recommendations */
export interface CaseVerdictResult {
  verdict: TriageVerdict | VerdictObject;
  confidence: number;
  reasoning: string;
  reasoning_steps: TriageReasoningStep[];
  key_findings: string[];
  recommendations: CaseRecommendation[];
  follow_up_queries: FollowUpQuery[];
  analysis_gaps: TriageAnalysisGap[];
  bulk_actions?: BulkActionSuggestion;
  executive_summary: string;
}

/** Complete result of a case triage session */
export interface CaseTriageResult {
  case_id: string;
  session_id: string;
  started_at: string;
  completed_at: string;
  duration_ms: number;
  alert_count: number;
  initial_triage: CaseInitialTriageResult;
  correlation?: CorrelationResult;
  enrichment?: EnrichmentResult;
  context?: ContextResult;
  attack_progression?: AttackProgressionResult;
  verdict: CaseVerdictResult;
  agent_statuses: [AgentType, AgentStatus | AgentStatusObject][];
}

/** Progress events for case triage SSE streaming */
export type CaseTriageProgressEvent =
  | { type: 'case_triage_started'; session_id: string; case_id: string; alert_count: number; timestamp: string }
  | { type: 'collecting_alerts'; session_id: string; completed: number; total: number; current_alert_id?: string; timestamp: string }
  | { type: 'building_timeline'; session_id: string; event_count: number; timestamp: string }
  | { type: 'aggregating_entities'; session_id: string; entity_count: number; timestamp: string }
  | { type: 'agent_started'; session_id: string; agent: AgentType; timestamp: string }
  | { type: 'agent_completed'; session_id: string; agent: AgentType; status: AgentStatus | AgentStatusObject; timestamp: string }
  | { type: 'agent_failed'; session_id: string; agent: AgentType; error: string; timestamp: string }
  | { type: 'attack_progression_started'; session_id: string; timestamp: string }
  | { type: 'attack_phase_detected'; session_id: string; phase_name: string; mitre_tactic: string; confidence: number; timestamp: string }
  | { type: 'attack_progression_completed'; session_id: string; phases_detected: number; attack_chain_detected: boolean; timestamp: string }
  | { type: 'keepalive'; session_id: string; timestamp: string }
  | { type: 'case_triage_completed'; session_id: string; case_id: string; verdict: string; confidence: number; duration_ms: number; timestamp: string }
  | { type: 'case_triage_failed'; session_id: string; case_id: string; error: string; timestamp: string };

/** Configuration for case triage */
export interface CaseTriageConfig {
  correlation_enabled?: boolean;
  enrichment_enabled?: boolean;
  context_enabled?: boolean;
  attack_progression_enabled?: boolean;
  max_alerts?: number;
  context_window_hours?: number;
  keepalive_interval_secs?: number;
  agent_timeout_secs?: number;
  total_timeout_secs?: number;
}

// Callback type for when auth fails completely (logout needed)
type AuthFailureCallback = () => void;

// Queue entry for requests waiting on token refresh
interface QueuedRequest {
  resolve: (value: unknown) => void;
  reject: (reason: unknown) => void;
  endpoint: string;
  options: RequestInit;
}

class ApiClient {
  private baseUrl: string;
  private isRefreshing = false;
  private refreshQueue: QueuedRequest[] = [];
  private onAuthFailure: AuthFailureCallback | null = null;

  constructor(baseUrl: string = API_BASE_URL) {
    this.baseUrl = baseUrl;
  }

  /**
   * Set callback to be called when auth fails completely (refresh token invalid).
   * This should trigger logout in the AuthContext.
   */
  setAuthFailureCallback(callback: AuthFailureCallback) {
    this.onAuthFailure = callback;
  }

  private getAccessToken(): string | null {
    try {
      const stored = localStorage.getItem('nanosiem_auth');
      if (!stored) return null;
      const tokens = JSON.parse(stored);
      // Check if token is expired (but still return it - server is source of truth)
      // We'll handle 401s properly now
      return tokens.accessToken || null;
    } catch {
      return null;
    }
  }

  private getRefreshToken(): string | null {
    try {
      const stored = localStorage.getItem('nanosiem_auth');
      if (!stored) return null;
      const tokens = JSON.parse(stored);
      return tokens.refreshToken || null;
    } catch {
      return null;
    }
  }

  private storeTokens(accessToken: string, refreshToken: string, expiresIn: number) {
    const expiresAt = Date.now() + expiresIn * 1000;
    localStorage.setItem(
      'nanosiem_auth',
      JSON.stringify({ accessToken, refreshToken, expiresAt })
    );
  }

  private clearTokens() {
    localStorage.removeItem('nanosiem_auth');
  }

  /**
   * Attempt to refresh the access token using the refresh token.
   * Returns true if successful, false if refresh failed (user needs to re-login).
   */
  private async attemptTokenRefresh(): Promise<boolean> {
    const refreshToken = this.getRefreshToken();
    if (!refreshToken) {
      return false;
    }

    try {
      const response = await fetch(`${this.baseUrl}/api/auth/refresh`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });

      if (!response.ok) {
        return false;
      }

      const data = await response.json();
      this.storeTokens(data.access_token, data.refresh_token, data.expires_in);
      return true;
    } catch {
      return false;
    }
  }

  /**
   * Process all queued requests after a successful token refresh.
   */
  private async processQueue() {
    const queue = [...this.refreshQueue];
    this.refreshQueue = [];

    for (const { resolve, reject, endpoint, options } of queue) {
      try {
        const result = await this.request(endpoint, options, true);
        resolve(result);
      } catch (error) {
        reject(error);
      }
    }
  }

  /**
   * Reject all queued requests after a failed token refresh.
   */
  private rejectQueue(error: Error) {
    const queue = [...this.refreshQueue];
    this.refreshQueue = [];

    for (const { reject } of queue) {
      reject(error);
    }
  }

  private async request<T>(
    endpoint: string,
    options: RequestInit = {},
    isRetry = false
  ): Promise<T> {
    // Use service-aware routing for microservices architecture
    const serviceUrl = getServiceUrl(endpoint);
    const url = `${serviceUrl}${endpoint}`;
    const headers: HeadersInit = {
      'Content-Type': 'application/json',
      ...options.headers,
    };

    // Add Authorization header if we have a token
    const token = this.getAccessToken();
    if (token) {
      (headers as Record<string, string>)['Authorization'] = `Bearer ${token}`;
    }

    const response = await fetch(url, {
      ...options,
      headers,
    });

    // Handle 401 Unauthorized - attempt token refresh
    if (response.status === 401 && !isRetry) {
      // Skip refresh for auth endpoints (login, refresh itself, etc.)
      const isAuthEndpoint = endpoint.startsWith('/api/auth/');
      if (!isAuthEndpoint) {
        return this.handleUnauthorized(endpoint, options);
      }
    }

    if (!response.ok) {
      const errorBody = await response.json().catch(() => ({
        error: {
          code: 'UNKNOWN_ERROR',
          message: response.statusText,
        }
      }));
      const error = errorBody.error || errorBody;
      throw new ApiClientError(error.message || 'Request failed', error.code, error.details);
    }

    return response.json();
  }

  /**
   * Handle 401 response by attempting token refresh and retrying the request.
   */
  private async handleUnauthorized<T>(
    endpoint: string,
    options: RequestInit
  ): Promise<T> {
    // If already refreshing, queue this request
    if (this.isRefreshing) {
      return new Promise<T>((resolve, reject) => {
        this.refreshQueue.push({ resolve: resolve as (value: unknown) => void, reject, endpoint, options });
      });
    }

    // Start refresh process
    this.isRefreshing = true;

    try {
      const refreshed = await this.attemptTokenRefresh();

      if (refreshed) {
        // Refresh succeeded - retry this request and process queue
        this.isRefreshing = false;
        this.processQueue();
        return this.request<T>(endpoint, options, true);
      } else {
        // Refresh failed - clear auth and trigger logout
        this.isRefreshing = false;
        this.clearTokens();
        this.rejectQueue(new ApiClientError('Session expired', 'SESSION_EXPIRED'));

        // Trigger logout callback if set
        if (this.onAuthFailure) {
          this.onAuthFailure();
        }

        throw new ApiClientError('Session expired. Please log in again.', 'SESSION_EXPIRED');
      }
    } catch (error) {
      this.isRefreshing = false;
      this.clearTokens();
      this.rejectQueue(error instanceof Error ? error : new Error('Token refresh failed'));

      if (this.onAuthFailure) {
        this.onAuthFailure();
      }

      throw error;
    }
  }

  // Health check
  async healthCheck(): Promise<{ status: string }> {
    return this.request('/health');
  }

  // Search endpoints
  async search(request: SearchRequest): Promise<SearchResponse> {
    return this.request('/api/search', {
      method: 'POST',
      body: JSON.stringify(request),
    });
  }

  async searchSql(request: RawSqlRequest): Promise<SearchResponse> {
    return this.request('/api/search/sql', {
      method: 'POST',
      body: JSON.stringify(request),
    });
  }

  async explainQuery(query: string, timeRange: TimeRange): Promise<{ sql: string }> {
    return this.request('/api/search/explain', {
      method: 'POST',
      body: JSON.stringify({ query, time_range: timeRange }),
    });
  }

  /**
   * Get prevalence artifacts for a search query.
   * This extracts distinct domains, hashes, and IPs from logs matching the query
   * and returns their prevalence data for visualization.
   */
  async getPrevalenceArtifactsForQuery(request: SearchRequest): Promise<PrevalenceScatterDataResponse> {
    return this.request('/api/search/prevalence-artifacts', {
      method: 'POST',
      body: JSON.stringify(request),
    });
  }

