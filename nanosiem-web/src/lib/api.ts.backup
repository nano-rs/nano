  mitre_techniques?: string[];
  narrative?: string;
  reference_url?: string;
  author?: string;
  tags?: string[];
  ai_generated?: boolean;
  realtime_enabled?: boolean;
  risk_score?: number;
  risk_entity_field?: string;
  risk_modifiers?: RiskModifier[];
  ai_triage_hints?: AiTriageHints;
  archived?: boolean;
  folder?: string;
}

export type UpdateDetectionRequest = Partial<CreateDetectionRequest>;

export interface Alert {
  id: string;
  rule_id: string;
  rule_name?: string;
  rule_query?: string;
  severity: 'critical' | 'high' | 'medium' | 'low' | 'informational';
  status: 'new' | 'acknowledged' | 'closed';
  disposition?: 'true_positive' | 'false_positive' | 'benign';
  matched_events: Record<string, unknown>[];
  matched_event_count?: number;
  risk_score?: number;
  assigned_to?: string;
  acknowledged_by?: string;
  acknowledged_at?: string;
  closed_by?: string;
  closed_at?: string;
  created_at: string;
  // AI Triage status
  triage_status?: 'none' | 'running' | 'completed' | 'failed';
  triage_verdict?: TriageVerdict;
}

export interface AlertCounts {
  total: number;
  new: number;
  acknowledged: number;
  closed: number;
