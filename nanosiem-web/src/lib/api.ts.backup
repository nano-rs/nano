  async getAgentEnrichmentUsage(providerId: string): Promise<AgentEnrichmentUsageStats> {
    return this.request(`/api/settings/agent-enrichments/${providerId}/usage`);
  }

  // ============================================================================
  // Alert Triage API Methods
  // ============================================================================

  // Initiate AI triage for an alert (synchronous - returns full result)
  async triageAlertSync(alertId: string, config?: TriageConfig): Promise<TriageResult> {
    return this.request(`/api/alerts/${alertId}/triage/sync`, {
      method: 'POST',
      body: JSON.stringify(config ? { config } : {}),
    });
  }

  // Initiate AI triage for an alert with SSE streaming
  // Uses fetch with ReadableStream for POST requests (EventSource only supports GET)
  triageAlertStreaming(
    alertId: string, 
    config?: TriageConfig,
    onProgress?: (event: TriageProgressEvent) => void,
    onComplete?: (sessionId: string | null, error?: string) => void
  ): AbortController {
    const controller = new AbortController();
    
    // Get auth token
    const token = this.getAccessToken();
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      'Accept': 'text/event-stream',
    };
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }
    
    fetch(`${this.baseUrl}/api/alerts/${alertId}/triage`, {
      method: 'POST',
      headers,
      body: JSON.stringify({ config }),
      signal: controller.signal,
    }).then(async (response) => {
      if (!response.ok) {
        const error = await response.text();
        onComplete?.(null, error);
        return;
      }

      const reader = response.body?.getReader();
      if (!reader) {
        onComplete?.(null, 'No response body');
        return;
      }

      const decoder = new TextDecoder();
      let buffer = '';
      let sessionId: string | null = null;

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (line.startsWith('event: ')) {
            // Handle event type line
            continue;
          }
          if (line.startsWith('data: ')) {
            const data = line.slice(6);
            if (data === '') continue;
            
            try {
              // Check if it's a session ID (first event)
              if (!sessionId && !data.startsWith('{')) {
                sessionId = data;
                console.log('[SSE] Session ID:', sessionId);
                continue;
              }
              
              const event = JSON.parse(data) as TriageProgressEvent;
              console.log('[SSE] Event received:', event.type, event.agent);
              onProgress?.(event);
              
              // Check for completion
              if (event.type === 'triage_completed') {
                onComplete?.(sessionId, undefined);
                return;
              } else if (event.type === 'triage_failed') {
                onComplete?.(null, event.error || 'Triage failed');
                return;
              }
            } catch (e) {
              console.error('Failed to parse SSE event:', e, data);
            }
          }
        }
      }
      
      // Stream ended without explicit completion
      onComplete?.(sessionId, undefined);
    }).catch((error) => {
      if (error.name !== 'AbortError') {
        onComplete?.(null, error.message);
      }
    });

    return controller;
  }

  // Get triage result by session ID
  async getTriageResult(alertId: string, sessionId: string): Promise<TriageResult> {
    return this.request(`/api/alerts/${alertId}/triage/${sessionId}`);
  }

  // Get the latest triage result for an alert
  async getLatestTriageResult(alertId: string): Promise<TriageResult> {
    return this.request(`/api/alerts/${alertId}/triage/latest`);
  }

  // Cancel a running triage session
  async cancelTriage(alertId: string, sessionId: string): Promise<{ success: boolean; message: string }> {
    return this.request(`/api/alerts/${alertId}/triage/${sessionId}`, {
      method: 'DELETE',
    });
  }

  // Get triage session status
  async getTriageStatus(alertId: string, sessionId: string): Promise<{ session_id: string; alert_id: string; status: string }> {
    return this.request(`/api/alerts/${alertId}/triage/${sessionId}/status`);
  }

  // =============================================================================
  // Case-Level Triage API Methods (Multi-Alert Analysis)
  // =============================================================================

  // Initiate AI triage for a case (all alerts analyzed together)
  // Uses SSE streaming with keepalive support for long-running analysis
  triageCaseStreaming(
    caseId: string,
    config?: CaseTriageConfig,
    onProgress?: (event: CaseTriageProgressEvent) => void,
    onComplete?: (sessionId: string | null, error?: string) => void
  ): AbortController {
    const controller = new AbortController();

    // Get auth token
    const token = this.getAccessToken();
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      'Accept': 'text/event-stream',
    };
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }

    fetch(`${this.baseUrl}/api/cases/${caseId}/triage`, {
      method: 'POST',
      headers,
      body: JSON.stringify({ config }),
      signal: controller.signal,
    }).then(async (response) => {
      if (!response.ok) {
        const error = await response.text();
        onComplete?.(null, error);
        return;
      }

      const reader = response.body?.getReader();
      if (!reader) {
        onComplete?.(null, 'No response body');
        return;
      }

      const decoder = new TextDecoder();
      let buffer = '';
      let sessionId: string | null = null;

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          // Skip SSE comments (keepalives)
          if (line.startsWith(':')) {
            console.log('[SSE] Keepalive received');
            continue;
          }
          if (line.startsWith('event: ')) {
            // Handle event type line
            continue;
          }
          if (line.startsWith('data: ')) {
            const data = line.slice(6);
            if (data === '') continue;

            try {
              // Check if it's a session ID (first event)
              if (!sessionId && !data.startsWith('{')) {
                sessionId = data;
                console.log('[SSE] Case triage session ID:', sessionId);
                continue;
              }

              const event = JSON.parse(data) as CaseTriageProgressEvent;
              console.log('[SSE] Case triage event received:', event.type);

              // Skip keepalive events from calling onProgress
              if (event.type === 'keepalive') {
                continue;
              }

              onProgress?.(event);

              // Check for completion
              if (event.type === 'case_triage_completed') {
                onComplete?.(sessionId, undefined);
                return;
              } else if (event.type === 'case_triage_failed') {
                onComplete?.(null, event.error || 'Case triage failed');
                return;
              }
            } catch (e) {
              console.error('Failed to parse SSE event:', e, data);
            }
          }
        }
      }

      // Stream ended without explicit completion
      onComplete?.(sessionId, undefined);
    }).catch((error) => {
      if (error.name !== 'AbortError') {
        onComplete?.(null, error.message);
      }
    });

    return controller;
  }

  // Get case triage result by session ID
  async getCaseTriageResult(caseId: string, sessionId: string): Promise<CaseTriageResult> {
    return this.request(`/api/cases/${caseId}/triage/${sessionId}`);
  }

  // Get the latest case triage result
  async getLatestCaseTriageResult(caseId: string): Promise<CaseTriageResult> {
    return this.request(`/api/cases/${caseId}/triage/latest`);
  }

  // Cancel a running case triage session
  async cancelCaseTriage(caseId: string, sessionId: string): Promise<{ success: boolean; message: string }> {
    return this.request(`/api/cases/${caseId}/triage/${sessionId}`, {
      method: 'DELETE',
    });
  }

  // ==================== Notifications ====================

  // Get notifications for current user
  async getNotifications(limit?: number, unreadOnly?: boolean): Promise<NotificationListResponse> {
    const params = new URLSearchParams();
    if (limit) params.set('limit', String(limit));
    if (unreadOnly) params.set('unread_only', 'true');
    const query = params.toString();
    return this.request(`/api/notifications${query ? `?${query}` : ''}`);
  }

  // Get unread notification count
  async getUnreadNotificationCount(): Promise<UnreadCountResponse> {
    return this.request('/api/notifications/unread-count');
  }

  // Mark a notification as read
  async markNotificationRead(id: string): Promise<Notification> {
    const response = await this.request<{ notification: Notification }>(`/api/notifications/${id}/read`, {
      method: 'POST',
    });
    return response.notification;
  }

  // Mark all notifications as read
  async markAllNotificationsRead(): Promise<MarkAllReadResponse> {
    return this.request('/api/notifications/read-all', {
      method: 'POST',
    });
  }
}

export class ApiClientError extends Error {
  code: string;
  details?: Record<string, unknown>;

  constructor(message: string, code: string = 'UNKNOWN_ERROR', details?: Record<string, unknown>) {
    super(message);
    this.name = 'ApiClientError';
    this.code = code;
    this.details = details;
  }
}

// Export singleton instance
export const api = new ApiClient();

// Export class for custom instances
export { ApiClient };
