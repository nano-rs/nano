  }

  /**
   * Create a parser with streaming progress events
   * Returns an EventSource that emits progress events
   */
  melodCreateParserStreaming(
    request: MelodCreateParserRequest,
    onProgress: (event: ParserProgressEvent) => void,
    onComplete: (parser: GeneratedParser | null, error?: string) => void
  ): AbortController {
    const controller = new AbortController();
    
    // Get auth token
    const token = this.getAccessToken();
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
    };
    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }
    
    fetch(`${this.baseUrl}/api/melod/parser/stream`, {
      method: 'POST',
      headers,
      body: JSON.stringify(request),
      signal: controller.signal,
    }).then(async (response) => {
      if (!response.ok) {
        const error = await response.text();
        onComplete(null, error);
        return;
      }

      const reader = response.body?.getReader();
      if (!reader) {
        onComplete(null, 'No response body');
        return;
      }

      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const data = line.slice(6);
            if (data === '') continue;
            
            try {
              const event = JSON.parse(data) as ParserProgressEvent;
              onProgress(event);
              
              // Check for completion
              if (event.type === 'completed' && event.success) {
                // The message might be a JSON parser object or a simple success message
                // Try to parse it as JSON first
                if (event.message) {
                  try {
                    const parser = JSON.parse(event.message) as GeneratedParser;
                    // Only call onComplete if we got a valid parser with vrl_code
                    if (parser && parser.vrl_code) {
                      onComplete(parser);
                      return;
                    }
                  } catch {
                    // Not JSON, that's okay - it's just a status message
                    // The actual parser will come in a subsequent completed event
                    console.log('Progress completed:', event.message);
                  }
                }
              } else if (event.type === 'error') {
                onComplete(null, event.message);
              }
            } catch (e) {
              console.error('Failed to parse SSE event:', e);
            }
          }
        }
      }
    }).catch((error) => {
      if (error.name !== 'AbortError') {
        onComplete(null, error.message);
      }
    });

    return controller;
  }

