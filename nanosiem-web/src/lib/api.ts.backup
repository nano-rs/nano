  total: number;
}

// Time-windowed risk scores with TTL decay (from signals table)
export interface TimeWindowedRiskScore {
  entity: string;
  entity_type: string;
  risk_score_24h: number;     // Raw sum of scores (no decay)
  risk_score_7d: number;      // Raw sum of scores (no decay)
  decayed_score_24h: number;  // With TTL decay applied
  decayed_score_7d: number;   // With TTL decay applied
  signal_count_24h: number;
  signal_count_7d: number;
  last_signal_at?: string;
  last_rule_name?: string;
  last_severity?: string;
}

export interface TimeWindowedRiskResponse {
