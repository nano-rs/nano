{
  "_doc": "Shared fixtures for a11y allowlist matching. Each case runs through ui.py match_a11y_allowlist() (selector strings) and driver.mjs a11yMatchAll() (the real DOM in Chrome); both must give `expect`. `target` is the offending element's selector as axe reports it, `ancestors` the selectors a string-only caller passes for `within`.",
  "cases": [
    {"name": "id selector", "html": "<img id=\"logo\" src=\"data:,\">", "route": "/alerts", "search": "", "target": "#logo", "ancestors": [], "rule": "image-alt",
     "entry": {"id": "e", "rule": "image-alt", "selector": "#logo", "reason": "r"}, "expect": true},
    {"name": "class subset", "html": "<button class=\"btn primary\">x</button>", "route": "/alerts", "search": "", "target": ".btn.primary", "ancestors": [], "rule": "button-name",
     "entry": {"id": "e", "rule": "button-name", "selector": ".btn", "reason": "r"}, "expect": true},
    {"name": "tailwind escaped class", "html": "<button class=\"hover:bg-muted\">x</button>", "route": "/alerts", "search": "", "target": "button.hover\\:bg-muted", "ancestors": [], "rule": "button-name",
     "entry": {"id": "e", "rule": "button-name", "selector": ".hover\\:bg-muted", "reason": "r"}, "expect": true},
    {"name": "wrong rule", "html": "<img id=\"logo\" src=\"data:,\">", "route": "/alerts", "search": "", "target": "#logo", "ancestors": [], "rule": "image-alt",
     "entry": {"id": "e", "rule": "color-contrast", "selector": "#logo", "reason": "r"}, "expect": false},
    {"name": "wrong surface", "html": "<img id=\"logo\" src=\"data:,\">", "route": "/alerts", "search": "", "target": "#logo", "ancestors": [], "rule": "image-alt",
     "entry": {"id": "e", "rule": "image-alt", "selector": "#logo", "surfaces": ["/dashboards"], "reason": "r"}, "expect": false},
    {"name": "query surface", "html": "<img id=\"logo\" src=\"data:,\">", "route": "/settings/ai", "search": "?tab=models", "target": "#logo", "ancestors": [], "rule": "image-alt",
     "entry": {"id": "e", "rule": "image-alt", "selector": "#logo", "surfaces": ["/settings/ai?tab=models"], "reason": "r"}, "expect": true},
    {"name": "query surface, other tab", "html": "<img id=\"logo\" src=\"data:,\">", "route": "/settings/ai", "search": "?tab=keys", "target": "#logo", "ancestors": [], "rule": "image-alt",
     "entry": {"id": "e", "rule": "image-alt", "selector": "#logo", "surfaces": ["/settings/ai?tab=models"], "reason": "r"}, "expect": false},
    {"name": "param surface", "html": "<img id=\"logo\" src=\"data:,\">", "route": "/rules/abc123", "search": "", "target": "#logo", "ancestors": [], "rule": "image-alt",
     "entry": {"id": "e", "rule": "image-alt", "selector": "#logo", "surfaces": ["/rules/:id"], "reason": "r"}, "expect": true},
    {"name": "within an ancestor", "html": "<div data-testid=\"panel\"><input id=\"i\"></div>", "route": "/alerts", "search": "", "target": "#i", "ancestors": ["[data-testid=\"panel\"]"], "rule": "label",
     "entry": {"id": "e", "rule": "label", "within": "[data-testid=panel]", "reason": "r"}, "expect": true},
    {"name": "within, other ancestor", "html": "<div data-testid=\"other\"><input id=\"i\"></div>", "route": "/alerts", "search": "", "target": "#i", "ancestors": ["[data-testid=\"other\"]"], "rule": "label",
     "entry": {"id": "e", "rule": "label", "within": "[data-testid=panel]", "reason": "r"}, "expect": false},
    {"name": "child combinator", "html": "<div class=\"row\"><span class=\"cell\">x</span></div>", "route": "/alerts", "search": "", "target": "div.row > span.cell", "ancestors": [], "rule": "color-contrast",
     "entry": {"id": "e", "rule": "color-contrast", "selector": ".row > .cell", "reason": "r"}, "expect": true},
    {"name": "child wanted, sibling actual", "html": "<div class=\"row\"></div><span class=\"cell\">x</span>", "route": "/alerts", "search": "", "target": "div.row + span.cell", "ancestors": [], "rule": "color-contrast",
     "entry": {"id": "e", "rule": "color-contrast", "selector": ".row > .cell", "reason": "r"}, "expect": false},
    {"name": "descendant wanted, child actual", "html": "<div class=\"row\"><span class=\"cell\">x</span></div>", "route": "/alerts", "search": "", "target": "div.row > span.cell", "ancestors": [], "rule": "color-contrast",
     "entry": {"id": "e", "rule": "color-contrast", "selector": ".row .cell", "reason": "r"}, "expect": true},
    {"name": "general sibling wanted, adjacent actual", "html": "<div class=\"row\"></div><span class=\"cell\">x</span>", "route": "/alerts", "search": "", "target": "div.row + span.cell", "ancestors": [], "rule": "color-contrast",
     "entry": {"id": "e", "rule": "color-contrast", "selector": ".row ~ .cell", "reason": "r"}, "expect": true},
    {"name": "class not on element", "html": "<button class=\"btn\">x</button>", "route": "/alerts", "search": "", "target": ".btn", "ancestors": [], "rule": "button-name",
     "entry": {"id": "e", "rule": "button-name", "selector": ".btn.primary", "reason": "r"}, "expect": false}
  ]
}
